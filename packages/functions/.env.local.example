# packages/functions/.env.local — the Functions EMULATOR's params (gitignored).
# Copied into place by `pnpm bootstrap`.
#
# Every defineString/defineSecret param must have a line here, EVEN THE ONES
# WITH A CODE DEFAULT: a missing one makes the emulator PROMPT for it, and in a
# non-TTY (agent session, CI, Codespace) that prompt hangs discovery and yields
# an EMPTY function registry — every callable then answers a bare `internal`,
# silently. The owner of the param list is the source; re-derive it with:
#   grep -rhoE "define(String|Secret|Int|Bool)\('[A-Z_]+'" packages/functions/src --include='*.ts' | sort -u
#
# Deployed environments never read this file: they use the committed
# .env.{staging,sandbox,production} plus Secret Manager. Secrets below are the
# emulator-only fallback of utils/secrets.ts (secret name → UPPER_SNAKE).

# ── mail (Brevo) — off locally so a demo run never sends anything real ──────
MAIL_ENABLED=false
MAIL_SYSTEM_FROM=hello@linyup.com
MAIL_SYSTEM_NAME=Linyup
MAIL_MANAGED_STUDIO_FROM=studios@linyup.com
MESSAGING_DEFAULT_MODE=live
TEST_MODE=false
TEST_EMAIL=
# Only if MAIL_ENABLED=true (a Brevo TEST key; see packages/functions/src/mail/README.md)
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# ── sms ─────────────────────────────────────────────────────────────────────
SMS_ENABLED=false
TEST_SMS_NUMBER=

# ── app + ops ───────────────────────────────────────────────────────────────
# Base URL for emailed links + untrusted-origin redirects. Slot N: http://localhost:N3000
HOSTING_URL=http://localhost:3000
# Operator allowlist for the operator-only callables. Mirrors apps/admin's
# OPERATOR_EMAILS — a value here that disagrees with the console's is a button
# that renders and then refuses.
OPERATOR_EMAILS=
VERTEX_LOCATION=global

# ── custom domains (production-only feature; blank is correct locally) ──────
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CNAME_TARGET=

# ── payments (Stripe TEST keys; needed only for priced doors) ───────────────
# `pnpm stripe:listen` prints the whsec_… to paste below, then restart the emulator.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Seed-time only: one real Stripe TEST connected account per seeded team, so the
# seeded studios show priced doors (see scripts/lib/connect.ts; the seeders read
# this file as a fallback for the shell variable). Unset = honest closed state.
STRIPE_CONNECT_TEST_ACCOUNT=

# ── site translation (docs/site-translations.md) ────────────────────────────
# deepl | google | none | unset = auto (DeepL when keyed, otherwise publish
# succeeds untranslated with one warning)
TRANSLATION_PROVIDER=
DEEPL_API_KEY=

# ── feature flags read as plain process.env ─────────────────────────────────
APP_CHECK_ENFORCE=false
APP_CHECK_ENFORCE_MOBILE=false

# ── App-store insights (packages/functions/src/appstores) ───────────────────
# Read-only ingest of App Store Connect + Google Play into store_presence/*,
# rendered by the operator console's Member app page (pnpm dev:admin → /member-app).
#
# The iTunes lookup needs NO credential — leave everything below as-is and the
# ingest already produces a real answer ("not on the store yet", which is the
# correct one today). The Apple and Play sources report `not_configured` until
# their secrets are set, which is the state to leave them in unless you are
# actively testing them.
STORE_INGEST_ENABLED=true
ASC_APP_ID=6808572774
ASC_VENDOR_NUMBER=
PLAY_PACKAGE_NAME=com.dgstn.linyup
PLAY_REPORTS_BUCKET=
ITUNES_LOOKUP_COUNTRY=ch

# Credentials, emulator-side. `getSecret` reads env vars when
# FUNCTIONS_EMULATOR=true, uppercasing the secret name and turning - into _.
#
# APPLE_ASC_PRIVATE_KEY takes the .p8 as PEM *or* as a single line of base64 —
# prefer the base64 form here, because a multi-line value in a .env file is not
# reliably preserved and the resulting failure is an opaque 401 that reads as a
# bad key rather than a mangled one:
#   base64 -w0 AuthKey_XXXXXXXXXX.p8
APPLE_ASC_KEY_ID=
APPLE_ASC_ISSUER_ID=
APPLE_ASC_PRIVATE_KEY=

# The webhook signing secret — a phrase YOU choose and paste into App Store
# Connect → Users and Access → Integrations → Webhooks, alongside the URL of
# handleAppStoreWebhook. Independent of the API key above: the webhook works
# with this alone (state changes still land in store_events), and the API key
# alone gives you the daily poll without the push.
#
# handleAppStoreWebhook FAILS CLOSED — with this unset it answers 503 and
# records nothing, which is the correct posture for a public endpoint that
# writes to Firestore.
APPLE_ASC_WEBHOOK_SECRET=

# The whole Play service-account JSON on ONE line.
GOOGLE_PLAY_SERVICE_ACCOUNT=
