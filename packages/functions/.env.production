# ⚠️  COMMITTED TO GIT + DEPLOYED. The Firebase CLI loads this file by project
# alias on `firebase deploy --project production`, so these values are baked into
# the deployed production functions' config (read via firebase-functions/params,
# e.g. defineString in src/utils/env.ts).
# DO NOT put secrets here (API keys, tokens, passwords). Secrets go to Secret
# Manager and are read via getSecret() (src/utils/secrets.ts); for local-only
# secrets use the gitignored .env.local. Non-secret config only below.
TEST_MODE=false
TEST_EMAIL=
# The APP, not the marketing site. linyup.com is apps/landing on Firebase
# Hosting; the web app is a separate App Hosting backend, so linyup.com/login,
# /dashboard and /public/* all returned the landing site's 404. Every emailed
# link (confirmations, verification codes, invitations) and every Stripe
# post-checkout redirect pointed there until 2026-08-14.
#
# app.linyup.com also matches TRUSTED_ORIGIN_RE, so a same-session checkout
# returns to the caller's own origin instead of falling back here.
HOSTING_URL=https://app.linyup.com
# Vertex AI location for the in-app assistant (firebase-functions/params).
VERTEX_LOCATION=global
# Mail config (firebase-functions/params). A non-interactive `firebase deploy`
# requires a value for EVERY param in the loaded dotenv — a code default alone is
# not enough — so all mail params are set explicitly here (values mirror the code
# defaults). Production sends real mail to real recipients (TEST_MODE=false).
MAIL_ENABLED=true
MAIL_SYSTEM_FROM=hello@linyup.com
MAIL_SYSTEM_NAME=Linyup
MAIL_MANAGED_STUDIO_FROM=studios@linyup.com
# Per-tenant messaging policy fallback: production tenants without a policy doc
# deliver normally ('live' = byte-identical to pre-policy behavior).
MESSAGING_DEFAULT_MODE=live
# SMS master switch — flip to true once the Brevo account holds SMS credits.
SMS_ENABLED=false
TEST_SMS_NUMBER=
# App Check enforcement for the web-only public callables (checkouts + submitForm).
# false = MONITOR mode: requests without a valid App Check token are logged
# ([appcheck-monitor]), not rejected. Flip to true ONLY after the web reCAPTCHA
# App Check key is provisioned and the monitor logs confirm tokens are arriving,
# otherwise legitimate web clients get rejected.
APP_CHECK_ENFORCE=false

# Custom domains (Cloudflare for SaaS) — PRODUCTION ONLY, see docs/custom-domains.md.
# Neither value is a secret: the zone id is on the zone's Overview page and is
# inert without the API token, which lives in Secret Manager as
# `cloudflare-api-token` (set it in the operator console, Settings → Domains).
#
# CLOUDFLARE_CNAME_TARGET is the string studios put in THEIR OWN DNS. It can
# never change once a single studio has pointed a domain at it — changing it
# means asking every one of them to edit a record, and the ones who miss it go
# dark. Treat it as permanent.
CLOUDFLARE_ZONE_ID=0000470317acd13c050db3ac804239bc
CLOUDFLARE_CNAME_TARGET=connect.linyup.com

# Operator allowlist for the operator-only callables (manageDemoTenant,
# setReviewAccess, …). MIRRORS apps/admin's OPERATOR_EMAILS — the console and the
# callables authorise the same person, and a value here that disagrees with the
# console's is a button that renders and then refuses.
#
# Must be present in EVERY .env.<alias>, even empty: `defineString`'s `default:`
# is not enough for a non-interactive deploy, which is what broke the staging
# deploy of 2026-08-21 (`In non-interactive mode but have no value for the
# following environment variables: OPERATOR_EMAILS`). Same reason TEST_EMAIL= is
# spelled out in these files rather than left to its default.
OPERATOR_EMAILS=franco.dgstn@gmail.com

# ── App-store insights (packages/functions/src/appstores) ───────────────────
# Read-only ingest of App Store Connect + Google Play into store_presence/*,
# rendered by the operator console's Member app page.
#
# EVERY ONE OF THESE MUST BE SPELLED OUT IN EVERY .env.<alias>, even empty —
# `defineString`'s `default:` is not enough for a non-interactive deploy. Same
# rule (and same 2026-08-21 breakage) as OPERATOR_EMAILS above.
#
# STORE_INGEST_ENABLED is the guard that matters. There is ONE App Store record
# and ONE Play listing, so every environment that can reach them reaches the
# same real app; turning this on is a deliberate, per-environment act.
STORE_INGEST_ENABLED=false

# Public identifiers — the ASC app id is already committed in apps/mobile/eas.json
# and the package name ships inside the app. The ASC key id and issuer id are NOT
# here: they live in Secret Manager beside the key, because these files are
# tracked in git and a value written here is in the history forever.
ASC_APP_ID=6808572774
PLAY_PACKAGE_NAME=com.dgstn.linyup

# Needed ONLY by /v1/salesReports (daily install units). App Store Connect →
# Payments and Financial Reports. Nothing reads it until that source is built.
ASC_VENDOR_NUMBER=

# Play Console reports bucket, pubsite_prod_rev_<developerId>. The developer id
# is not derivable from this repo — read it off Play Console → Download reports.
# Access to it is granted IN THE PLAY CONSOLE, not through GCP IAM.
PLAY_REPORTS_BUCKET=

# Storefront for the public iTunes lookup. Not cosmetic: App Store ratings are
# per storefront, so 'ch' and 'us' return different numbers for the same app.
ITUNES_LOOKUP_COUNTRY=ch
