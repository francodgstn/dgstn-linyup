# ⚠️  COMMITTED TO GIT + DEPLOYED. The Firebase CLI loads this file by project
# alias on `firebase deploy --project staging`, so these values are baked into
# the deployed staging functions' config (read via firebase-functions/params,
# e.g. defineString in src/utils/env.ts).
# DO NOT put secrets here (API keys, tokens, passwords). Secrets go to Secret
# Manager and are read via getSecret() (src/utils/secrets.ts); for local-only
# secrets use the gitignored .env.local. Non-secret config only below.
TEST_MODE=true
TEST_EMAIL=franco.dgstn@gmail.com
# Base URL for emailed links (getHostingUrl) and for redirect targets whose
# caller origin isn't trusted (resolveBaseUrl — it only trusts *.linyup.com and
# localhost, and the App Hosting host is neither, so staging always lands here).
#
# A custom domain on the staging App Hosting backend, deliberately — it matches
# TRUSTED_ORIGIN_RE (*.linyup.com), so same-session checkout returns to the
# caller's own origin instead of falling back here, and it survives a backend
# rename or the EU region move infra/README documents. The generated
# linyup-web--linyup-staging.us-central1.hosted.app host does neither.
#
# Was https://linyup-staging.web.app until 2026-08-14: a Firebase Hosting site
# that serves a bare 404 because CI never deploys hosting:app (the web app moved
# to App Hosting). Every staging email link and post-checkout redirect landed
# there.
HOSTING_URL=https://app-stg.linyup.com
# Vertex AI location for the in-app assistant (firebase-functions/params).
VERTEX_LOCATION=global
# Mail config (firebase-functions/params). A non-interactive `firebase deploy`
# requires a value for EVERY param in the loaded dotenv — a code default alone is
# not enough — so all mail params are set explicitly here (values mirror the code
# defaults). Mail is enabled in staging but redirected to TEST_EMAIL (TEST_MODE=true).
MAIL_ENABLED=true
MAIL_SYSTEM_FROM=hello@linyup.com
MAIL_SYSTEM_NAME=Linyup
MAIL_MANAGED_STUDIO_FROM=studios@linyup.com
# Per-tenant messaging policy fallback (tenants without a messaging_policies doc).
# 'live' + TEST_MODE=true above = unchanged staging behavior (global redirect).
MESSAGING_DEFAULT_MODE=live
# SMS off in staging until explicitly needed (prepaid Brevo credits).
SMS_ENABLED=false
TEST_SMS_NUMBER=
# App Check enforcement for the web-only public callables (checkouts + submitForm).
# false = MONITOR mode (missing tokens logged, not rejected). Staging is the place
# to flip this to true first — after the web reCAPTCHA App Check key is provisioned
# and [appcheck-monitor] logs confirm tokens are arriving — before touching prod.
APP_CHECK_ENFORCE=false

# Custom domains are PRODUCTION ONLY (docs/custom-domains.md → "Environments"):
# one Cloudflare zone has one fallback origin, so a non-prod environment would
# need its own domain, token and Worker deploy. registerPublicDomain refuses here
# before it ever reaches Cloudflare, so these stay deliberately empty — a zone id
# set off-prod is how a sandbox tenant ends up registering on the PROD zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CNAME_TARGET=

# Operator allowlist for the operator-only callables (manageDemoTenant,
# setReviewAccess, …). MIRRORS apps/admin's OPERATOR_EMAILS — the console and the
# callables authorise the same person, and a value here that disagrees with the
# console's is a button that renders and then refuses.
#
# Must be present in EVERY .env.<alias>, even empty: `defineString`'s `default:`
# is not enough for a non-interactive deploy, which is what broke the staging
# deploy of 2026-08-21 (`In non-interactive mode but have no value for the
# following environment variables: OPERATOR_EMAILS`). Same reason TEST_EMAIL= is
# spelled out in these files rather than left to its default.
OPERATOR_EMAILS=franco.dgstn@gmail.com

# ── App-store insights (packages/functions/src/appstores) ───────────────────
# Read-only ingest of App Store Connect + Google Play into store_presence/*.
#
# EVERY ONE OF THESE MUST BE SPELLED OUT IN EVERY .env.<alias>, even empty —
# `defineString`'s `default:` is not enough for a non-interactive deploy. Same
# rule (and same 2026-08-21 breakage) as OPERATOR_EMAILS above.
#
# DELIBERATELY EMPTY OFF PROD. There is ONE App Store record and ONE Play
# listing: a non-prod deployment that could reach them would be reaching the
# real app. So this environment exercises the `not_configured` path instead —
# which is the path prod will take for weeks anyway, so it gets tested for free.
STORE_INGEST_ENABLED=false
ASC_APP_ID=
ASC_VENDOR_NUMBER=
PLAY_PACKAGE_NAME=
PLAY_REPORTS_BUCKET=
ITUNES_LOOKUP_COUNTRY=ch
