{
  "name": "dgstn-lineup",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "//engines.pnpm": "The <12 ceiling is for the Firebase App Hosting pnpm buildpack ONLY: it IGNORES the packageManager pin above and installs the LATEST pnpm satisfying engines.pnpm. pnpm 12.0.0 (released 2026-08-26) ships a tarball layout buildpack google.nodejs.pnpm@0.1.1 cannot run ('dist/pnpm.mjs' MODULE_NOT_FOUND), which broke every App Hosting build; 11.24.0 works. CI/local use the 9.15.0 packageManager pin and are unaffected. Raise the ceiling once the buildpack supports pnpm 12.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev:web": "pnpm --filter @linyup/web dev",
    "dev:admin": "pnpm --filter @linyup/admin dev",
    "dev:admin:sandbox": "pnpm --filter @linyup/admin dev:sandbox",
    "dev:landing": "pnpm --filter @linyup/landing dev",
    "dev:mobile": "pnpm --filter @linyup/mobile start",
    "dev:mobile:emulators": "pnpm --filter @linyup/mobile start:emulators",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "i18n:check": "node scripts/i18n-check.mjs",
    "census:reads": "node scripts/census-reads.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "functions:build": "pnpm --filter @linyup/shared run build && pnpm --filter @linyup/functions run build",
    "functions:watch": "pnpm --filter @linyup/functions run watch",
    "local": "node scripts/local-env.mjs",
    "emulators:start": "pnpm functions:build && firebase emulators:start --only auth,firestore,functions,storage --project demo-linyup",
    "emulators:seed": "node scripts/emulators-seed.mjs",
    "emulators:demo": "node scripts/emulators-demo.mjs",
    "emulators:swimli": "node scripts/emulators-demo.mjs swimli",
    "emulators:hmd": "node scripts/emulators-run.mjs --only auth,firestore,functions,storage --import=./snapshots/hmd-migration --export-on-exit=./snapshots/hmd-migration --project demo-linyup",
    "emulators:export:demo": "firebase emulators:export ./snapshots/demo --project demo-linyup",
    "emulators:export:swimli": "firebase emulators:export ./snapshots/swimli --project demo-linyup",
    "emulators:export:hmd": "firebase emulators:export ./snapshots/hmd-migration --project demo-linyup",
    "emulators:all": "node scripts/emulators-run.mjs --only auth,firestore,functions,storage --import=./snapshots/all --export-on-exit=./snapshots/all --project demo-linyup",
    "emulators:export:all": "firebase emulators:export ./snapshots/all --project demo-linyup",
    "stripe:listen": "stripe listen --forward-to localhost:5001/demo-linyup/europe-west6/handleStripeWebhook --forward-connect-to localhost:5001/demo-linyup/europe-west6/handleConnectWebhook",
    "stripe:sync": "tsx scripts/stripe-sync.ts",
    "connect:test-account": "tsx scripts/connect-test-account.ts",
    "migrate:hmd": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-hmd.ts",
    "backfill:weekly-reports": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-weekly-reports.ts",
    "backfill:rank-level-ids": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-rank-level-ids.ts",
    "migrate:hmd:sample": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-hmd.ts --target-emulator --reset --teams \"HMD Basel,HMD Team Galli,HMD Team Marzella\"",
    "promote:team": "tsx --tsconfig tsconfig.scripts.json scripts/promote-team.ts",
    "staging:seed": "tsx scripts/seed-staging.ts",
    "staging:reset": "tsx scripts/reset-staging-db.ts --confirm",
    "reset:org": "tsx --tsconfig tsconfig.scripts.json scripts/reset-org-tenant.ts",
    "lead:seed": "tsx scripts/seed-lead.ts",
    "sandbox:seed": "tsx scripts/seed-sandbox.ts",
    "sandbox:reset": "tsx scripts/reset-sandbox-db.ts",
    "purge:team": "tsx --tsconfig tsconfig.scripts.json scripts/purge-team.ts",
    "messaging:policy": "tsx scripts/messaging-policy.ts",
    "snapshot:ranks": "tsx scripts/snapshot-ranks.ts",
    "backfill:finance": "tsx scripts/backfill-finance-journal.ts",
    "backfill:document-versions": "tsx scripts/backfill-document-versions.ts",
    "audit:document-visibility": "tsx scripts/audit-document-visibility.ts",
    "backfill:document-mirrors": "tsx scripts/backfill-document-mirrors.ts",
    "backfill:subscription-lifecycle": "tsx scripts/backfill-subscription-lifecycle.ts",
    "backfill:gateway-data": "tsx scripts/backfill-gateway-data.ts",
    "backfill:booking-joined-at": "tsx scripts/backfill-booking-joined-at.ts",
    "backfill:contact-counts": "tsx scripts/backfill-contact-counts.ts",
    "backfill:partner-apps": "tsx scripts/backfill-partner-apps.ts",
    "backfill:contact-notes-count": "tsx scripts/backfill-contact-notes-count.ts",
    "backfill:ledger-ttl": "tsx scripts/backfill-ledger-ttl.ts",
    "backfill:affiliation-active-orgs": "tsx scripts/backfill-affiliation-active-orgs.ts",
    "backfill:activity-type-mirrors": "tsx scripts/backfill-activity-type-mirrors.ts",
    "backfill:site-translations": "tsx scripts/backfill-site-translations.ts",
    "backfill:team-public-profile": "tsx scripts/backfill-team-public-profile.ts",
    "typecheck:seeds": "tsc -p tsconfig.seedcheck.json",
    "verify:waiver-ledger": "tsx scripts/verify-waiver-ledger.ts",
    "provision:demo": "tsx scripts/provision-demo-tenant.ts"
  },
  "devDependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.18.0",
    "prettier": "^3.4.2",
    "stripe": "^22.1.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
