rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // Auth and Roles functions
		//-------------------------------------------------------

    // if the .auth property is not set, the user is not signed in
    function isAuthed() {
      return request.auth.uid != null
    }

    function isOwner(res) {
      return res.data.createdBy == request.auth.uid
    }

    // DEPRECATED: Use isTeamMember() instead
    // Kept for backward compatibility during migration
    function isTeacher(res) {
      return res.data.teacher == request.auth.uid
    }

    // return the current users roles
    // Must degrade to {} rather than error. `roles` is absent on almost every
    // user doc (it's an operator-only field), and a missing doc has no `.data`
    // at all — both cases used to raise "Property roles is undefined on object"
    // instead of evaluating to false. An evaluation error still denies, but it
    // denies LOUDLY: the client sees an internal rules error rather than a
    // clean permission-denied, so an ordinary "you may not read this" surfaced
    // as a crash. Guard the doc read, then read the field with a default.
    function getRoles() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {})
        : {};
    }

    // check if the current user has a specific role
    function hasRole(role) {
      //superadmin has all roles (not really nice but I need this)
      // Indexed with .get(key, false): map["missing"] is itself an evaluation
      // error, so the {} above would just move the crash one line down.
      return getRoles().get('superadmin', false) == true
      ||
      (isAuthed() && getRoles().get(role, false) == true);
    }

    // check if the user has any of the given roles (list)
    function hasAnyRole(roles) {
      return isAuthed() && getRoles().keys().hasAny(roles);
    }


    // Team Helper functions
    //-------------------------------------------------------

    // Get the current user's active team ID
    function getUserCurrentTeam() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentTeam
    }

    // Check if user is a member of a specific team
    function isTeamMember(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid))
    }

    // Check if user is a member of the resource's team (supports both teamId and teacher fields)
    function isMemberOfResourceTeam(res) {
      // Try teamId first (new model), fall back to teacher (old model)
      let teamId = res.data.teamId;
      return teamId != null && isTeamMember(teamId)
    }

    // Check if user has a specific role in a team
    function hasTeamRole(teamId, role) {
      let membership = get(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid)).data;
      let userRole = membership.role;

      // Role hierarchy: owner > manager > viewer
      return userRole == 'owner' ||
             (role == 'manager' && userRole == 'manager') ||
             (role == 'viewer' && (userRole == 'owner' || userRole == 'manager' || userRole == 'viewer'));
    }

    // ── Plugin install eligibility ───────────────────────────────────────────
    //
    // The plan tiers as an ORDER, so a rule can ask "at least" instead of
    // enumerating. Mirrors PLAN_ORDER in packages/shared/src/types/plan.ts.
    function planRank(plan) {
      return plan == 'organization' ? 3
           : plan == 'studio' ? 2
           : plan == 'coach' ? 1
           : 0;
    }

    function teamPlanOf(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.get('plan', '');
    }

    // The lowest plan that may install each plugin from the CLIENT — the twin of
    // CLIENT_INSTALLABLE_FROM in packages/shared/src/types/pluginDefaults.ts.
    // See the installed_plugins rule for why this list exists and what keeps it
    // honest (a test that reads the manifests, that file and this one).
    function clientInstallableRank(pluginId) {
      return pluginId in ['gift-cards'] ? 0
           : pluginId in ['asset-register', 'contact-groups', 'custom-fields'] ? 1
           : 2;
    }

    // The team's `payments` map (Stripe Connect feature flag + connected-account
    // mirror) is managed only by Cloud Functions (Admin SDK) and platform admins.
    // Owners must not self-toggle connectEnabled (the feature ships dark, enabled
    // per studio by an operator) or forge the connected-account mirror.
    function paymentsUnchanged() {
      return request.resource.data.get('payments', {}) == resource.data.get('payments', {});
    }

    // The OPERATOR-OWNED fields on a tenant document.
    //
    // `flags` decides whether a tenant counts toward platform metrics and
    // whether the daily trial sweep may lapse it; `plan`, `plan_status` and
    // `trial_ends_at` are what the studio is entitled to and until when. All
    // four are written by Cloud Functions and the operator console — never by
    // the tenant — and `TenantFlags`' own doc comment has said "Operator-set
    // only; never client-writable" since it was written.
    //
    // It was not true. Only `payments` was guarded, so a team OWNER could grant
    // themselves a plan, clear an expiring trial, or set `flags.internal` and
    // vanish from every platform number. That mattered little while owners were
    // all founders; it stops being fine the moment an owner login is shared —
    // which is exactly what a demo tenant is for.
    function tenantGovernanceUnchanged() {
      return request.resource.data.get('flags', {}) == resource.data.get('flags', {})
             && request.resource.data.get('plan', null) == resource.data.get('plan', null)
             && request.resource.data.get('plan_status', null) == resource.data.get('plan_status', null)
             && request.resource.data.get('trial_ends_at', null) == resource.data.get('trial_ends_at', null);
    }

    // Organization Helper functions
    //-------------------------------------------------------

    function isOrgMember(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/org_members/$(request.auth.uid))
    }

    function hasOrgRole(orgId, role) {
      let membership = get(/databases/$(database)/documents/organizations/$(orgId)/org_members/$(request.auth.uid)).data;
      let userRole = membership.role;
      // org_admin can do everything; org_viewer is read-only
      return userRole == 'org_admin' ||
             (role == 'org_viewer' && userRole == 'org_viewer');
    }

    // THE SAME QUESTION AS `hasOrgRole(orgId, 'org_admin')`, ASKED SAFELY.
    //
    // `hasOrgRole` does an UNGUARDED `get(...).data` on the caller's org_members
    // row. A `get()` of a document that does not exist returns null, and reading
    // `.data` off null is an evaluation ERROR — not a `false`. Every existing
    // caller survives that only because it sits LAST in an `||` whose earlier arm
    // short-circuits for the ordinary case (a team member reading their own
    // team's contacts never reaches `isOrgAdminOfTeam`).
    //
    // A rule whose FIRST question is "are you an org admin" has no such earlier
    // arm, so it needs the existence check. Takes the org id as data — the
    // affiliation document names its own issuer — so it costs no `teams/{id}`
    // read, which an org admin cannot do anyway (that document is members-only).
    function isOrgAdminOfOrg(orgId) {
      return isAuthed()
             && orgId != null
             && isOrgMember(orgId)
             && hasOrgRole(orgId, 'org_admin');
    }

    // Check if the current user is an org_admin of the org that owns the given team
    function isOrgAdminOfTeam(teamId) {
      let orgId = get(/databases/$(database)/documents/teams/$(teamId)).data.get('org_id', null);
      return orgId != null && hasOrgRole(orgId, 'org_admin');
    }

    // Check if the current user is an org_admin of the org that owns the given
    // ORG-SCOPED event. Event subcollections (categories/attendees) previously
    // gated only on belongsToUserTeam(parent), which can never pass for an org
    // event because its teamId is null — this restores access for org admins.
    function isOrgAdminOfEvent(eventId) {
      let e = get(/databases/$(database)/documents/events/$(eventId)).data;
      let orgId = e.get('orgId', null);
      return e.get('scope', '') == 'org' && orgId != null && hasOrgRole(orgId, 'org_admin');
    }

    // A MEMBER STUDIO of the organisation that owns this event.
    //
    // The parent event's own read rule already admits `currentTeamInOrg`, but its
    // subcollections did not — and `belongsToUserTeam` starts `teamId != null`,
    // which an org-scoped event never satisfies (transforms/events.ts sets
    // `teamId: null` on every migrated HMD event). So a studio could open a
    // federation camp and read NEITHER its categories nor its RSVPs: the
    // check-in screen reported "no categories configured" and the attendee list
    // rendered as "nobody responded", both of which are a permission denial
    // wearing the costume of an empty result.
    //
    // READ ONLY, deliberately. Authoring an org event's divisions stays with the
    // org admin who owns the event; a member studio needs to SEE them to check a
    // competitor in.
    function currentTeamInOrgOfEvent(eventId) {
      let e = get(/databases/$(database)/documents/events/$(eventId)).data;
      let orgId = e.get('orgId', null);
      return e.get('scope', '') == 'org' && orgId != null && currentTeamInOrg(orgId);
    }

    // The tenant stamp denormalised onto an event subcollection document must
    // match the parent event's own. Without this, a manager could inject rows
    // into ANOTHER studio's event carrying their own teamId — each write would
    // pass a capability check against a team they legitimately manage.
    function tenantMatchesEvent(eventId, data) {
      let e = get(/databases/$(database)/documents/events/$(eventId)).data;
      return data.get('teamId', null) == e.get('teamId', null)
             && data.get('orgId', null) == e.get('orgId', null);
    }

    // Returns true if the current user may write org-locked affiliation fields.
    // Short-circuits to true when the team has no org or the org has not enabled the
    // affiliation lock (Organization.lock_affiliation).
    function orgAffiliationWriteAllowed(teamId) {
      let orgId = get(/databases/$(database)/documents/teams/$(teamId)).data.get('org_id', null);
      return orgId == null
        || !get(/databases/$(database)/documents/organizations/$(orgId)).data.get('lock_affiliation', false)
        || get(/databases/$(database)/documents/organizations/$(orgId)/org_members/$(request.auth.uid)).data.get('role', '') == 'org_admin';
    }

    // A member of a studio that GENUINELY belongs to `orgId` may read that org's
    // shared collections. "Genuinely belongs" is proven by the server-written
    // organizations/{orgId}/org_teams/{teamId} doc (Cloud-Functions-only, written
    // in the SAME batch that sets the team's org_id when an org invitation is
    // accepted — see orgs/index.ts), NOT by teams/{teamId}.org_id: that field is
    // client-writable and unconstrained on team create, so trusting it let anyone
    // forge a team carrying a target org's id and read its shared data.
    // isTeamMember pins the current team to one the caller actually belongs to.
    //
    // The membership must be ACTIVE. When a studio is unlinked (org lapse or
    // removal, orgs/lifecycle.ts) its team.org_id is DELETED but this row is kept
    // as status:'inactive' — so an existence check alone would let an ex-member
    // keep reading the federation's shared data. Absent/malformed status reads as
    // 'active' (the accept batch always writes 'active', and pre-status rows are
    // live members).
    function currentTeamInOrg(orgId) {
      let ct = getUserCurrentTeam();
      return isAuthed()
        && isTeamMember(ct)
        && exists(/databases/$(database)/documents/organizations/$(orgId)/org_teams/$(ct))
        && get(/databases/$(database)/documents/organizations/$(orgId)/org_teams/$(ct)).data.get('status', 'active') == 'active';
    }

    // Check if resource's teamId matches user's current team OR if teacher field matches user (backward compat)
    function belongsToUserTeam(res) {
      return (res.data.teamId != null && res.data.teamId == getUserCurrentTeam() && isTeamMember(res.data.teamId))
             || isTeacher(res);
    }

    // ── Coach own-data scope (capability model) ──────────────────────────────
    // owner/manager/viewer are all-scoped (today's behaviour); a coach is own-scoped
    // and may only manage contacts/sessions assigned to or created by them. Members
    // without a stored `scope` are treated as all-scoped, so existing members and the
    // three system roles are entirely unaffected by these gates.
    function callerIsAllScoped(teamId) {
      // No member doc (e.g. legacy teacher-based access) ⇒ treat as all-scoped so
      // existing access is never tightened. Only a member doc with scope=='own'
      // (a coach) is restricted.
      return !exists(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid))
             || get(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid)).data.get('scope', 'all') != 'own';
    }

    function callerOwnsContact(contactRes) {
      return request.auth.uid in contactRes.data.get('assigned_coach_ids', [])
             || contactRes.data.get('createdBy', null) == request.auth.uid;
    }

    function callerOwnsSession(sessionRes) {
      return sessionRes.data.get('providerId', null) == request.auth.uid
             || sessionRes.data.get('createdBy', null) == request.auth.uid;
    }

    // Team access to a specific contact, honouring coach own-scope. Equivalent to
    // belongsToUserTeam for all-scoped members; adds the ownership filter for a coach.
    function canAccessContact(contactRes) {
      return belongsToUserTeam(contactRes)
             && (callerIsAllScoped(contactRes.data.teamId) || callerOwnsContact(contactRes));
    }

    // Does the caller hold capability `cap` in teamId? Owner is always all-capable
    // (the role line below); everyone else must hold `cap` in the capabilities set
    // syncMemberCapabilities denormalizes onto their member doc. A member doc with
    // NO capabilities field is DENIED — fail closed.
    //
    // This used to fall OPEN for such docs ("any non-viewer can do anything"),
    // which was a within-tenant escalation: an unmigrated coach held contacts /
    // activities / schedule manage and finance reads regardless of what the studio
    // configured, and the permission UI showed a restriction the rules did not
    // enforce. The only docs that ever lacked the field are OWNERS (verified live
    // in prod + staging, 2026-08-26), and they pass on the role line, so closing
    // the fallthrough locks out nobody — and a future unmigrated non-owner is
    // under-privileged (visibly wrong) rather than over-privileged (silently wrong).
    function hasTeamCapability(teamId, cap) {
      let m = get(/databases/$(database)/documents/teams/$(teamId)/team_members/$(request.auth.uid)).data;
      return m.role == 'owner'
             || cap in m.get('capabilities', []);
    }

    // Write access to a contact = read access (team + own-scope) AND the manage
    // capability. A viewer can read but not write.
    function canWriteContact(contactRes) {
      return canAccessContact(contactRes)
             && hasTeamCapability(contactRes.data.teamId, 'contacts.manage');
    }

    function isSelfContact(contactId) {
      return request.auth != null
             && request.auth.token.contactId == contactId
             && request.auth.token.sessionExpires != null
             && request.auth.token.sessionExpires >= request.time.toMillis();
    }

    function sharesContactEmail(res) {
      return request.auth != null
             && request.auth.token.email != null
             && res.data.email != null
             && request.auth.token.email == res.data.email
             // The email must be provably controlled by the caller, otherwise a
             // Firebase email/password account registered with a victim's address
             // (email_verified == false) could read that victim's contact records
             // across every team. Real Firebase users must have a verified email;
             // passwordless contact sessions are already code-verified but their
             // custom token carries no email_verified claim, so accept a live
             // (non-expired) contact session in its place.
             && (request.auth.token.email_verified == true
                 || (request.auth.token.sessionExpires != null
                     && request.auth.token.sessionExpires >= request.time.toMillis()));
    }

    // A valid contact session (custom token) scoped to a given team. Used by the
    // public "Space" web area so a contact can read gated courses for their team.
    function isContactOfTeam(teamId) {
      return request.auth != null
             && request.auth.token.teamId == teamId
             && request.auth.token.sessionExpires != null
             && request.auth.token.sessionExpires >= request.time.toMillis();
    }

    // The calling contact's document (custom-token session). Costs one extra
    // get(); repeated calls within one evaluation hit the access-call cache,
    // which is what already lets the course tiers below ask for the id twice.
    function callerContactData() {
      return get(/databases/$(database)/documents/contacts/$(request.auth.token.contactId)).data;
    }

    // Is the contact's flat plan grant still in force? The rules twin of
    // `planGrantIsCurrent` (@linyup/shared) — a one-time price with
    // `included_months` stamps an end date, and access must stop at it HERE too,
    // or a member whose two months ran out could still open the course the gate
    // and the checkout both refuse her.
    //
    // The `== null` guard is not decoration: the field is written EXPLICITLY as
    // null for every grant with no end of its own, so a `get(…, default)`
    // fallback would return that stored null and compare it to a timestamp.
    function planGrantCurrent(d) {
      return d.get('subscription_expires_at', null) == null
             || d.subscription_expires_at > request.time;
    }

    // The calling contact's active subscription type id, or '' once the grant
    // that carried it has lapsed. Only evaluated for the gated course tiers.
    function callerContactSubscriptionTypeId() {
      return planGrantCurrent(callerContactData())
             ? callerContactData().get('subscription_type_id', '')
             : '';
    }

    // Whether the calling contact session owns a lifetime purchase of a course.
    function hasPurchasedCourse(courseId) {
      return request.auth != null
             && request.auth.token.contactId != null
             && exists(/databases/$(database)/documents/courses/$(courseId)/purchases/$(request.auth.token.contactId));
    }

    // Whether a course's benefit grants the calling contact INCLUDED access:
    // Course.benefit {effect:'included', subscriptionTypeIds} held via the
    // contact's primary subscription type. Mirrors the resolver's covered
    // decision (checkout refuses the sale for exactly these holders, so the
    // rules MUST grant the read or they could neither pay nor watch). The
    // `is map` guard matters: benefit may be absent OR stored as null.
    function courseBenefitIncludesCaller(c) {
      return c.get('benefit', null) is map
             && c.benefit.get('effect', '') == 'included'
             && c.benefit.get('subscriptionTypeIds', []).hasAny([callerContactSubscriptionTypeId()]);
    }

    // Whether the public web (anonymous or a contact session) may read a course doc.
    //  - free         → anyone
    //  - registered   → any signed-in contact of the owning team
    //  - subscription → signed-in contact whose subscription_type_id is allowed
    //  - purchase     → signed-in contact who bought it, OR whose subscription_type_id
    //                   is in the (optional) "included free" list or the course's
    //                   included-for-subscribers benefit
    function canReadPublishedCourse(courseId, c) {
      return c.status == 'published' && (
           c.accessRule.type == 'free'
        || (c.accessRule.type == 'registered' && isContactOfTeam(c.teamId))
        || (c.accessRule.type == 'subscription' && isContactOfTeam(c.teamId)
            && c.accessRule.subscriptionTypeIds.hasAny([callerContactSubscriptionTypeId()]))
        || (c.accessRule.type == 'purchase' && isContactOfTeam(c.teamId)
            && (hasPurchasedCourse(courseId)
                || c.accessRule.get('subscriptionTypeIds', []).hasAny([callerContactSubscriptionTypeId()])
                || courseBenefitIncludesCaller(c)))
      );
    }


    // Helper functions
    //-------------------------------------------------------
    // function notUpdating(field) {
    //   return !(field in request.resource.data) || resource.data[field] == request.resource.data[field]
    // }

    // function eventIsClosed(eventId){
    //    get(/databases/$(database)/documents/events/$(eventId));
    // }


    // DB rules
    //-------------------------------------------------------
    //
    // You'll forget this :)
    //
    //	resource.data --> current data in db
    //	request.resource.data --> data in the request

    // Signup gating (limited launch).
    // app_settings/public: world-readable signup flag so apps/web can adapt its
    // UX. Only this ONE doc is public — global_settings (operator config) stays
    // default-deny. Writes happen only via the operator console (Admin SDK).
    match /app_settings/public {
      allow read: if true;
      allow write: if false;
    }
    // app_settings/mobile: the member app's world-readable policy (minimum
    // supported version + store links, MobileAppSettings in @linyup/shared).
    // Read BEFORE sign-in, so it must be open; operator-written only (console,
    // Admin SDK). Every other app_settings doc — review_access above all, which
    // holds a sign-in code — stays default-deny by having no match here.
    match /app_settings/mobile {
      allow read: if true;
      allow write: if false;
    }
    // signup_allowlist (emails are PII) and signup_invites are touched ONLY by
    // the Admin SDK (operator console + Cloud Functions, which bypass rules).
    match /signup_allowlist/{email} {
      allow read, write: if false;
    }
    match /signup_invites/{inviteId} {
      allow read, write: if false;
    }

    // Mail pipeline (Brevo). Written ONLY by Cloud Functions (the event webhook +
    // mail service, which bypass rules). Never client-readable — mail_suppressions
    // holds recipient addresses (PII) and mail_sends is internal delivery state.
    match /mail_suppressions/{emailHash} {
      allow read, write: if false;
    }
    match /mail_sends/{idempotencyKey} {
      allow read, write: if false;
    }
    // Contact update LINKS — scoped grants to edit one contact's own details.
    // Functions-only in BOTH directions, and the deny is load-bearing rather
    // than tidy: the document carries an OTP hash and the grant's expiry, so a
    // readable copy is a list of live links and a writable one is a way to
    // extend your own. The four callables in contacts/contactUpdateLinks.ts are
    // the entire surface; see @linyup/shared → types/contactLink.ts for why the
    // doc id is a hash of the token rather than the token.
    match /contact_update_links/{tokenHash} {
      allow read, write: if false;
    }
    // Custom public domains — the GLOBAL uniqueness registry (doc id = hostname).
    // Functions-only, and deliberately unreadable by clients too: it is a list of
    // every studio's custom domain, so a readable registry would let any signed-in
    // user enumerate the customer base. A tenant reads its own
    // integrations/public_domain doc instead. See docs/custom-domains.md.
    match /public_domains/{hostname} {
      // GET is public, LIST is not — and the split is the whole point. Resolving
      // an incoming custom hostname to its tenant is a public act: the app's
      // middleware does it for every visitor to `book.theirdojo.ch`, with no
      // credentials and no admin SDK. But the doc id IS the hostname, so `get`
      // requires already knowing the domain — while `list` would hand anyone the
      // entire customer roster.
      //
      // The document is therefore written to be readable: it carries the tenant
      // id and scope (both already public via `public_profile`) and the
      // Cloudflare hostname id, which is an opaque handle that does nothing
      // without the platform's zone-scoped API token.
      allow get: if true;
      allow list, write: if false;
    }

    // SMS pipeline — same posture as mail: functions-only, phone numbers are PII.
    match /sms_suppressions/{phoneHash} {
      allow read, write: if false;
    }
    // Per-tenant outbound-delivery policy — OPERATOR-only (Admin SDK: seeders,
    // ops scripts, operator console). Never client-writable: demo tenants have
    // shared owner logins, so an owner-writable policy could be flipped to live
    // delivery by anyone. Resolved server-side by the mail/SMS services.
    match /messaging_policies/{entityId} {
      allow read, write: if false;
    }

    // Private user profiles
    match /users/{userId} {
      // Users can only read their own profile; admins can read any. Restricts PII (email) exposure.
      allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');

      // `roles` LIVES ON THIS DOCUMENT AND IS THE PLATFORM-ADMIN GRANT ITSELF.
      //
      // `hasRole()` resolves entirely from `users/{request.auth.uid}.roles`, and
      // `superadmin` satisfies every role by construction. So while this rule was
      // a bare `allow write: if request.auth.uid == userId`, ANY authenticated
      // user could grant themselves `roles.admin` in one write and then use the
      // `|| hasRole('admin')` bypass on the team rule to rewrite their own `plan`,
      // `plan_status` and `flags` — the very fields `tenantGovernanceUnchanged()`
      // exists to protect. `flags.comped` is among them, and it waives Linyup's
      // platform fee on every payment the studio takes.
      //
      // The escalation defeated the guard rather than going around it, which is
      // why closing it belongs HERE and not in another value-pin on `teams`.
      //
      // Nothing on any client writes `roles` — the entire client write surface of
      // this document is `locale`, `firstname`, `lastname` and the feedback
      // counters — so pinning it costs nothing. Cloud Functions use the Admin SDK
      // and bypass rules entirely.
      allow create: if request.auth.uid == userId
                    && !('roles' in request.resource.data);
      allow update: if request.auth.uid == userId
                    && request.resource.data.get('roles', {}) == resource.data.get('roles', {});
      allow delete: if request.auth.uid == userId;

      // Activity log sub-collection
      match /activity_log/{activityLogId} {
        allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // Reports sub-collection — private to the owning user (no public consumer).
      match /user_weekly_reports/{weeklyReportId} {
        allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // Public profile sub-collection
      match /public_profile/{publicProfileUserId} {
        allow read;
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // DEPRECATED: Sessions Tags sub-collection (moved to teams/{teamId}/sessions_tags)
      // Kept for backward compatibility during migration — owner-only read (no
      // public consumer; the live data lives under teams/{teamId}/sessions_tags).
      match /sessions_tags/{tagId} {
        allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

      // DEPRECATED: Places sub-collection (moved to teams/{teamId}/team_places)
      // Kept for backward compatibility during migration — owner-only read.
      match /user_places/{tagId} {
        allow read: if (isAuthed() && request.auth.uid == userId) || hasRole('admin');
        allow write: if isOwner(get(/databases/$(database)/documents/users/$(userId))) || hasRole('admin');
      }

    }

    // Teams collection
    match /teams/{teamId} {
      // Team members can read their own team. A user can also read a team they created
      // (needed during the signup flow before they are formally added as a member).
      // isAuthed() guard must come first — isTeamMember() accesses request.auth.uid which
      // throws an evaluation error (not just false) when request.auth is null.
      allow read: if isAuthed() && (
               isTeamMember(teamId)
               || resource.data.get('createdBy', null) == request.auth.uid);

      // Only team owners can update team details. The `payments` map (Connect
      // feature flag + account mirror) and the governance fields (plan, status,
      // trial end, flags) are reserved for Cloud Functions / admins.
      allow update: if isTeamMember(teamId) && hasTeamRole(teamId, 'owner')
                    && ((paymentsUnchanged() && tenantGovernanceUnchanged()) || hasRole('admin'));

      // Only users with admin role can create teams, OR the user is provisioning their own first team
      allow create: if isAuthed() && (hasRole('admin') || request.resource.data.createdBy == request.auth.uid);

      // Only team owners can delete teams
      allow delete: if isTeamMember(teamId) && hasTeamRole(teamId, 'owner');

      // Public profile subcollection - minimal public data for bio-link
      match /public_profile/{publicProfileId} {
        // Anyone can read (needed for public bio-link access)
        allow read;
        // Team members can update bio-link settings (appearance, links, booking config)
        allow write: if isTeamMember(teamId);
      }

      // Team members subcollection
      match /team_members/{memberId} {
        // Team members can read the member list
        // Also allow users to read their own membership record (needed for initial team lookup)
        allow read: if isTeamMember(teamId) || memberId == request.auth.uid;

        // Only owners can add/remove/update team members. There is deliberately
        // NO client self-provision branch anymore: team creation runs through the
        // `createStudioTeam` callable (Admin SDK, which bypasses rules) and writes
        // the initial owner membership there, so no client ever writes
        // team_members directly. The bootstrap disjunct that used to let a new
        // owner self-provision at signup was removed once that callable shipped
        // and the web app rolled out — a self-provision rule has to grant a write
        // to a NOT-yet-member (i.e. to "anyone"), which is exactly the footgun the
        // 2026-08-26 org/team takeovers (#106/#112) exploited; bootstrapping in the
        // callable removes the whole class of hole rather than bounding it.
        //
        // A SECOND USER IS A STUDIO FEATURE (`multiple_managers` in PLAN_FEATURES).
        // An owner may always write their OWN membership doc; writing SOMEBODY
        // ELSE's is a seat-creating seam reachable straight from a client, so it
        // refuses on exactly the tier the callables do (`requireExtraUserPlan`) —
        // otherwise that gate is one Firestore write from being bypassed. Literals
        // because rules cannot import the flag; `seatGate.test.ts` pins this list
        // to PLAN_FEATURES so the two cannot drift. Invitation acceptance does NOT
        // come through here — it runs on the Admin SDK and is gated in the callable.
        allow write: if hasTeamRole(teamId, 'owner') &&
                       (memberId == request.auth.uid ||
                        get(/databases/$(database)/documents/teams/$(teamId)).data.get('plan', 'free') in ['studio', 'organization']);
      }

      // Customizable role config (currently only the Coach role). Team members read it
      // (to know the Coach permission set); managers+ edit it. Owner-only capabilities
      // stored here are stripped by resolveRoleCapabilities when member caps are
      // recomputed, so a stray capability can never actually grant access.
      match /role_config/{roleId} {
        allow read: if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager');
      }

      // Activity log subcollection (moved from users/{userId}/activity_log)
      match /activity_log/{activityLogId} {
        // All team members can read activity log
        allow read: if isTeamMember(teamId);

        // Cloud functions can write, team members can read
        allow write: if false; // Only cloud functions should write to activity log
      }

      // Team weekly reports subcollection (moved from users/{userId}/user_weekly_reports)
      match /team_weekly_reports/{weeklyReportId} {
        // All team members can read weekly reports
        allow read: if isTeamMember(teamId);

        // Cloud functions can write, team members can read
        allow write: if false; // Only cloud functions should write to weekly reports
      }

      // Team places subcollection. Team members read; managers manage (CRUD).
      //
      // AN ORG ADMIN ALSO READS, so Org > Places can list every member studio's
      // locations beside the organisation's own — the same shape
      // `program_templates` and `contacts` already use. READ ONLY, deliberately:
      // a studio's locations stay the studio's to edit, so `write` is untouched,
      // and an org_viewer is not admitted at all.
      match /team_places/{placeId} {
        allow read:  if isTeamMember(teamId) || isOrgAdminOfTeam(teamId);
        allow write: if hasTeamRole(teamId, 'manager');
      }

      // Team sessions tags subcollection (moved from users/{userId}/sessions_tags)
      match /sessions_tags/{tagId} {
        // All team members can read tags
        allow read: if isTeamMember(teamId);

        // Cloud functions can write (counters managed by functions)
        allow write: if false; // Only cloud functions should write to tags
      }

      // Team invitations subcollection
      match /team_invitations/{invitationId} {
        // Team members can read invitations
        allow read: if isTeamMember(teamId);

        // Only cloud functions can write (send, accept, cancel invitations)
        allow write: if false;
      }

      // Contact requests subcollection (data update requests, etc.)
      match /contact_requests/{requestId} {
        // Team members can read requests
        allow read: if isTeamMember(teamId);

        // Only cloud functions can write (create, approve, discard)
        allow write: if false;
      }

      // Team alerts subcollection (non-contact-specific alerts)
      match /team_alerts/{alertId} {
        // Team members can read alerts
        allow read: if isTeamMember(teamId);

        // Managers and owners can create, update, delete alerts
        allow write: if hasTeamRole(teamId, 'owner') || hasTeamRole(teamId, 'manager');
      }

      // Alert presets subcollection (reusable alert templates)
      match /alert_presets/{presetId} {
        // Team members can read presets
        allow read: if isTeamMember(teamId);

        // Only owners can manage presets
        allow write: if hasTeamRole(teamId, 'owner');
      }

      // Integrations: payment gateways (Stripe / Payrexx — secrets in Secret
      // Manager) and the email_sender config (Brevo sender model + BYO domain
      // verification state — holds NO credentials).
      match /integrations/{integrationId} {
        // Only owners can view integration configuration
        allow read: if hasTeamRole(teamId, 'owner');
        // …and modify it, EXCEPT public_domain, which is server-written only.
        // That doc is not merely display state: whatever resolves an incoming
        // custom hostname to a tenant reads the hostname from here, so a client
        // able to write it could name a hostname belonging to another studio.
        // The authority is Cloudflare plus the public_domains/{hostname} claim;
        // this doc must never be able to disagree with them.
        allow write: if hasTeamRole(teamId, 'owner')
                     && integrationId != 'public_domain';
      }

      // Per-team settings for features that are NOT plugins
      // (teams/{teamId}/settings/{settingId}). This block previously did not
      // exist at all — the `match /teams/{teamId}` block enumerates its
      // subcollections one by one with no catch-all, and Firestore denies any
      // path no rule matches — which was dormant only because nothing wrote
      // there. It landed in the SAME commit as its first writer (the
      // signup-consent selection, moved out of installed_plugins/documents when
      // Documents stopped being a plugin): without it the studio's first save
      // fails outright with a permission error.
      //
      // Owner-write, member-read, matching integrations/ next door: these are
      // studio-wide configuration, not per-feature content.
      match /settings/{settingId} {
        allow read:  if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'owner');
      }

      // Installed plugins — teams enable/configure plugins here.
      // All members can read (needed by automation UI and nav display).
      //
      // AN OWNER MAY INSTALL WHAT THEIR PLAN ALREADY INCLUDES, which is not the
      // same as "Studio and up". This rule used to say exactly that, with a
      // comment explaining that Coach plans activate plugins as PAID add-ons —
      // true when written, and falsified by the 2026-06 overhaul that made
      // Contact Groups and Custom Fields *included* from Coach and removed them
      // from PLUGIN_ADDONS. After it, a Coach saw both offered as "Included",
      // was denied here on click, and `activatePluginAddon` refused them too
      // ("not an add-on plugin") — no path at all. Gift Cards had the same hole
      // one tier lower, at Free.
      //
      // `clientInstallableRank` mirrors `pluginAccessForPlan`'s `included` arm.
      // The default is Studio, which keeps every paid add-on server-only: at
      // Coach an add-on must go through `activatePluginAddon` so it cannot be
      // self-granted, and at Studio/Org it is included anyway.
      //
      // THIS LIST IS DERIVED DATA. `CLIENT_INSTALLABLE_FROM` in
      // packages/shared/src/types/pluginDefaults.ts is its twin, the plugin
      // manifests in apps/web are the truth, and
      // packages/functions/src/teams/teamDefaults.test.ts reads all three and
      // fails the build when they disagree. Do not edit one alone.
      //
      // Locked plugins (e.g. 'ai-assistant') can be installed ONLY via the
      // unlockPlugin callable (admin SDK, strong-key checked) — the direct client
      // `create` is denied for those ids below. Owners may still configure
      // (update) and uninstall (delete) an installed locked plugin normally.
      match /installed_plugins/{pluginId} {
        allow read:   if isTeamMember(teamId);
        allow create: if hasTeamRole(teamId, 'owner')
                      && planRank(teamPlanOf(teamId)) >= clientInstallableRank(pluginId)
                      && !(pluginId in ['ai-assistant']);
        allow update, delete: if hasTeamRole(teamId, 'owner')
                      && planRank(teamPlanOf(teamId)) >= clientInstallableRank(pluginId);
      }

      // Subscription types subcollection (team-defined subscription plans and aggregators)
      match /subscription_types/{subscriptionTypeId} {
        // Only team members can read — prevents other teams from enumerating pricing plans.
        allow read: if isTeamMember(teamId);

        // Managers and owners can create, update, delete subscription types
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Team-local affiliation type catalog (club / licence / grading). Org-wide
      // types live under organizations/{orgId}/affiliation_types.
      match /affiliation_types/{typeId} {
        allow read: if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Products subcollection (team-defined sellable products — merch/equipment).
      // The public storefront reads the world-readable public_profile summary, never
      // this collection; the checkout callable resolves products via the Admin SDK.
      match /products/{productId} {
        // Only team members can read the raw catalogue (e.g. inactive drafts).
        allow read: if isTeamMember(teamId);
        // Managers and owners manage the catalogue.
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Subscription transition log (team-level event log for funnel/pattern analytics)
      match /subscription_transitions/{transitionId} {
        allow read: if isTeamMember(teamId) || hasRole('admin');
        allow write: if false; // written only by Cloud Functions
      }

      // Outreach email templates (re-engagement campaigns)
      match /outreach_templates/{templateId} {
        allow read: if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Automation rules (no-show triggers, future expansion)
      match /automation_rules/{ruleId} {
        allow read: if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Automation execution logs — managers can read; only functions write (Admin SDK bypasses rules)
      match /automation_logs/{logId} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Shared contact list filters — saved by managers, visible to all team members
      match /contact_filters/{filterId} {
        allow read:  if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Contact Groups plugin — nested member groups (parent_id hierarchy).
      //
      // Two kinds of membership, with DELIBERATELY different permissions:
      //  • MANUAL  — membership is contacts/{id}.group_ids, so filing a person
      //    follows the CONTACT's write rule: anyone who may edit a contact may
      //    file it (a coach can file their own students). The taxonomy itself —
      //    creating, renaming, nesting, deleting — stays manager/owner. That
      //    split is intentional, not an oversight; group membership is never an
      //    input to any authorization decision, so a coach filing someone
      //    grants no access.
      //  • DYNAMIC — membership is the `rule` field on THIS doc and is never
      //    written to any contact. Because the rule lives here, changing who is
      //    in a dynamic group requires manager/owner, matching the taxonomy.
      match /contact_groups/{groupId} {
        allow read:  if isTeamMember(teamId);
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Inbound webhook endpoints — manager/owner manage; the inboundWebhook function
      // reads via Admin SDK (collectionGroup query) so no client read rule needed there.
      match /webhook_endpoints/{endpointId} {
        allow read:   if isTeamMember(teamId);
        allow write:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // Payment events (Payrexx) — immutable audit trail written by handlePayrexxWebhook.
      // Managers and owners can read; no client writes allowed.
      match /payment_events/{eventId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Stripe Connect member payments / subscriptions (member → studio).
      // Reconciled from Stripe webhooks via the Admin SDK; clients never write.
      // Managers and owners can read for the payments dashboard.
      match /member_payments/{paymentId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }
      match /member_subscriptions/{subscriptionId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Partner (aggregator) visit payout ledger — one row per booking covered
      // via a source:'aggregator' subscription type (FitPass, SportPass, USC…),
      // written by bookSession / cancelBooking via the Admin SDK. Reporting
      // only — the money settles between studio and partner off-platform.
      match /partner_visits/{visitId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Gift cards — the doc id IS the redeemable code, so it is a SECRET:
      // managers may list/read for support; the public checks balances only
      // through the checkGiftCard callable. All writes via Cloud Functions
      // (mint on purchase, holds on redemption, void).
      match /gift_cards/{code} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Promo codes — the doc id IS the code. Unlike a gift card the CODE is not
      // a secret (it is printed on a flyer), but the DOCUMENT is: it carries
      // max_uses, usage_count, live reservations and internal labels, and the
      // collection is a list of every code a scraper could harvest. So: manager
      // read, no client write at all.
      //
      // Writes go through callables and NOT through per-field rules, and the
      // argument is about WHERE the writers live, not how many there are.
      // Every write to this document happens inside a Firestore transaction in
      // connect/promoCodes.ts that read the document first: `usage_count` is
      // written only by the commit transaction, as an absolute value from its
      // own read set, and every `reservations` write is a compare-and-set
      // against the entry it is about to replace or delete. That is a CLOSED
      // SET of writers, all of which can see each other's work.
      //
      // A "these fields yes, that field no" rule would put a writer OUTSIDE
      // that set — on a client, with no transaction, no read set and no
      // ownership marker to compare — and the finite resources on this document
      // (a capped counter, a capped live-reservation map) are exactly the kind
      // that a blind write corrupts. gift_cards and referral_codes avoid the
      // same shape for the same reason. Note this is a claim about writers, not
      // a count of them: adding another transactional writer in that file
      // changes nothing here; adding one anywhere else breaks the argument.
      //
      // The public never reads this collection DIRECTLY. Public traffic reaches
      // it only through callables that read it with the Admin SDK — the
      // previewPromoCode peek on its own rate-limit bucket, and the one-off
      // checkout callables that load a typed code — and none of them ever
      // returns the document.
      match /promo_codes/{code} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;

        // The durable per-PERSON ledger, keyed by a HASH of the normalised
        // email so the doc ids are not a harvestable list of customer
        // addresses. Read for the admin list; cleared only by
        // clearPromoRedemption.
        match /redemptions/{identityKey} {
          allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
          allow write: if false;
        }
      }

      // No-show policy fees — created by the policy engine when a contact's
      // strike count reaches the team threshold; paid via an emailed payment
      // link (webhook marks paid) or waived by a manager callable.
      match /policy_fees/{feeId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Finance journal — the normalized, immutable money-event log (all rails).
      // Written ONLY by Cloud Functions (webhooks / recordManualPayment / backfill);
      // corrections are compensating rows, never edits. Financial data → manager+.
      match /finance_transactions/{txnId} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Derived monthly finance reports — regenerated from the journal by the
      // monthlyFinanceReports cron (always overwritten; journal is source of truth).
      match /finance_monthly_reports/{month} {
        allow read:  if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }

      // Double-entry accounting (finance plugin). Accounts: owner-editable, but
      // code/type are immutable and system accounts can't be minted or deleted
      // from the client. Entries/summaries: Cloud Functions only — corrections
      // are reversal entries, never edits.
      match /accounting_accounts/{code} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow create: if hasTeamRole(teamId, 'owner')
          && request.resource.data.system != true
          && request.resource.data.code == code;
        allow update: if hasTeamRole(teamId, 'owner')
          && request.resource.data.code == resource.data.code
          && request.resource.data.type == resource.data.type
          && request.resource.data.system == resource.data.system;
        allow delete: if false; // deactivate instead — entries reference codes
      }
      match /accounting_settings/{docId} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        // Owner may tune mapping / fiscal config; created & template-switched
        // only via Cloud Functions (seeding). Guarded fields stay server-owned.
        allow update: if hasTeamRole(teamId, 'owner')
          && request.resource.data.chart_template == resource.data.chart_template
          && request.resource.data.closed_through_fiscal_year == resource.data.closed_through_fiscal_year;
        allow create, delete: if false;
      }
      match /accounting_entries/{entryId} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }
      match /accounting_period_summaries/{period} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow write: if false;
      }
      // Entry templates: owner-managed presets for manual entries (+ recurring
      // auto-post). system flag is server-owned (seeded starters); system
      // templates are deactivate-only. Posting correctness never depends on
      // template contents — every post revalidates server-side.
      match /accounting_entry_templates/{templateId} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow create: if hasTeamRole(teamId, 'owner')
          && request.resource.data.system != true;
        allow update: if hasTeamRole(teamId, 'owner')
          && request.resource.data.system == resource.data.system;
        allow delete: if hasTeamRole(teamId, 'owner') && resource.data.system != true;
      }
      // Asset register (finance plugin) — the equipment list behind the
      // statement of assets. REGISTER-ONLY while the ledger is cash-basis:
      // no posting reads these docs, so owner client-writes (incl. delete for
      // typo rows — dispose is the normal end state) are safe. The accrual
      // phase routes writes through callables before postings depend on them
      // (docs/finance-accrual.md §4).
      match /asset_register/{assetId} {
        allow read: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        // MANAGER-WRITABLE while the ledger is cash-basis: the person who knows
        // what kit exists is the one who maintains the list, and no posting
        // reads these docs yet (the rule above this one says why that is safe).
        // Read stays manager+owner — equipment cost is not coach-visible.
        // The accrual phase routes writes through callables before postings
        // depend on these fields, which is where this widens back.
        allow write: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
      }

      // THE booking gate's authorization source: which waivers a booking here
      // requires, and at what version floor. Server-written by
      // publishDocumentVersion / setWaiverRequirement / archiveWaiver, each
      // patching exactly the one entry for the document it is writing, inside
      // the same transaction as that write.
      //
      // It exists because the DISPLAY mirror (TeamPublicProfile.required_waivers,
      // and signup_documents beside it) fails OPEN — it skips any id whose public
      // summary is missing. That is right for a list of consent links and
      // catastrophic for an authorization gate, where "silently skipped" becomes
      // "the required waiver vanished and the booking went through". This
      // document fails CLOSED.
      match /waiver_policy/{policyId} {
        allow read:  if isTeamMember(teamId);
        allow write: if false;
      }

      // Custom event types (team-level; org-level event types live under organizations/{orgId}/event_types)
      match /event_types/{typeId} {
        allow read:   if isTeamMember(teamId);
        allow create: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow update: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow delete: if hasTeamRole(teamId, 'owner');
      }

      // Reusable event programs (team-owned; org-wide templates live under
      // organizations/{orgId}/org_program_templates and are read-only here).
      match /program_templates/{templateId} {
        allow read:  if isTeamMember(teamId) || isOrgAdminOfTeam(teamId);
        allow write: if hasTeamCapability(teamId, 'events.manage');
      }

      // Rebuild jobs subcollection (background score history rebuild tasks)
      match /rebuild_jobs/{jobId} {
        // Owners and managers can read their own job status (for onSnapshot polling)
        allow read: if hasTeamRole(teamId, 'owner') || hasTeamRole(teamId, 'manager');
        // Only cloud functions can write (triggerScoresRebuild creates, processScoresRebuildJob updates)
        allow write: if false;
      }

      // Leaderboard subcollection (gamification scores for student app)
      match /leaderboard/{leaderboardId} {
        // Team members (web app) and students (student app via token) can read
        allow read: if isTeamMember(teamId)
                    || (request.auth != null
                        && request.auth.token.teamId == teamId
                        && request.auth.token.sessionExpires != null
                        && request.auth.token.sessionExpires >= request.time.toMillis());
        // Only cloud functions can write
        allow write: if false;
      }

      // Historical leaderboard snapshots (one doc per YYYY-MM)
      match /leaderboard_history/{month} {
        allow read: if isTeamMember(teamId)
                    || (request.auth != null
                        && request.auth.token.teamId == teamId
                        && request.auth.token.sessionExpires != null
                        && request.auth.token.sessionExpires >= request.time.toMillis());
        allow write: if false;
      }

      // Monthly session counters (written by trackSessions trigger)
      match /session_counts/{month} {
        allow read: if isTeamMember(teamId);
        allow write: if false;
      }

      // Org access requests — org admins request view/manage access to this team.
      // Owners and managers can read requests and approve/deny server-side;
      // only cloud functions write (requestTeamAccess creates, approveTeamAccess updates).
      match /org_access_requests/{orgId} {
        allow read: if hasTeamRole(teamId, 'owner') || hasTeamRole(teamId, 'manager');
        allow write: if false;
      }

      // In-app notifications for team managers/owners (e.g. org access requests).
      // Written ONLY by Cloud Functions (Admin SDK). Managers and owners read;
      // managers can update (e.g. mark as read). Clients never create or delete.
      match /notifications/{notificationId} {
        allow read:   if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow update: if hasTeamRole(teamId, 'manager') || hasTeamRole(teamId, 'owner');
        allow create: if false; // Cloud Functions only
        allow delete: if false; // Cloud Functions only
      }
    }

    // Public user profiles (deprecated - now using users/{userId}/public_profile subcollection)
    // No code reads this collection any more; lock it down (it can be removed once
    // any residual migration data is gone). Public coach bios live in the
    // users/{userId}/public_profile subcollection instead.
    match /users_public/{userId} {
      allow read: if false;
      allow write: if false;
    }

    // Projects
    match /projects/{projectId} {
      // Only projects you own can be viewed
      allow create: if isOwner(request.resource);
      allow read, update, delete: if isOwner(resource);
      // Rules apply to all child collections
      match /{allChildren=**} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)));
      }
    }

    // Contacts
    match /contacts/{contactId} {
      // Create: Must belong to user's current team (new) OR match user ID (old).
      // Requires the contacts.manage capability (viewers are read-only). Own-scoped
      // members (coach) may only create a contact owned by themselves
      // (uid in assigned_coach_ids, or createdBy == uid) so it lands in their own book.
      allow create: if (request.resource.data.teamId == getUserCurrentTeam()
                          && isTeamMember(request.resource.data.teamId)
                          && hasTeamCapability(request.resource.data.teamId, 'contacts.manage')
                          && (callerIsAllScoped(request.resource.data.teamId)
                              || callerOwnsContact(request.resource)))
                       || isTeacher(request.resource)
                       || hasRole('admin');

      // Read/Update/Delete: Must be member of contact's team (own-scope for a coach)
      // OR old teacher-based access.
      allow read: if canAccessContact(resource)
                   || hasRole('admin')
                   || isSelfContact(contactId)
                   || sharesContactEmail(resource)
                   || isOrgAdminOfTeam(resource.data.teamId);
      // Belonging now lives in the affiliations subcollection (governed by the
      // catch-all below + the upsertAffiliation callable's org-lock guard), so the
      // old org_membership_* field gate is gone.
      //
      // `coaching_open_count` / `coaching_overdue_count` / `last_checkin_at`
      // (trackGoals / trackPerformanceCheckins, coaching/) and `alerts_count`
      // (trackContactAlerts, contacts/) are denormalized by Cloud Functions
      // ONLY — no branch above may forge them, same guard shape as `tags` on
      // a session below.
      allow update: if (canWriteContact(resource)
                       || hasRole('admin')
                       || (isSelfContact(contactId)
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weight', 'last_seen_at', 'mobile_app'])))
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coaching_open_count', 'coaching_overdue_count', 'last_checkin_at', 'alerts_count', 'notes_count']);
      allow delete: if (canAccessContact(resource)
                          && hasTeamCapability(resource.data.teamId, 'contacts.delete'))
                       || hasRole('admin');

      // Subscription history subcollection — the ONLY store of a contact's plan
      // PERIODS. `onContactSubscriptionChange` (packages/functions/src/sync/) is
      // the SINGLE writer of periods: it reconciles what a contact currently
      // HOLDS against this subcollection by set difference, and a client write
      // racing that reconciliation could open/close a row the trigger doesn't
      // know about, silently forking the two plans' periods apart. `delete` stays
      // open — a row is EVIDENCE that a plan was held, not a scarce resource, and
      // the contact detail page's per-row trash button
      // (`contacts/[id]/page.tsx`) genuinely uses it to remove a bad record; that
      // is not a period-integrity risk the way create/update would be.
      match /subscription_history/{historyId} {
        allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin');
        allow create, update: if false;
        allow delete:
          if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
          || hasRole('admin');
      }

      // Goals subcollection
      // Coaches (team members) have full CRUD.
      // Students can create their OWN goals (created_by must be 'student'), and
      // for a goal they created, update or delete the WHOLE document — not
      // merely the status field, despite what an earlier version of this
      // comment claimed.
      //
      // A member ALSO gets one narrow arm over a COACH-assigned TASK (not a
      // goal): the core coaching loop is "coach assigns homework, member ticks
      // it off, coach sees completion rate" (docs/product-strategy.md), and
      // every task a member receives today is coach-created — neither mobile
      // nor Space offer task authoring. That arm may change ONLY `status` +
      // `completed_at`, and only between 'open' and 'achieved' on BOTH ends —
      // a task is boolean homework (see `Goal.type` in
      // packages/shared/src/types/goal.ts) — so a member can tick a coach's
      // task done or undo that, but can never set 'abandoned' on it, nor touch
      // its title/description/categories/target_date/parent_goal_id. A GOAL
      // (`type == 'goal'`, or the field absent on a legacy doc) is NOT covered
      // by this arm: a member evaluating a coach's goal records a score and a
      // note through an evaluation (see the evaluations match below) but never
      // drives the goal's own status directly, even as its evaluator — both
      // the mobile and Space clients are built to that rule, so no UI ever
      // attempts the write this denies.
      //
      // `created_by` is IMMUTABLE for everyone, staff included — it records who
      // authored the goal, which is a historical fact rather than a setting. It
      // is also load-bearing twice over in the arms above: the member's own-goal
      // arm keys on it, and so does the coach-task arm. A member could otherwise
      // flip their own goal to `created_by: 'coach'` and have the UI render a
      // "set by your coach" chip on something they wrote themselves. (Only a
      // CHANGED value counts — `affectedKeys()` is a diff, so a client echoing
      // the field back unchanged is unaffected.)
      //
      // `latest_score` / `last_evaluated_at` / `overdue_at` are denormalized by
      // Cloud Functions ONLY (trackGoalEvaluations, trackGoals, and the daily
      // stampOverdueGoals job all write via the Admin SDK, which bypasses these
      // rules entirely) — no branch above, including the task arm, may change
      // them; `affectedKeys().hasOnly(['status', 'completed_at'])` already
      // excludes them from that arm, and the trailing guard below closes it
      // for every other branch too, same shape as `tags` on a session below.
      match /goals/{goalId} {
        allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId);
        allow create: if (canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && request.resource.data.created_by == 'student'))
                       && !request.resource.data.keys().hasAny(['latest_score', 'last_evaluated_at', 'overdue_at']);
        allow update: if (canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && resource.data.created_by == 'student')
                         || (isSelfContact(contactId)
                             && resource.data.get('type', 'goal') == 'task'
                             && resource.data.created_by == 'coach'
                             && resource.data.status in ['open', 'achieved']
                             && request.resource.data.status in ['open', 'achieved']
                             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completed_at'])))
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['latest_score', 'last_evaluated_at', 'overdue_at', 'created_by']);
        allow delete: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && resource.data.created_by == 'student');

        // Goal evaluations subcollection
        // Coaches have full CRUD. Students can create and edit their own evaluations.
        match /evaluations/{evalId} {
          allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                        || hasRole('admin')
                        || isSelfContact(contactId);
          allow create: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                           || hasRole('admin')
                           || (isSelfContact(contactId) && request.resource.data.evaluated_by == 'student');
          allow update: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                           || hasRole('admin')
                           || (isSelfContact(contactId) && resource.data.evaluated_by == 'student');
          allow delete: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                           || hasRole('admin');
        }
      }

      // Performance check-ins subcollection
      // Coaches have full CRUD. Students can create and update their own check-ins (filled_by must be 'student').
      match /performance_checkins/{checkinId} {
        allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId);
        allow create: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && request.resource.data.filled_by == 'student');
        allow update: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin')
                         || (isSelfContact(contactId) && resource.data.filled_by == 'student');
        allow delete: if canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                         || hasRole('admin');
      }

      // Lesson-credit grants — balances must be tamper-proof: readable by the
      // studio + the contact themself, written ONLY by Cloud Functions (the
      // Connect webhook, the grantCredits callable, bookSession's spend and
      // cancelBooking's refund — all bypass rules). Matched explicitly BEFORE
      // the generic child-collection rule below, which excludes this name from
      // its write grant (rules are additive across overlapping matches).
      match /credit_grants/{grantId} {
        allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId)
                      || sharesContactEmail(get(/databases/$(database)/documents/contacts/$(contactId)));
        allow write: if false;
      }

      // Usage-limit window counters ("3 classes per week") — Cloud Functions
      // only, same as credit_grants: a client-writable counter would let a
      // member reset their own allowance. Readable like the grants so the
      // portal can show "2 of 3 left this week".
      match /usage_windows/{windowId} {
        allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId)
                      || sharesContactEmail(get(/databases/$(database)/documents/contacts/$(contactId)));
        allow write: if false;
      }

      // Completed purchases of a subscription price — the ledger behind
      // "this intro can be bought once per person". Cloud Functions only, for
      // the same reason as the two above: a client-writable row would let a
      // member delete her own purchase and take a once-per-person offer twice.
      // Readable by the contact so the shop can mark an offer already taken.
      match /plan_purchases/{purchaseId} {
        allow read: if canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                      || hasRole('admin')
                      || isSelfContact(contactId)
                      || sharesContactEmail(get(/databases/$(database)/documents/contacts/$(contactId)));
        allow write: if false;
      }

      // Push notification tokens — device registrations for the (not yet
      // built) mobile push feature. See `PushToken`
      // (packages/shared/src/types/push.ts) for why the doc id IS the token.
      //
      // UNLIKE every other subcollection here, staff get NO arm at all — not
      // `canAccessContact`, not `hasRole('admin')`, nothing. A studio has no
      // legitimate reason to enumerate which devices a member's account is
      // signed into, and the Cloud Function that will eventually SEND
      // (`sendPush`, packages/functions/src/push/) runs on the Admin SDK,
      // which bypasses these rules entirely — so no staff/admin arm is needed
      // to make sending work either. Only the contact's own session
      // (`isSelfContact`) may create, update, delete or read its own tokens.
      match /push_tokens/{tokenId} {
        allow read, write: if isSelfContact(contactId);
      }

      // Rules apply to all other child collections. Single-segment on purpose:
      // the only deeper paths (goals/{id}/evaluations) are matched explicitly
      // above, and a recursive wildcard here could not exclude credit_grants /
      // usage_windows / plan_purchases from its write grant.
      match /{subcollection}/{docId} {
        // `contact_notes` is the studio's PRIVATE staff commentary about a contact
        // (behavioural / health / financial), authored in the staff-only Notes tab
        // and by the automation engine — never a member-facing surface. So the
        // contact-facing read predicates (isSelfContact / sharesContactEmail) are
        // withheld for it: a member must not read the confidential notes the studio
        // keeps about them. Staff (canAccessContact) and admins still read it. Every
        // OTHER subcollection keeps the self-read (a contact reads their own
        // bookings, goals, credit balance, …). Rules are additive, so this
        // exclusion has to live on the catch-all itself — a separate staff-only
        // match would be OR'd with this grant and change nothing.
        //
        // `push_tokens` is excluded from the WHOLE grant, not just the
        // self-read branch — this catch-all's `canAccessContact` / `hasRole('admin')`
        // arm must not hand staff a blanket read either, same additive-rules trap,
        // and the explicit `/push_tokens/{tokenId}` match above is the ONLY grant
        // for it (isSelfContact, and nothing else).
        allow read: if subcollection != 'push_tokens'
                      && (canAccessContact(get(/databases/$(database)/documents/contacts/$(contactId)))
                          || hasRole('admin')
                          || (subcollection != 'contact_notes'
                              && (isSelfContact(contactId)
                                  || sharesContactEmail(get(/databases/$(database)/documents/contacts/$(contactId))))));
        // `goals` is ALSO excluded — not because it is function-only like the two
        // below, but because rules are additive: this catch-all's blanket grant
        // (no field restriction at all) would otherwise override the field-lock
        // the explicit `/goals/{goalId}` match above places on `latest_score` /
        // `last_evaluated_at` / `overdue_at` for a canWriteContact staff member —
        // a more specific match does NOT take precedence in Firestore rules, so
        // the exclusion has to live here, same reasoning as `contact_notes` above.
        // Every other permission goals grants (full staff CRUD, admin) is already
        // duplicated on that explicit match; nothing is lost by removing it here.
        //
        // `subscription_history` is excluded for the SAME reason: rules are
        // additive, so without this exclusion the catch-all's blanket
        // `canWriteContact` grant would override the explicit
        // `/subscription_history/{historyId}` match's `allow create, update: if
        // false` — a staff member could create/update a period row directly and
        // race `onContactSubscriptionChange`'s reconciliation. `delete` is
        // unaffected either way (both matches allow it for staff).
        //
        // `push_tokens` joins this list for the reason stated on the explicit
        // match above and on the read grant just above: staff (even with
        // `contacts.manage`) get no write here either — this is the trap this
        // comment block warns about on every other entry, so a token
        // subcollection is called out by name rather than assumed covered.
        allow write: if subcollection != 'credit_grants'
                      && subcollection != 'usage_windows'
                      && subcollection != 'plan_purchases'
                      && subcollection != 'goals'
                      && subcollection != 'subscription_history'
                      && subcollection != 'push_tokens'
                      && (canWriteContact(get(/databases/$(database)/documents/contacts/$(contactId))) || hasRole('admin'));
      }

    }

    // Checkins — created and updated exclusively via addEventCheckin Cloud Function (admin SDK).
    // Direct client creates are denied to prevent bypassing server-side confirmation logic.
    // The manual confirm/unconfirm toggle (is_completed) is the only direct client write allowed,
    // and only for team managers or owners.
    //
    // THE FIELD CONSTRAINT IS WHAT MAKES THAT COMMENT TRUE. It used to be prose
    // only: the rule authorised the caller and then let them write ANY field of
    // the document. `teamId` IS the tenant boundary here — every arm below
    // dereferences it, and `tenantData.ts` matches this collection by it — so a
    // manager could move one of their own rows into ANOTHER studio by rewriting
    // that one field, landing a document (and, through the checkins trigger, an
    // activity-log entry) in a tenant they have no access to. Rewriting
    // `event.id` was the same trick against the counters: `trackEventAttendees`
    // moves `completed_checkins_count` to whatever event the row now names and
    // never decrements the one it left.
    //
    // So the allow-list is exactly what the roster's toggle writes, and nothing
    // else. Widening it is a security decision, not a convenience: anything a
    // client needs to change beyond this belongs in `addEventCheckin`, which
    // runs the authorization decision in `events/checkinAuthorization.ts`. The
    // Admin SDK ignores rules, so the callable is unaffected by this.
    match /checkins/{checkin} {
      allow create: if false; // addEventCheckin Cloud Function only
      allow update: if (hasTeamRole(resource.data.teamId, 'manager') || hasRole('admin')
                        || isOrgAdminOfTeam(resource.data.teamId))
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['is_completed', 'updated_at']);
      allow delete: if hasTeamRole(resource.data.teamId, 'manager') || hasRole('admin')
                       || isOrgAdminOfTeam(resource.data.teamId);
      allow read:   if belongsToUserTeam(resource) || hasRole('admin')
                       || isOrgAdminOfTeam(resource.data.teamId);
    }

    // Events — team-scoped or org-scoped
    // Org events (scope=='org') are visible to all teams in that org.
    match /events/{event} {
      allow create: if (belongsToUserTeam(request.resource)
                          && hasTeamCapability(request.resource.data.teamId, 'events.manage'))
                    || (isAuthed() && request.resource.data.scope == 'org'
                        && request.resource.data.orgId != null
                        && hasOrgRole(request.resource.data.orgId, 'org_admin'))
                    || hasRole('admin');
      allow read:   if belongsToUserTeam(resource)
                    || (isAuthed() && resource.data.scope == 'org'
                        && resource.data.orgId != null
                        && isOrgMember(resource.data.orgId))
                    || (resource.data.scope == 'org'
                        && resource.data.orgId != null
                        && currentTeamInOrg(resource.data.orgId))
                    || hasRole('admin');
      allow update: if (belongsToUserTeam(resource)
                          && hasTeamCapability(resource.data.teamId, 'events.manage'))
                    || (isAuthed() && resource.data.scope == 'org'
                        && resource.data.orgId != null
                        && hasOrgRole(resource.data.orgId, 'org_admin'))
                    || hasRole('admin');
      allow delete: if hasRole('admin');

      // Per-event categories (used by fighting_cup and any plugin with hasCategories)
      match /categories/{category} {
        allow read:  if belongsToUserTeam(get(/databases/$(database)/documents/events/$(event)))
                     || isOrgAdminOfEvent(event)
                     || currentTeamInOrgOfEvent(event);
        allow write: if belongsToUserTeam(get(/databases/$(database)/documents/events/$(event)))
                     || isOrgAdminOfEvent(event)
                     || hasRole('admin');
      }

      // RSVP attendees — written by Cloud Functions
      match /attendees/{attendee} {
        allow read:  if belongsToUserTeam(get(/databases/$(database)/documents/events/$(event)))
                     || isOrgAdminOfEvent(event)
                     || currentTeamInOrgOfEvent(event);
        allow write: if false;
      }

      // Program items — the event's agenda (multi-day, multi-track).
      // Tenant fields (teamId/orgId/scope) are DENORMALISED onto every item.
      // Create validates that stamp against the parent event once; read, update
      // and delete then trust it, so the hot paths need no get() on the parent
      // and org-scoped events (whose teamId is null) work by construction.
      // Deliberately avoids belongsToUserTeam(), which reads a legacy `teacher`
      // field these documents do not carry.
      match /program_items/{item} {
        function itemTeam() { return resource.data.get('teamId', null); }
        function itemOrg()  { return resource.data.get('orgId', null); }

        allow read: if isAuthed() && (
                         (itemTeam() != null
                            && (isTeamMember(itemTeam()) || isOrgAdminOfTeam(itemTeam())))
                         // An org event's programme is visible to the whole org:
                         // to org members directly, and to any studio whose
                         // current team belongs to that org (mirrors org_places
                         // and the parent event's own read rule).
                      || (itemOrg() != null && isOrgMember(itemOrg()))
                      || (itemOrg() != null && currentTeamInOrg(itemOrg()))
                      || hasRole('admin'));

        // CREATE is the one operation that pays for a get() on the parent: the
        // denormalised stamp is only trustworthy downstream if it was proven to
        // match the event it is filed under. Every later operation reads the
        // already-validated stamp, so the common path stays get()-free.
        allow create: if hasRole('admin')
                      || (isAuthed()
                          && tenantMatchesEvent(event, request.resource.data)
                          && ((request.resource.data.get('teamId', null) != null
                                 && hasTeamCapability(request.resource.data.get('teamId', ''), 'events.manage'))
                              || (request.resource.data.get('orgId', null) != null
                                 && hasOrgRole(request.resource.data.get('orgId', ''), 'org_admin'))));

        // The tenant stamp is immutable — it cannot be re-pointed at another
        // studio after the fact.
        allow update: if hasRole('admin')
                      || (isAuthed()
                          && request.resource.data.get('teamId', null) == itemTeam()
                          && request.resource.data.get('orgId', null) == itemOrg()
                          && ((itemTeam() != null && hasTeamCapability(itemTeam(), 'events.manage'))
                              || (itemOrg() != null && hasOrgRole(itemOrg(), 'org_admin'))));

        allow delete: if hasRole('admin')
                      || (isAuthed()
                          && ((itemTeam() != null && hasTeamCapability(itemTeam(), 'events.manage'))
                              || (itemOrg() != null && hasOrgRole(itemOrg(), 'org_admin'))));
      }

      // Invitations — written and read exclusively by Cloud Functions (admin SDK).
      // The bio-link uses getEventInvitationDetails() callable, not direct client reads.
      match /invitations/{invitation} {
        allow read:  if false;
        allow write: if false;
      }
    }

    // Legacy global categories (HMD-only — read-only going forward)
    match /categories/{category} {
      allow read;
    }

    // Sessions
    match /sessions/{session} {
      // Create: Must belong to user's team and cannot directly set location/tags.
      // Requires the schedule.manage capability (viewers are read-only). Own-scoped
      // members (coach) may only create sessions they run (providerId /
      // createdBy == uid) — they manage their own schedule.
    	allow create: if (belongsToUserTeam(request.resource) || hasRole('admin'))
                       && (hasRole('admin')
                           || (hasTeamCapability(request.resource.data.teamId, 'schedule.manage')
                               && (callerIsAllScoped(request.resource.data.teamId)
                                   || callerOwnsSession(request.resource))))
                       // 'tags' stays server-managed. 'location' was removed from this
                       // guard 2026-07: the session form legitimately writes free-text
                       // location as the fallback for online/ad-hoc sessions (see
                       // Session.location), and the guard denied EVERY create from the
                       // dialog — silently, which is how it went unnoticed. Recurring
                       // creation bypassed it via the callable (admin SDK).
                       && (!request.resource.data.keys().hasAny(['tags']));

      // Update: Requires schedule.manage (own-scope for a coach); cannot update location/tags directly
      allow update: if (belongsToUserTeam(resource) || hasRole('admin'))
                       && (hasRole('admin')
                           || (hasTeamCapability(resource.data.teamId, 'schedule.manage')
                               && (callerIsAllScoped(resource.data.teamId)
                                   || callerOwnsSession(resource))))
                       && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tags']));

      // Delete: Requires schedule.manage (own-scope for a coach); session must not have location, tags, or participants
      allow delete: if (belongsToUserTeam(resource) || hasRole('admin')) &&
      (hasRole('admin') || (hasTeamCapability(resource.data.teamId, 'schedule.manage') && (callerIsAllScoped(resource.data.teamId) || callerOwnsSession(resource)))) &&
      (
        (!resource.data.keys().hasAll(['location']) || resource.data.location == null) &&
        (!resource.data.keys().hasAll(['tags']) || resource.data.tags == null) &&
        (!resource.data.keys().hasAll(['participants_count']) || resource.data.participants_count == 0)
      );

      // Read: Must be team member. Coaches read the WHOLE calendar (schedule.view.all)
      // to avoid clashes, so reads are intentionally not own-scoped.
      allow read: if belongsToUserTeam(resource) || hasRole('admin');

      // participants sub-collection
      match /participants/{participantId} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session))) || hasRole('admin');
        allow write: if (belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session)))
                          && hasTeamCapability(get(/databases/$(database)/documents/sessions/$(session)).data.teamId, 'schedule.manage'))
                       || hasRole('admin');
        // Allow contacts to read their own participant doc (student app)
        allow read: if isSelfContact(participantId);
      }

      // bookings sub-collection (bio-link reservations, separate from confirmed attendance)
      match /bookings/{bookingId} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session))) || hasRole('admin');
        allow write: if (belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session)))
                          && hasTeamCapability(get(/databases/$(database)/documents/sessions/$(session)).data.teamId, 'schedule.manage'))
                       || hasRole('admin');
        // Allow contacts to read their own booking doc (student app)
        allow read: if isSelfContact(bookingId);
      }

      // waitlist sub-collection (the queue for a full class; doc id = contactId)
      match /waitlist/{entryId} {
        allow read: if belongsToUserTeam(get(/databases/$(database)/documents/sessions/$(session))) || hasRole('admin');
        // A contact reads their own place in the line.
        allow read: if isSelfContact(entryId);
        // NO client writes, deliberately unlike the bookings block above: every
        // transition (join, offer, claim, leave, expire) moves a seat count or a
        // claim hold inside a transaction. A schedule.manage holder writing an
        // entry directly would bypass that and re-open the oversell.
        allow write: if false;
      }

      // public_profile sub-collection (for trial booking)
      match /public_profile/{publicProfileId} {
        allow read;  // Public read access
        allow write: if false;  // Only cloud functions can write
      }
    }

    // Availability Templates (recurring patterns defining a provider's bookable time)
    match /availability/{templateId} {
      // GET: resource.data is available
      allow get: if isAuthed() && isTeamMember(resource.data.teamId);
      // LIST: resource.data is not reliably available for query rules — use currentTeam
      allow list: if isAuthed() && isTeamMember(getUserCurrentTeam());
      allow create: if isAuthed() && hasTeamRole(request.resource.data.teamId, 'manager');
      allow update: if isAuthed() && hasTeamRole(resource.data.teamId, 'manager');
      allow delete: if false; // soft delete only
    }

    // Provider time-off that overrides availability templates. Managers CRUD their
    // team's exceptions; unlike templates these HARD-delete (removing time off).
    // listAvailability reads them server-side (Admin SDK) to subtract busy time.
    match /availability_exceptions/{exceptionId} {
      allow get: if isAuthed() && isTeamMember(resource.data.teamId);
      allow list: if isAuthed() && isTeamMember(getUserCurrentTeam());
      allow create: if isAuthed() && hasTeamRole(request.resource.data.teamId, 'manager');
      allow update: if isAuthed() && hasTeamRole(resource.data.teamId, 'manager');
      allow delete: if isAuthed() && hasTeamRole(resource.data.teamId, 'manager');
    }

    // Coach Slots collection removed — appointment sessions now live in `sessions`
    // with activityType === 'appointment'. Public access via sessions/{id}/public_profile.

    // Session Series (recurring sessions)
    match /session_series/{seriesId} {
      allow create: if belongsToUserTeam(request.resource) || hasRole('admin');
      allow read: if belongsToUserTeam(resource) || hasRole('admin');
      allow update: if belongsToUserTeam(resource) || hasRole('admin');
      allow delete: if belongsToUserTeam(resource) || hasRole('admin');
    }

    // Series teardown jobs — the progress record for a background "delete this
    // and all following". The studio READS its own to follow a run (the client
    // holds the jobId the callable returned, so this is a get, never a list).
    //
    // Every client write is denied. The document is the job's own state machine:
    // a client that could edit `status` or `processed` could park a job as
    // finished while a worker was still deleting, or restart a terminal one.
    // Only the Admin SDK writes it — cancelSession mints it, runSeriesTeardown
    // advances it.
    match /session_series_jobs/{jobId} {
      allow read:  if belongsToUserTeam(resource) || hasRole('admin');
      allow write: if false;
    }

    // Activities (class types)
    match /activities/{activityId} {
      // Writes require the activities.manage capability (viewers are read-only).
      allow create: if (belongsToUserTeam(request.resource)
                          && hasTeamCapability(request.resource.data.teamId, 'activities.manage'))
                       || hasRole('admin');
      allow read: if belongsToUserTeam(resource) || hasRole('admin');
      allow update: if (belongsToUserTeam(resource)
                          && hasTeamCapability(resource.data.teamId, 'activities.manage'))
                       || hasRole('admin');
      allow delete: if (belongsToUserTeam(resource)
                          && hasTeamCapability(resource.data.teamId, 'activities.manage'))
                       || hasRole('admin');

      // public_profile sub-collection (for trial booking)
      match /public_profile/{publicProfileId} {
        allow read;  // Public read access
        allow write: if false;  // Only cloud functions can write
      }
    }

    // ----------------------------------------------
    // Group queries
    // ----------------------------------------------

    // contact_weekly_reports
    match /{path=**}/contact_weekly_reports/{contactWeeklyReportId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
    }

    // contact_alerts
    match /{path=**}/contact_alerts/{contactAlertId} {
      allow read: if request.auth != null && (
        (resource.data.teamId != null && isTeamMember(resource.data.teamId)) ||
        isTeacher(get(/databases/$(database)/documents/contacts/$(resource.data.contact))) ||
        hasRole('admin')
      );
    }

    // team_alerts (collection group for team-level alerts)
    match /{path=**}/team_alerts/{teamAlertId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
    }

    // bookings (collection group for dashboard heatmap query)
    match /{path=**}/bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
    }

    // affiliations (collection group) — THE STUDIO'S ROSTER, AND THE ISSUER'S.
    //
    // Both Affiliations pages ask the same shape and NEITHER worked:
    //   collectionGroup('affiliations').where('teamId','==',myTeam)      (studio)
    //   collectionGroup('affiliations').where('org_id','==',orgId)       (org)
    // The nested `contacts/{id}/{subcollection}/{docId}` catch-all cannot serve
    // either, for the reason spelled out on the `purchases` block below: a
    // collection-group read is matched ONLY by a `{path=**}` statement. So every
    // status on both pages came back empty — a permission denial wearing the
    // costume of a roster where nobody holds anything.
    //
    // ── THE STUDIO'S ARM ────────────────────────────────────────────────────
    //
    // `canAccessContact` minus its own-scope branch, which is the most this
    // shape can honestly express: that branch reads `assigned_coach_ids` off the
    // CONTACT, and a `{path=**}` match binds no contact id to `get()` with. So
    // an own-scoped coach is excluded here by `callerIsAllScoped` rather than
    // silently handed a list of contacts that are not in their book. They lose
    // nothing they had — today nobody can run this query at all — and the
    // per-document nested rule still gives a coach their own contacts' rows.
    //
    // The `getUserCurrentTeam()` pin is kept for the same reason: it is what the
    // nested rule requires, and dropping it here would grant a query shape over
    // documents the caller cannot read one at a time.
    //
    // ── THE ISSUER'S ARM ────────────────────────────────────────────────────
    //
    // An organisation could not read the licences it had issued itself. It reads
    // `org_id` off the affiliation, so it admits exactly the rows this
    // organisation granted — never a studio's own internal club membership
    // (`issuer: 'team'`) and never a governing body the studio merely tracks
    // (`issuer: 'external'`), both of which live in this same subcollection and
    // are nobody's business but the studio's. `org_id` is set only when
    // `issuer == 'org'`, so naming it is the whole check.
    //
    // Reachable PII is unchanged: `contacts/{contactId}` already admits
    // `isOrgAdminOfTeam` for read, so an org admin can already see the person.
    // This adds the fact the organisation itself recorded about them.
    //
    // READ ONLY, and writes are untouched: they stay with the nested catch-all
    // and the `upsertAffiliation` callable (Admin SDK), which is where the org's
    // affiliation lock is applied.
    match /{path=**}/affiliations/{affiliationId} {
      allow read: if request.auth != null && (
        (resource.data.get('teamId', null) != null
          && resource.data.teamId == getUserCurrentTeam()
          && isTeamMember(resource.data.teamId)
          && callerIsAllScoped(resource.data.teamId))
        || isOrgAdminOfOrg(resource.data.get('org_id', null))
      );
    }

    // waitlist (collection group)
    //
    // NO client reads this way today, deliberately named so nobody infers one:
    // the day sheet and the session detail page each read ONE session's queue
    // through the nested match above, and every collection-group query on
    // `waitlist` in this repo runs in a callable over the Admin SDK, which
    // bypasses rules entirely. This block is a defensive team-scoping grant for a
    // future client-side collection-group read (the shape `listMyWaitlist`
    // exists to avoid, since isSelfContact authorises a get and not a list). It
    // widens nothing: a team member can already read every one of these
    // documents individually, so it grants a query shape, not data.
    match /{path=**}/waitlist/{entryId} {
      allow read: if request.auth != null && (
        resource.data.teamId != null && isTeamMember(resource.data.teamId)
      );
      allow write: if false;  // callables only — see the nested block above
    }

    // purchases (collection group) — a contact reading their OWN course entitlements.
    //
    // What this authorises, precisely: the query the Space ("My courses") and the
    // shop ("Open" instead of "Buy") both issue —
    //   collectionGroup('purchases').where('contactId','==',me).where('teamId','==',myTeam)
    // The nested courses/{courseId}/purchases block (further down, under "Online
    // Courses plugin") cannot serve it: a collection-group read is matched only
    // by a `{path=**}` statement.
    //
    // A LIST is authorised from the QUERY, not from the documents it would
    // return. Firestore admits the query only if its own constraints prove that
    // every matching document satisfies the condition below, and both operands
    // here are pinned to the caller's token — so BOTH `where` clauses are
    // mandatory, and naming another contact, another team, or dropping either
    // clause fails the whole query rather than silently filtering it. Staff read
    // these documents through the nested block, one at a time.
    //
    // Verified 2026-08-16 against the emulator with a real contact-session token
    // (uid `contact:{id}`, claims contactId/teamId/sessionExpires) over the
    // Firestore REST API: the scoped query returns the caller's own row, while
    // naming another contact, naming another team, or dropping either clause is
    // refused. packages/functions/src/connect/coursePurchaseAccess.test.ts fails
    // if this block or either of its two constraints goes missing.
    match /{path=**}/purchases/{purchaseId} {
      allow list: if request.auth != null
                  && request.auth.token.contactId != null
                  && resource.data.contactId == request.auth.token.contactId
                  && isContactOfTeam(resource.data.teamId);
      allow write: if false;  // Connect webhook (Admin SDK) only
    }

    // public_profile (collection group for trial booking)
    match /{path=**}/public_profile/{publicProfileId} {
      allow read;  // Public read access for trial booking
      allow write: if false;  // Only cloud functions can write
    }

    // team_members (collection group) — "WHICH STUDIOS AM I IN?", and ONLY that.
    //
    // THIS RULE NEVER WORKED, and the feature it gates never ran. `useMyTeams`
    // (the studio switcher's only query) failed with permission-denied for
    // every user, always. Nobody noticed because the switcher hides its list
    // for anyone in a single studio and no seeded account was in two — so an
    // empty result and a correct result looked identical (found 2026-08-27,
    // when a two-studio login finally existed).
    //
    // It failed twice, for two different reasons, and both are worth keeping:
    //
    //   1. It read `resource.data.teamId != null`. Dot access on an unbound
    //      field THROWS rather than evaluating to null, and an evaluation error
    //      denies the WHOLE list — so the `!= null` guard could never run.
    //      `Property teamId is undefined on object. for 'list'`.
    //   2. With that fixed it still returned false, because it then called
    //      `isTeamMember(...)` — an `exists()` against a path built out of
    //      `resource.data`. A cross-document lookup keyed on the candidate
    //      document is not something a LIST rule can satisfy.
    //
    // The gate below needs neither. A membership document already NAMES its
    // owner, so "may I read this?" is answerable from the document alone, and
    // it is the same fact the query filters on (`where('userId','==',uid)`).
    //
    // It is also STRICTLY TIGHTER than what was intended: the old rule would
    // have let any member of a team enumerate that team's other membership
    // documents through the collection group. This lets a caller see only their
    // own. Reading the OTHER members of a team you belong to still works, at
    // the nested `teams/{teamId}/team_members` path, which is where that
    // question belongs.
    match /{path=**}/team_members/{memberId} {
      allow read: if request.auth != null
                  && resource.data.get('userId', null) == request.auth.uid;
      allow write: if false;  // Must go through specific team path
    }

    // team_invitations (collection group for invitation token queries)
    match /{path=**}/team_invitations/{invitationId} {
      allow read: if false;  // Only cloud functions can query by token
      allow write: if false;  // Only cloud functions can write
    }

    // ----------------------------------------------
    // Membership Signup (Public)
    // ----------------------------------------------

    // Verification codes - no direct client access
    // All operations handled via cloud functions
    match /verification_codes/{codeId} {
      allow read: if false;
      allow write: if false;
    }

    // Rate-limit counters (per-IP OTP sends, per-team shop registrations) -
    // function-written only (utils/rateLimit.ts)
    match /auth_code_attempts/{bucketId} {
      allow read: if false;
      allow write: if false;
    }
    match /shop_registration_attempts/{bucketId} {
      allow read: if false;
      allow write: if false;
    }
    // Per-IP claims of a completed Stripe Checkout Session (claimCheckoutSession)
    match /checkout_claim_attempts/{bucketId} {
      allow read: if false;
      allow write: if false;
    }

    // The `auth_tokens` collection and its deny-all block were removed 2026-07-17:
    // the mechanism was dead (no writer produced the shape its readers expected).
    // Contacts authenticate with their contact session; unmatched paths default to
    // deny, so no explicit block is needed. See docs/security-audit-2026-07.md.

    // Booking verification codes - for email-based authentication in bio-link
    // All operations handled via cloud functions
    match /booking_verification_codes/{codeId} {
      allow read: if false;
      allow write: if false;
    }

    // ----------------------------------------------
    // Referral System
    // ----------------------------------------------

    // Referral code lookup table — only cloud functions read/write
    match /referral_codes/{code} {
      allow read: if false;
      allow write: if false;
    }

    // Referral tracking — team members can read; only cloud functions write
    match /referrals/{referralId} {
      // Single document GET: resource.data is available, verify team membership directly
      allow get: if isAuthed() && (
        isTeamMember(resource.data.team_id) || hasRole('admin')
      );
      // Collection LIST: scoped to the caller's own team. Referencing
      // resource.data.team_id forces the client query to filter
      // `where('team_id','==', <team>)` and makes Firestore REJECT any unscoped
      // or cross-tenant list — the same shape the single-doc get() rule uses.
      // (Was `if isAuthed()`, which let any authenticated principal — a contact
      // session included — enumerate every studio's referral graph + reward
      // amounts; client-side filtering is not enforcement.)
      allow list: if isAuthed() && isTeamMember(resource.data.team_id);
      allow write: if false;
    }

    // ----------------------------------------------
    // Online Courses plugin (lightweight LMS)
    // Authoring (admin web): team members read, managers+ write.
    // Public consumption (Space web area): published courses are readable per their
    // accessRule tier — free (anyone), registered (signed-in contact of the team),
    // subscription (contact with an allowed subscription_type_id). See
    // canReadPublishedCourse(). The public course LIST is served from the
    // world-readable courses/{id}/public_profile/{id} summaries, never this collection.
    // ----------------------------------------------
    match /courses/{courseId} {
      // Single document GET: resource.data is available — staff OR public-by-tier.
      allow get: if (isAuthed() && isTeamMember(resource.data.teamId))
                 || canReadPublishedCourse(courseId, resource.data);
      // Collection LIST: only a member of the queried team. The rule references
      // resource.data.teamId, so Firestore requires the client query to be scoped
      // `where('teamId','==', <team>)` and rejects any unscoped / cross-tenant list.
      // The public Space lists via public_profile (collection group), never this.
      allow list: if isAuthed() && isMemberOfResourceTeam(resource);
      allow create: if hasTeamRole(request.resource.data.teamId, 'manager');
      allow update, delete: if hasTeamRole(resource.data.teamId, 'manager');

      // modules + lessons inherit the parent course's team + public access tier
      match /modules/{moduleId} {
        allow read: if (isAuthed()
            && isTeamMember(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId))
          || canReadPublishedCourse(courseId, get(/databases/$(database)/documents/courses/$(courseId)).data);
        allow write: if hasTeamRole(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId, 'manager');
      }
      match /lessons/{lessonId} {
        allow read: if (isAuthed()
            && isTeamMember(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId))
          || canReadPublishedCourse(courseId, get(/databases/$(database)/documents/courses/$(courseId)).data);
        allow write: if hasTeamRole(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId, 'manager');
      }

      // Lifetime purchase entitlements. Granted only by the Connect webhook (admin SDK);
      // clients never write.
      //
      // This block covers reads AT THIS PATH ONLY — a staff member of the owning
      // team, or the owning contact fetching their own entitlement document. It
      // does NOT cover the Space/shop `purchases` collection-group query: a
      // collection-group read is only ever matched by a `{path=**}` block, never
      // by a nested match, so that query needs the `{path=**}/purchases` block
      // in the "Group queries" section above. (This comment claimed the opposite until
      // 2026-08-16, and the query 403'd with "No matching allow statements" for
      // exactly as long as the claim stood.)
      //
      // The contact branch goes through `isContactOfTeam` for the same reason the
      // collection-group block does: `request.auth.token.contactId` on its own is
      // an identity, not a tenant boundary, and it carries no expiry. Checking it
      // alone let an EXPIRED contact session — and a session minted for a
      // different studio — fetch an entitlement document by id. Tightened
      // 2026-08-16; no client reads this path (both the Space and the shop go
      // through the collection group), and every server reader is the Admin SDK,
      // so the narrowing takes nothing away from anyone.
      match /purchases/{contactId} {
        allow read: if (isAuthed()
            && isTeamMember(get(/databases/$(database)/documents/courses/$(courseId)).data.teamId))
          || (isContactOfTeam(resource.data.teamId)
            && request.auth.token.contactId == resource.data.contactId);
        allow write: if false;
      }
    }

    // ----------------------------------------------
    // Custom Forms plugin — form builder + submissions backend
    // Authoring (admin web): team members read, managers+ write. The public form
    // page renders from the world-readable forms/{id}/public_profile/{id} summary
    // (collection group), never this collection. Submissions are written ONLY by
    // the submitForm Cloud Function (Admin SDK); team members read them back.
    // ----------------------------------------------
    match /forms/{formId} {
      allow get: if isAuthed() && isTeamMember(resource.data.teamId);
      // Collection LIST: only a member of the queried team. The rule references
      // resource.data.teamId, so Firestore requires the client query to be scoped
      // `where('teamId','==', <team>)` and rejects any unscoped / cross-tenant list.
      // The public form page reads via public_profile (collection group), never this.
      allow list: if isAuthed() && isMemberOfResourceTeam(resource);
      allow create: if hasTeamRole(request.resource.data.teamId, 'manager');
      allow update, delete: if hasTeamRole(resource.data.teamId, 'manager');

      // forms/{id}/public_profile/{id} is world-readable via the global
      // /{path=**}/public_profile rule (drives the public form page) — no block here.

      // Submissions: team members read; only the submitForm Cloud Function writes.
      match /submissions/{submissionId} {
        allow read: if isAuthed()
          && isTeamMember(get(/databases/$(database)/documents/forms/$(formId)).data.teamId);
        allow write: if false; // Cloud Functions only
      }
    }

    // ----------------------------------------------
    // Documents plugin — core operational documents (terms, privacy, regulations)
    // Authoring (admin web): team members read, managers+ write. The public
    // document page renders from the world-readable documents/{id}/public_profile/{id}
    // summary (collection group), never this collection.
    // ----------------------------------------------
    match /documents/{documentId} {
      allow get: if isAuthed() && isTeamMember(resource.data.teamId);
      // Collection LIST: only a member of the queried team. The rule references
      // resource.data.teamId, so Firestore requires the client query to be scoped
      // `where('teamId','==', <team>)` and rejects any unscoped / cross-tenant list.
      // The public document page reads via public_profile (collection group), never this.
      allow list: if isAuthed() && isMemberOfResourceTeam(resource);

      // Waiver documents are CALLABLE-ONLY, exactly as promo codes are. Their
      // content is somebody's evidence and their required-ness is an
      // authorization fact; neither may be a client write. createWaiver /
      // updateWaiver / publishDocumentVersion / setWaiverRequirement /
      // archiveWaiver are the only writers.
      //
      // CREATE CONSTRAINS THE PUBLISH STATE TOO, WHICH IT USED TO LEAVE FREE.
      // The clause below `kind` was the only one here, so `status`,
      // `current_version` and `min_valid_version` were client-writable at
      // creation on every kind — the one write that decides a document's whole
      // starting state was the one write that constrained none of it. That
      // breaks both invariants the update clause is built around: W3 says the
      // two version pointers are unwritable by any client on any kind, and W29
      // says a published document always has a version. A single client `setDoc`
      // could arrive at `status: 'published'` with no snapshot behind it, or —
      // worse — with a `current_version` pointing at a version document that
      // does not exist, which is the state the acceptance ledger's central
      // assumption (an acceptance names a version whose frozen text can be
      // served) has no defence against. `createDocument` in
      // apps/web/src/plugins/documents/hooks.ts already writes exactly this
      // shape — status 'draft', neither pointer present — so no legitimate
      // create changes.
      allow create: if hasTeamRole(request.resource.data.teamId, 'manager')
                    && request.resource.data.get('kind', 'other') != 'waiver'
                    && request.resource.data.get('status', 'draft') != 'published'
                    && request.resource.data.get('current_version', null) == null
                    && request.resource.data.get('min_valid_version', null) == null;

      // Publish state is minted by publishDocumentVersion only, on EVERY kind —
      // a client can never move current_version or the supersession floor, and
      // can never TRANSITION a document into 'published'.
      //
      // The status clause is what leaves exactly one publisher. Without it the
      // editor's old client status flip and the callable could both publish, and
      // only one of them mints the immutable snapshot every acceptance pins — so
      // a client-published document would sit at status 'published' with no
      // version, which is the state the backfill and the ledger verifier exist to
      // keep empty. Note it forbids the TRANSITION, not the value: an ordinary
      // edit to an already-published document carries status 'published' in
      // request.resource and is still allowed, and UNpublishing (back to draft or
      // archived) stays a client write.
      allow update: if hasTeamRole(resource.data.teamId, 'manager')
                    && resource.data.get('kind', 'other') != 'waiver'
                    && request.resource.data.get('kind', 'other') != 'waiver'
                    && request.resource.data.get('current_version', null) == resource.data.get('current_version', null)
                    && request.resource.data.get('min_valid_version', null) == resource.data.get('min_valid_version', null)
                    && (request.resource.data.get('status', 'draft') != 'published'
                        || resource.data.get('status', 'draft') == 'published');

      // A document that is published, or that has ever been published, cannot be
      // deleted — its text may be somebody's evidence. An unpublished draft
      // still can. BOTH clauses are needed: every document published before
      // waivers existed has current_version == null, so the version clause alone
      // would protect nothing that already carries acceptances, and the status
      // clause makes the narrowing independent of whether
      // scripts/backfill-document-versions.ts has run.
      //
      // AND THE KIND CLAUSE, WHICH THIS USED TO OMIT. Create and update already
      // excluded `kind == 'waiver'`; delete did not, so a manager could hard-
      // delete an UNPUBLISHED waiver from the client — and an unpublished waiver
      // is not an empty one. `recordSignupConsent` writes under documents/{id},
      // so a draft can already own acceptance events and signer rows; deleting
      // the parent leaves every one
      // of them addressable only by a path whose head is gone, which is precisely
      // the orphaned-ledger state the version and status clauses above exist to
      // prevent. Retiring a waiver is `archiveWaiver` — a callable that clears the
      // policy entry in the same transaction. There is deliberately no waiver
      // delete anywhere: the ledger outlives the document by design.
      allow delete: if hasTeamRole(resource.data.teamId, 'manager')
                    && resource.data.get('kind', 'other') != 'waiver'
                    && resource.data.status != 'published'
                    && resource.data.get('current_version', null) == null;

      // IMMUTABLE published snapshots. The one place the exact accepted text
      // lives, which is why an acceptance can store only its hash. The parent
      // get() costs one document read per rule evaluation and is used ONLY here,
      // because versions are listed rarely; the sibling subcollections below
      // match on their own denormalised teamId instead.
      match /versions/{versionId} {
        allow read: if isAuthed()
                    && isTeamMember(get(/databases/$(database)/documents/documents/$(documentId)).data.teamId);
        allow write: if false;
      }

      // APPEND-ONLY acceptance/revocation events, the ONE mutable signer row,
      // and the notice rows. All server-written: every public answer comes from
      // a callable, so a contact session never reads any of them directly.
      match /acceptances/{acceptanceId} {
        allow read:  if isAuthed() && isTeamMember(resource.data.teamId);
        allow write: if false;
      }
      // Declared with NO WRITER: the `notify` publish outcome is deferred to v2
      // and the model stayed so adding it is an addition rather than a
      // migration. See WaiverNoticeRow in @linyup/shared.
      match /notices/{noticeId} {
        allow read:  if isAuthed() && isTeamMember(resource.data.teamId);
        allow write: if false;
      }
      match /signers/{contactId} {
        allow read:  if isAuthed() && isTeamMember(resource.data.teamId);
        allow write: if false;
      }
      // documents/{id}/public_profile/{id} is world-readable via the global
      // /{path=**}/public_profile rule (drives the public document page + signup
      // consent links + website links) and written only by the sync — no block here.
    }

    // ----------------------------------------------
    // Website plugin — studio site builder
    // ----------------------------------------------

    // PRIVATE working copy. Keyed by teamId. Builder reads/writes the draft;
    // never exposed publicly. Managers and owners only.
    match /site_drafts/{teamId} {
      allow read, write: if hasTeamRole(teamId, 'manager');
    }

    // PUBLIC snapshot of a published site. Keyed by teamId. World-readable so
    // the public /site/[slug] route (and any future headless website app) can
    // render it. Written ONLY by the publishWebsite Cloud Function, which
    // whitelists fields — clients can never write restricted data here.
    match /site_published/{teamId} {
      allow read;            // fully public
      allow write: if false; // Cloud Functions only
    }

    // ----------------------------------------------
    // Organization website — org-level public site (mirrors the website plugin
    // above, keyed by orgId instead of teamId; see publishOrgWebsite / ../orgWebsite)
    // ----------------------------------------------

    // PRIVATE working copy. Keyed by orgId. Builder reads/writes the draft;
    // never exposed publicly. Org admins only.
    match /org_site_drafts/{orgId} {
      allow read, write: if hasOrgRole(orgId, 'org_admin');
    }

    // PUBLIC snapshot of a published org site. Keyed by orgId. World-readable so
    // the public org site route can render it. Written ONLY by the
    // publishOrgWebsite Cloud Function, which whitelists fields — clients can
    // never write restricted data here.
    match /org_site_published/{orgId} {
      allow read;            // fully public
      allow write: if false; // Cloud Functions only
    }

    // Standalone embed widgets. Keyed by teamId. World-readable so the public
    // /embed/[slug]/[widgetId] route can render a widget without a published site.
    // Authored directly by managers (the widget config IS the public config — no
    // private draft to sanitise), so client write is allowed for the team's own doc.
    match /embed_widgets/{teamId} {
      allow read;            // fully public
      allow write: if hasTeamRole(teamId, 'manager')
                   && request.resource.data.teamId == teamId;
    }

    // ----------------------------------------------
    // SaaS Subscriptions (Lineup-specific)
    // Billing state managed exclusively by Cloud Functions (Stripe webhook handler)
    // entity_id may be a teamId or an orgId depending on entity_type
    // ----------------------------------------------
    match /saas_subscriptions/{entityId} {
      allow read: if (isTeamMember(entityId) && hasTeamRole(entityId, 'owner'))
                  || (isOrgMember(entityId) && hasOrgRole(entityId, 'org_admin'));
      allow write: if false; // Cloud Functions only
    }

    // Rate-limit log written by createCheckoutSession Cloud Function
    match /saas_checkout_attempts/{docId} {
      allow read:  if false;
      allow write: if false; // Cloud Function only
    }

    // ----------------------------------------------
    // Stripe Connect (member → studio payments)
    // ----------------------------------------------
    // Connected-account state, keyed by Stripe account id (acct_...). Written only
    // by Cloud Functions; managers/owners of the owning team can read their own.
    match /connect_accounts/{accountId} {
      allow read: if resource.data.teamId != null
                  && (hasTeamRole(resource.data.teamId, 'manager') || hasTeamRole(resource.data.teamId, 'owner'));
      allow write: if false; // Cloud Functions only
    }

    // Webhook idempotency markers (doc id = Stripe event id). Functions only.
    match /connect_webhook_events/{eventId} {
      allow read, write: if false;
    }

    // ----------------------------------------------
    // Organizations (multi-team tier)
    // ----------------------------------------------
    match /organizations/{orgId} {
      // A MEMBER STUDIO reads this too, and the asymmetry that kept it out was an
      // oversight rather than a decision: every org SUBcollection below —
      // org_places, affiliation_types, org_program_templates, installed_plugins —
      // already carries `|| currentTeamInOrg(orgId)`, while the settings a studio
      // most needs live on the ROOT: `ranking_systems`, `affiliation_term`,
      // `lock_affiliation`.
      //
      // The consequence was silent and total: `useRankingSystems` resolves an
      // org-managed studio's belts from exactly this document, so the read was
      // denied and the studio fell back to its own (empty) list — no belts on the
      // contact page, none in the exam form, none in the filter. Every migrated
      // HMD studio would have been in that state.
      //
      // READ only. Writing stays `hasOrgRole(orgId, 'org_admin')` below: a studio
      // reads the organisation's standards, it does not set them.
      allow read: if isOrgMember(orgId) || currentTeamInOrg(orgId);

      // GOVERNANCE IS NOT THE ORG ADMIN'S TO WRITE, exactly as it is not the team
      // owner's — and this rule was a bare `hasOrgRole(orgId, 'org_admin')` while
      // the team rule beside it carried `tenantGovernanceUnchanged()`.
      //
      // Becoming an org_admin is self-service: `createOrganization` checks only
      // that the caller is signed in, then writes them an `org_members` row with
      // that role. So any user could create an organisation and then set
      // `flags.comped`, `plan`, `plan_status` and `trial_ends_at` on it freely —
      // a permanent top tier that no sweep can lapse (`tenantExemptFromTrialSweep`
      // reads exactly that flag), and, once the platform-fee waiver reads it, no
      // Linyup fee on any member payment at any of the organisation's studios.
      //
      // The guard is the SAME function the team rule uses, deliberately: a team
      // and an organisation must never answer "may I write my own governance?"
      // differently. `create` pins `flags` too — an unguarded create is the same
      // grant one document earlier.
      allow create: if isAuthed() && request.resource.data.createdBy == request.auth.uid
                    && !('flags' in request.resource.data);
      allow update: if hasOrgRole(orgId, 'org_admin') && tenantGovernanceUnchanged();
      allow delete: if false; // Cloud Functions only

      match /org_members/{memberId} {
        // A user can always read their own membership doc (needed for collectionGroup sidebar query)
        allow read: if isOrgMember(orgId) || memberId == request.auth.uid;
        // org_admin can manage members. There is deliberately NO client
        // self-provision branch here (unlike the team-side signup): org creation
        // and every membership change run on the Admin SDK, which bypasses rules.
        // `createOrganization` writes the creator's org_admin row, and
        // `grantOrgMembership` (invite-accept + add-member) is the only other
        // writer — no client flow writes org_members directly (verified: zero
        // client setDoc/updateDoc callers).
        //
        // The removed disjunct required nothing about WHICH org this was, so ANY
        // authenticated principal (a passwordless `contact:` session included)
        // could write itself an `org_admin` row into ANY org; because hasOrgRole
        // reads the role off this very document, that write made them org_admin —
        // the org-scoped twin of the 2026-08-26 team-membership takeover (#106),
        // reaching every member studio's contact PII via isOrgAdminOfTeam.
        allow write: if hasOrgRole(orgId, 'org_admin');
        allow delete: if hasOrgRole(orgId, 'org_admin');
      }

      match /org_teams/{teamId} {
        allow read: if isOrgMember(orgId) || isTeamMember(teamId);
        allow write: if false; // Cloud Functions only
      }

      // A whole STUDIO invited into the org (accepted by that studio's owner;
      // moves the studio's billing). NOT the same thing as
      // org_member_invitations below — see the naming rule in shared/paths.ts.
      match /org_invitations/{invId} {
        allow read: if isOrgMember(orgId)
                    || (isAuthed() && resource.data.inviteeEmail == request.auth.token.email);
        allow write: if false; // Cloud Functions only
      }

      // A PERSON invited to help run the organisation (org_admin / org_viewer).
      // CLOSED: written only by Cloud Functions (inviteOrgMember / accept /
      // decline / revoke / the daily expiry sweep) — a client write could mint a
      // membership grant for any address.
      //
      // READ IS org_admin ONLY, deliberately narrower than org_invitations
      // above, and for a reason that is not tidiness: a pending row carries
      // `token`, which is a bearer credential, and rules cannot withhold one
      // field. An org_viewer is a read-only role that has no business seeing an
      // invitation at all; letting one read a token would let them create an
      // account at the invited address and promote themselves to org_admin.
      //
      // The INVITEE never reads this document. They may have no account at all,
      // so no rule could match them; they hold a token and go through the
      // unauthenticated `getOrgMemberInvitation` callable, which returns only
      // what the accept page must show.
      match /org_member_invitations/{invitationId} {
        allow read: if hasOrgRole(orgId, 'org_admin');
        allow write: if false; // Cloud Functions only
      }

      match /affiliation_statuses/{statusId} {
        allow read:   if isOrgMember(orgId);
        allow write:  if hasOrgRole(orgId, 'org_admin');
        allow delete: if hasOrgRole(orgId, 'org_admin');
      }

      // Org-wide affiliation type catalog — shared down to every sub-studio (read),
      // managed by org admins. Sub-team members read via their current team's org_id
      // so the affiliation type dropdown can populate (mirrors org_places).
      match /affiliation_types/{typeId} {
        allow read:   if isOrgMember(orgId) || currentTeamInOrg(orgId);
        allow write:  if hasOrgRole(orgId, 'org_admin');
        allow delete: if hasOrgRole(orgId, 'org_admin');
      }

      match /team_access_requests/{teamId} {
        // Org admin can read all requests; team owner can read their own
        allow read: if hasOrgRole(orgId, 'org_admin') || (isAuthed() && isTeamMember(teamId) && hasTeamRole(teamId, 'owner'));
        // Only org admin can create/update requests (approval done server-side)
        allow write: if hasOrgRole(orgId, 'org_admin');
      }

      // Org-level integrations: payment gateways + email_sender config (Brevo
      // sender model + BYO domain verification state — no credentials stored).
      match /integrations/{integrationId} {
        allow read:   if isOrgMember(orgId);
        // public_domain is server-written only — see the team-side block for why.
        allow write:  if hasOrgRole(orgId, 'org_admin')
                      && integrationId != 'public_domain';
        allow delete: if hasOrgRole(orgId, 'org_admin')
                      && integrationId != 'public_domain';
      }

      // Org-wide places: shared down to every sub-studio (read), managed by org admins.
      // Sub-team members read via their current team's org_id (mirrors org-scope events).
      match /org_places/{placeId} {
        allow read:  if isOrgMember(orgId) || currentTeamInOrg(orgId);
        allow write: if hasOrgRole(orgId, 'org_admin');
      }

      // Org-wide event programs: the federation authors the standard camp or
      // competition programme once and every sub-studio can apply it (read-only),
      // exactly like org_places. Applying it to an event and saving back always
      // produces a TEAM template — a club can never write to the org's.
      match /org_program_templates/{templateId} {
        allow read:  if isOrgMember(orgId) || currentTeamInOrg(orgId);
        allow write: if hasOrgRole(orgId, 'org_admin');
      }

      // Org-level plugin installs: visible to all sub-studios, managed by org admins.
      // Sub-team members read via their current team's org_id so useInstalledPlugins
      // can merge org plugins alongside team plugins without a separate auth check.
      match /installed_plugins/{pluginId} {
        allow read:  if isOrgMember(orgId) || currentTeamInOrg(orgId);
        allow write: if hasOrgRole(orgId, 'org_admin');
      }
    }

    // ── Early access requests (pre-launch landing page) ───────────────────────
    // Public unauthenticated write — only email, createdAt, source allowed.
    // Read/update/delete only via Admin SDK (operator console).
    match /early_access_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320;
      allow read, update, delete: if false;
    }

    // ── Platform metric snapshots (operator console) ──────────────────────────
    // Written by capturePlatformMetrics (Admin SDK) and read by the operator
    // console (Admin SDK). No client access.
    match /platform_metrics/{date} {
      allow read, write: if false;
    }

    // ── App-store presence (operator console) ─────────────────────────────────
    // Written by the `appstores` ingest (Admin SDK) and read by the operator
    // console (Admin SDK). No client access, same posture as the snapshots
    // above — and store_reviews additionally carries reviewers' display names
    // and the free text they wrote, so a readable collection here is a readable
    // list of members' own words.
    match /store_presence/{platform} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /store_reviews/{reviewId} {
      allow read, write: if false;
    }

    // Append-only log of App Store Connect webhook deliveries. Written by
    // handleAppStoreWebhook (Admin SDK, after verifying Apple's HMAC), read by
    // the operator console (Admin SDK). No client access.
    match /store_events/{eventId} {
      allow read, write: if false;
    }

    // Operator → Customer notices, and the recipient list each one was actually
    // sent to. Deny-all to clients, like the mail ledger above and for the same
    // reason: the recipients subcollection is a list of every studio's owner
    // address, so a readable notice is a readable customer list. Written by
    // `sendPlatformNotice` and read by the operator console, both Admin SDK.
    match /platform_notices/{noticeId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ── In-app feedback (see shared types/feedback.ts) ────────────────────────
    // Signed-in users create submissions; the operator console reads/updates
    // them via Admin SDK. Strict key + shape validation; identity fields must
    // match the caller and status is forced to 'new'. created_at must be a
    // serverTimestamp() (== request.time).
    match /feedback/{id} {
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly(['type', 'rating', 'message',
            'scopes', 'prompt_id', 'context', 'team_id', 'team_name', 'plan',
            'created_by', 'created_by_email', 'created_at', 'screenshot_path',
            'status'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.created_by_email == request.auth.token.email
        && request.resource.data.type in ['general', 'prompt_answer']
        && (('rating' in request.resource.data) || ('message' in request.resource.data))
        && (!('rating' in request.resource.data)
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 1
                && request.resource.data.rating <= 5))
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string
                && request.resource.data.message.size() > 0
                && request.resource.data.message.size() <= 5000))
        && request.resource.data.scopes is list
        && request.resource.data.scopes.size() <= 10
        && (!('prompt_id' in request.resource.data)
            || request.resource.data.prompt_id is string)
        && (!('screenshot_path' in request.resource.data)
            || request.resource.data.screenshot_path is string)
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time;
      allow read, update, delete: if false;
    }

    // Ops-authored prompt questions pushed to app users. Content is
    // non-sensitive by policy (any signed-in user can read every doc,
    // including drafts — rules cannot filter list reads by field).
    // Written only by the operator console (Admin SDK).
    match /feedback_prompts/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

  }
}
