# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/
*.tsbuildinfo

# Service account keys — never commit
keys/

# Emulator snapshots — machine-specific, may contain real data
snapshots/

# Firebase
# Vendored @linyup/shared injected into functions at deploy time (see
# scripts/vendor-shared-for-deploy.mjs) — generated, never committed.
packages/functions/vendor/
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
.env.local
.env.*.local

# Environment
.env
*.local

# Local stack (scripts/local-env.mjs) — this checkout's port slot and the
# emulator config generated from it. Per-machine, per-worktree; never committed.
.local-env.json
firebase.local.json

# Turbo
.turbo/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Terraform (infra/)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
# Never commit real variable values (may hold billing/org IDs); keep the examples
infra/**/terraform.tfvars
infra/**/*.auto.tfvars
# NOTE: .terraform.lock.hcl IS committed on purpose (pins provider versions).

# Expo / React Native
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Pre-teardown consent-ledger exports (Q13). They carry names, addresses and IP
# addresses — an archive, not source.
/exports/

# Message fragments are a transient hand-off between a parallel lane and
# `pnpm i18n:merge` — never committed. See apps/web/messages/_pending/README.md
apps/web/messages/_pending/*.json

# Cloudflare Worker local state/cache (infra/workers/*)
.wrangler/

# Tarif 595 sample renders (pnpm --filter @linyup/functions tarif595:sample)
packages/functions/tmp/
