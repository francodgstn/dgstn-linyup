{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "emulators",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "emulators:start"
      ],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "emulators-seed",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "emulators:seed"
      ],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "emulators-all",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "emulators:all"
      ],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "emulators-hmd",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "emulators:hmd"
      ],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "stripe-listen",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "stripe:listen"
      ],
      "port": 5001,
      "autoPort": true
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@linyup/landing",
        "exec",
        "astro",
        "dev",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "help",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@linyup/help",
        "exec",
        "astro",
        "dev",
        "--port",
        "4323"
      ],
      "port": 4323
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@linyup/docs",
        "exec",
        "astro",
        "dev",
        "--port",
        "4324"
      ],
      "port": 4324
    },
    {
      "name": "emulators-worktree",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/emulators-run.mjs",
        "--config",
        "firebase.local.json",
        "--only",
        "auth,firestore,functions,storage",
        "--project",
        "demo-linyup"
      ],
      "port": 14000,
      "autoPort": false
    },
    {
      "name": "web-worktree",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@linyup/web",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "--port",
        "13000"
      ],
      "port": 13000,
      "autoPort": false
    },
    {
      "name": "admin-worktree",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@linyup/admin",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "--port",
        "13002"
      ],
      "port": 13002,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:admin"
      ],
      "port": 3002,
      "autoPort": true
    },
    {
      "name": "admin-sandbox",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:admin:sandbox"
      ],
      "port": 3002,
      "autoPort": true
    }
  ]
}
