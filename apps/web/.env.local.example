# apps/web/.env.local — copied into place by `pnpm bootstrap` (gitignored).
#
# EMULATOR-FIRST: as written, the web app talks to the local Firebase emulators
# (`pnpm emulators:seed`, project demo-linyup). The emulators validate none of
# the client config, so the placeholders below are all it needs — a non-empty
# API key only keeps the SDK from throwing auth/invalid-api-key at startup.
#
# scripts/local-env.mjs appends a managed `# >>> local-env slot` block with
# this checkout's emulator PORTS (slot 0 = the defaults). Leave it alone.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-linyup.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://demo-linyup.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-linyup
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-linyup.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── To point a LOCAL dev server at a real project instead (rarely wanted — the
# deployed environments roll out from App Hosting with their own config): set
# NEXT_PUBLIC_USE_EMULATORS=false and fill these from the Firebase console →
# project settings → your web app. Never commit the result.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=linyup-staging.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://linyup-staging.firebaseio.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=linyup-staging
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=linyup-staging.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# PostHog product analytics (optional). The public project key (phc_…) is safe to
# embed. Leave blank to disable — initPostHog() no-ops without a key. Host = EU cloud.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Firebase App Check (reCAPTCHA v3). The reCAPTCHA v3 SITE key registered for App
# Check in the Firebase console (public, safe to embed). Leave blank to disable —
# App Check init no-ops without it, and it is always skipped under the emulator.
# Deploy this + confirm tokens flow BEFORE setting APP_CHECK_ENFORCE=true on the
# Cloud Functions (otherwise web clients without a token get rejected).
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=
# Optional: a debug token (from the browser console / Firebase console) to exercise
# App Check locally against a real project. Never set in production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Public API + MCP base URL shown on Settings → API keys (docs/public-api.md).
# Production: https://api.linyup.com. Against the local functions emulator use
# http://127.0.0.1:<functions port>/demo-linyup/europe-west6/api
NEXT_PUBLIC_API_BASE_URL=
