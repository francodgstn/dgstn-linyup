---
// A few labeled groups of chips, side by side on a wide screen and stacked on
// a phone: "here is everything, sorted". For an overview whose point is WHAT
// exists rather than how it connects (the Offerings page's three shelves).
// Server-rendered HTML and CSS only, like Flow.

export interface ShelfItem {
  label: string
  /** Usually a heading further down the page. */
  href?: string
}

export interface Shelf {
  title: string
  /** One short line under the title. */
  tagline?: string
  items: ShelfItem[]
}

interface Props {
  /** Accessible name for the diagram. */
  label: string
  shelves: Shelf[]
  /** Optional line under all the shelves. */
  footer?: string
}

const { label, shelves, footer } = Astro.props
---

<figure class="shelves not-content" role="group" aria-label={label}>
  <div class="shelves-row">
    {
      shelves.map((s) => (
        <section class="shelf">
          <p class="shelf-title">{s.title}</p>
          {s.tagline && <p class="shelf-tagline">{s.tagline}</p>}
          <ul class="shelf-items">
            {s.items.map((it) => (
              <li>{it.href ? <a href={it.href}>{it.label}</a> : <span>{it.label}</span>}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  {footer && <figcaption class="shelves-footer">{footer}</figcaption>}
</figure>

<style>
  .shelves {
    margin: 1.5rem 0;
  }
  .shelves-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 50rem) {
    .shelves-row {
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }
  }
  .shelf {
    padding: 0.85rem 1rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-top: 3px solid var(--sl-color-accent);
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--sl-color-bg-nav);
  }
  .shelf p {
    margin: 0;
  }
  .shelf-title {
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .shelf-tagline {
    margin-top: 0.15rem !important;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .shelf-items {
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .shelf-items li {
    margin: 0;
  }
  .shelf-items a,
  .shelf-items span {
    display: inline-block;
    font-size: var(--sl-text-sm);
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .shelf-items a:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }
  .shelves-footer {
    margin-top: 0.6rem;
    text-align: center;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
