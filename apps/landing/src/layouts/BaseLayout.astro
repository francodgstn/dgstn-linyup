---
import '../styles/global.css';
import { useTranslations, type Language } from '~/i18n';

interface Props {
  title: string;
  description: string;
  lang: string;
  canonicalUrl?: string;
}

const { title, description, lang, canonicalUrl } = Astro.props;
const t = useTranslations(lang as Language);
// Analytics is only wired when a PostHog key is present at build time. When it is,
// we show the consent banner; when it isn't, posthog-js is tree-shaken and the
// banner is never rendered (local dev / staging).
const phKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://linyup.com';
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
// Social-share preview image (1200×630, generated from /og — see og.astro).
const ogImage = `${siteUrl}/og-image.png`;
const ogImageAlt = 'Linyup — run your classes, know your members, grow your studio.';
const ogLocale = ({ en: 'en_US', de: 'de_DE', fr: 'fr_FR', it: 'it_IT' } as const)[lang as 'en' | 'de' | 'fr' | 'it'] ?? 'en_US';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (link previews — WhatsApp, iMessage, Slack, Facebook, …) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Linyup" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Brand fonts: Anton (display), Sora (section heads), Fredoka (logo/headings), Plus Jakarta Sans (body).
         Inter (founder-note body) + Caveat (founder signature). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Sora:wght@600;700;800&family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500&family=Caveat:wght@600&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#7c3aed" />

    <!-- Prevent flash of wrong theme — runs synchronously before paint -->
    <script is:inline>
      (function () {
        var s = localStorage.getItem('theme');
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (s === 'dark' || (!s && d)) document.documentElement.setAttribute('data-theme', 'dark');
        else if (s === 'light') document.documentElement.setAttribute('data-theme', 'light');
      })();
    </script>

    <!-- PostHog product analytics — CONSENT-FIRST.
         Nothing loads or runs until the visitor clicks "Accept" in the banner.
         The choice is stored in localStorage; "Decline" (or no choice) means
         posthog-js is never even imported. Footer "Cookie settings" reopens the
         banner via window.linyupOpenConsent(). Processed script: Astro bundles
         posthog-js (only when a key exists) and inlines import.meta.env. -->
    <script>
      // import.meta.env.PUBLIC_POSTHOG_KEY is inlined at build time. When it's
      // empty (local dev / staging) this whole branch is dead code and posthog-js
      // is tree-shaken out of the bundle entirely — zero bytes shipped.
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';
      if (key) {
        const CONSENT_KEY = 'linyup:analytics-consent';
        const banner = document.getElementById('cookie-consent');
        let loaded = false;

        const readConsent = () => {
          try {
            return localStorage.getItem(CONSENT_KEY);
          } catch {
            return null;
          }
        };
        const writeConsent = (v: 'yes' | 'no') => {
          try {
            localStorage.setItem(CONSENT_KEY, v);
          } catch {
            /* storage blocked — choice won't persist, honored for this load only */
          }
        };
        const showBanner = () => banner?.removeAttribute('hidden');
        const hideBanner = () => banner?.setAttribute('hidden', '');

        // Load + initialize PostHog. Only ever called after explicit consent.
        const loadPostHog = () => {
          if (loaded) return;
          loaded = true;
          import('posthog-js').then(({ default: posthog }) => {
            posthog.init(key, {
              api_host: host,
              person_profiles: 'identified_only',
              persistence: 'localStorage+cookie',
              disable_session_recording: true, // no replay on the marketing site
            });
            // Expose for the per-component capture calls (Pricing, EarlyAccessModal).
            (window as Window & { posthog?: typeof posthog }).posthog = posthog;
          });
        };

        // Programmatic consent API (used by the banner buttons and the footer link).
        const applyConsent = (granted: boolean) => {
          writeConsent(granted ? 'yes' : 'no');
          hideBanner();
          if (granted) {
            loadPostHog();
          } else {
            const ph = (window as Window & { posthog?: { opt_out_capturing: () => void } })
              .posthog;
            ph?.opt_out_capturing();
          }
        };
        (window as Window & { linyupConsent?: (granted: boolean) => void }).linyupConsent =
          applyConsent;
        (window as Window & { linyupOpenConsent?: () => void }).linyupOpenConsent = showBanner;

        banner
          ?.querySelectorAll<HTMLButtonElement>('[data-consent]')
          .forEach((b) =>
            b.addEventListener('click', () => applyConsent(b.dataset.consent === 'yes')),
          );

        // First-run decision: honor a stored choice, otherwise ask.
        const choice = readConsent();
        if (choice === 'yes') loadPostHog();
        else if (choice !== 'no') showBanner();
      }
    </script>

    <!-- Locale nudge: on the English root, send the visitor to their browser
         language (de/fr/it) on first visit, or to whatever they last picked in
         the switcher. English always wins ties and an explicit "EN" choice. Runs
         only on "/" so localized pages and /privacy, /legal never redirect. -->
    <script is:inline>
      (function () {
        if (location.pathname !== '/') return;
        var supported = ['de', 'fr', 'it'];
        var stored = null;
        try { stored = localStorage.getItem('linyup:lang'); } catch (e) {}
        var target = null;
        if (stored) {
          if (supported.indexOf(stored) !== -1) target = stored; // 'en' → stay
        } else {
          var langs = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < langs.length; i++) {
            var code = (langs[i] || '').slice(0, 2).toLowerCase();
            if (code === 'en') break;                 // English preference → stay
            if (supported.indexOf(code) !== -1) { target = code; break; }
          }
        }
        if (target) location.replace('/' + target);
      })();
    </script>
  </head>
  <body>
    <slot />

    {
      phKey && (
        <div id="cookie-consent" class="cc" hidden role="dialog" aria-labelledby="cc-text">
          <p class="cc-text" id="cc-text">
            {t('consent.message')} <a href="/privacy">{t('consent.learnMore')}</a>
          </p>
          <div class="cc-actions">
            <button type="button" class="cc-btn cc-decline" data-consent="no">
              {t('consent.decline')}
            </button>
            <button type="button" class="cc-btn cc-accept" data-consent="yes">
              {t('consent.accept')}
            </button>
          </div>
        </div>
      )
    }

    <!-- Lucide icons (renders all <i data-lucide> tags) -->
    <script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script is:inline>lucide.createIcons();</script>

    <!-- Gentle scroll-reveal: section heads + cards fade/slide up as they enter
         the viewport. JS-applied (no FOUC for no-JS), and fully skipped when the
         visitor prefers reduced motion. -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var sel = '.sec-head, .hd-copy, .hd-shot, .hf-card, .pay-card, .plan, .trial-wrap, .compare-toggle-wrap, .founder-row, .shot';
        var els = Array.prototype.slice.call(document.querySelectorAll(sel));
        els.forEach(function (el) { el.classList.add('reveal-init'); });
        // Stagger cards within their grid so they cascade in.
        document.querySelectorAll('.hf-grid, .pay-grid, .plans, .showcase-grid').forEach(function (grid) {
          Array.prototype.slice.call(grid.children).forEach(function (c, i) {
            c.style.transitionDelay = Math.min(i * 60, 300) + 'ms';
          });
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('reveal-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <!-- Cookie-consent banner — bottom-anchored card, non-blocking -->
    <style>
      .cc {
        position: fixed;
        z-index: 200;
        left: 16px;
        right: 16px;
        bottom: 16px;
        margin: 0 auto;
        max-width: 640px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 20px;
        padding: 16px 20px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg, 14px);
        box-shadow: var(--shadow-lg);
      }
      .cc[hidden] { display: none; }
      .cc-text { flex: 1 1 280px; margin: 0; font-size: 13.5px; line-height: 1.55; color: var(--muted-foreground); }
      .cc-text a { color: var(--primary); text-decoration: underline; }
      .cc-actions { display: flex; gap: 10px; margin-left: auto; }
      .cc-btn {
        font: inherit;
        font-size: 13.5px;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: var(--radius-pill, 99px);
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
      }
      .cc-decline { background: transparent; color: var(--foreground); border: 1px solid var(--border); }
      .cc-decline:hover { background: var(--purple-50); }
      .cc-accept { background: var(--primary); color: #fff; border: 1px solid transparent; }
      .cc-accept:hover { transform: translateY(-1px); }
      @media (prefers-reduced-motion: no-preference) {
        .cc:not([hidden]) { animation: cc-in 0.25s cubic-bezier(0.22, 0.61, 0.36, 1); }
        @keyframes cc-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
      }
      @media (max-width: 560px) {
        .cc-actions { width: 100%; }
        .cc-btn { flex: 1; }
      }
    </style>

    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        .reveal-init { opacity: 0; transform: translateY(20px); will-change: opacity, transform; }
        .reveal-in {
          opacity: 1;
          transform: none;
          transition: opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
            transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
        }
      }
    </style>
  </body>
</html>
