---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';
import { HELP_URL } from '~/links';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL ?? 'https://demo.linyup.com';

// The day-to-day essentials, shown directly under the hero as calm, static cards
// (no marquee). Labels are verb + benefit; copy lives in
// heroFeatures.cards.<key>.{title,benefit}. Eight feature cards fill two rows.
// The row beneath holds the three doors, left to right: the full feature list
// (#more-features, Features.astro), the accent demo CTA (half the row), and the
// help centre. The two outer doors share one tinted "door" style, so the eye
// reads them as ways onward rather than as features.
const cards = [
  { key: 'sessions', icon: 'calendar-range' },
  { key: 'bookings', icon: 'clipboard-list' },
  { key: 'memberships', icon: 'badge-check' },
  { key: 'payments', icon: 'credit-card' },
  { key: 'rankings', icon: 'medal' },
  { key: 'mobileApp', icon: 'smartphone' },
  { key: 'automations', icon: 'workflow' },
  { key: 'ai', icon: 'brain-circuit' },
] as const;
---

<section id="features" class="hf">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow"><i data-lucide="sparkles"></i> {t('heroFeatures.eyebrow')}</span>
      <h2>{t('heroFeatures.title')}</h2>
      <p>{t('heroFeatures.subtitle')}</p>
    </div>

    <div class="hf-grid">
      {
        cards.map(({ key, icon }) => (
          <div class="hf-card">
            <div class="hf-icon"><i data-lucide={icon} /></div>
            <h3>{t(`heroFeatures.cards.${key}.title`)}</h3>
            <p>{t(`heroFeatures.cards.${key}.benefit`)}</p>
          </div>
        ))
      }
      <a class="hf-card hf-door" href="#more-features">
        <div class="hf-icon hf-door-icon"><i data-lucide="layout-grid"></i></div>
        <h3>{t('heroFeatures.all.title')}</h3>
        <p>{t('heroFeatures.all.body')} <i data-lucide="arrow-right"></i></p>
      </a>
      <a class="hf-card hf-cta" href={`${DEMO_URL}/try`} target="_blank" rel="noopener">
        <div class="hf-icon hf-cta-icon"><i data-lucide="play"></i></div>
        <h3>{t('heroFeatures.cta.title')}</h3>
        <p>{t('heroFeatures.cta.body')} <i data-lucide="arrow-right"></i></p>
      </a>
      <a class="hf-card hf-door" href={HELP_URL}>
        <div class="hf-icon hf-door-icon"><i data-lucide="life-buoy"></i></div>
        <h3>{t('heroFeatures.help.title')}</h3>
        <p>{t('heroFeatures.help.body')} <i data-lucide="arrow-right"></i></p>
      </a>
    </div>
  </div>
</section>

<style>
  .hf { padding: 88px 0 24px; }

  /* Eyebrow above the shared section heading */
  .sec-head .eyebrow { margin-bottom: 16px; }

  .hf-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  /* Calm, spacious card — hairline border + soft shadow, gentle lift on hover */
  .hf-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--card);
    border-radius: var(--radius-xl);
    box-shadow: var(--ring-card), var(--shadow-sm);
    padding: 26px 24px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hf-card:hover { transform: translateY(-3px); box-shadow: var(--ring-card), var(--shadow-md); }

  /* Accent demo CTA — the middle half of the row beneath the cards, in primary. */
  .hf-cta {
    grid-column: span 2;
    background: linear-gradient(160deg, var(--primary), color-mix(in oklch, var(--primary) 78%, black));
    border: 0;
    color: #fff;
    text-decoration: none;
  }
  .hf-cta:hover { box-shadow: var(--ring-card), var(--shadow-lg); }
  .hf-cta h3 { color: #fff; }
  /* Higher specificity than `.hf-card p` (same element carries both classes), so the
     body text actually renders white on the purple card instead of muted grey. */
  .hf-card.hf-cta p { color: color-mix(in oklch, #fff 94%, transparent); display: inline-flex; align-items: center; gap: 8px; }
  .hf-cta p :global(svg) { width: 16px; height: 16px; transition: transform 0.15s ease; }
  .hf-cta:hover p :global(svg) { transform: translateX(3px); }
  .hf-cta-icon { background: color-mix(in oklch, #fff 18%, transparent); border-color: color-mix(in oklch, #fff 28%, transparent); color: #fff; }

  /* The doors — "Check all features" and the help centre. The third style:
     neither the primary CTA nor a plain card. A tinted surface with a primary
     hairline reads as "a door", not a feature. */
  .hf-door {
    background: var(--purple-50);
    box-shadow: inset 0 0 0 1px var(--purple-200), var(--shadow-sm);
    text-decoration: none;
    color: inherit;
  }
  .hf-door:hover { box-shadow: inset 0 0 0 1px var(--primary), var(--shadow-md); }
  .hf-door-icon { background: var(--card); }
  .hf-card.hf-door p { display: inline-flex; align-items: center; gap: 6px; color: var(--primary); font-weight: 600; }
  .hf-door p :global(svg) { width: 15px; height: 15px; transition: transform 0.15s ease; }
  .hf-door:hover p :global(svg) { transform: translateX(3px); }

  .hf-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--purple-50);
    color: var(--primary);
    border: 1px solid var(--purple-100);
    margin-bottom: 18px;
  }
  .hf-icon :global(svg) { width: 26px; height: 26px; }

  .hf-card h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.25;
    margin: 0 0 7px;
  }
  .hf-card p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted-foreground);
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 1100px) {
    .hf-grid { grid-template-columns: repeat(2, 1fr); }
    .hf-cta, .hf-door { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) {
    .hf { padding: 52px 0 12px; }
  }
  @media (max-width: 480px) {
    .hf-grid { grid-template-columns: 1fr; }
  }
</style>
