---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';
import dashboard from '../assets/product/dashboard.webp';
import dashboardDark from '../assets/product/dashboard-dark.webp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL ?? 'https://demo.linyup.com';

// Live demo playground (sandbox). Each link goes to /preview?team=, which
// auto-signs into that demo studio. Keys in sync with DEMO_ACCOUNTS in
// apps/web/src/lib/demo.ts. All activities are equal peers — no default vertical.
const DEMO_STUDIOS = [
  { key: 'dance', accent: '#db2777' },
  { key: 'crossfit', accent: '#0f172a' },
  { key: 'yoga', accent: '#9333ea' },
  { key: 'tennis', accent: '#16a34a' },
  { key: 'pilates', accent: '#0d9488' },
  { key: 'grappling', accent: '#dc2626' },
] as const;
---

<section class="herodemo">
  <div class="wrap">
    <div class="hd-grid">
      <!-- Left: the live-demo chips -->
      <div class="hd-copy">
        <p class="demo-eyebrow"><i data-lucide="play-circle"></i> {t('hero.demoEyebrow')}</p>
        <div class="demo-chips">
          {
            DEMO_STUDIOS.map((studio) => (
              <a
                class="demo-chip"
                href={`${DEMO_URL}/preview?team=${studio.key}`}
                target="_blank"
                rel="noopener"
                style={`--chip-accent: ${studio.accent}`}
              >
                <span class="demo-chip-dot" />
                {t(`hero.demoStudios.${studio.key}`)}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right: the product peek — bleeds toward the bottom-right edge and fades
           out there, so it "kicks in" as the page scrolls. Hidden on mobile. -->
      <div class="hd-shot">
        <figure class="frame">
          <div class="frame-bar" aria-hidden="true">
            <span class="tdot r"></span><span class="tdot y"></span><span class="tdot g"></span>
            <span class="frame-url"><i data-lucide="lock"></i> app.linyup.com/dashboard</span>
          </div>
          <div class="frame-crop">
            {/* Both themes ship; global.css shows one (img.shot-light /
                img.shot-dark). Both are eager: whichever the visitor's theme
                resolves to is the hero image, and lazily loading the dark one
                would mean a dark-mode visitor waits for the LCP element. */}
            <img
              class="frame-img shot-light"
              src={dashboard.src}
              width={dashboard.width}
              height={dashboard.height}
              alt={t('showcase.dashboardAlt')}
              loading="eager"
              decoding="async"
            />
            <img
              class="frame-img shot-dark"
              src={dashboardDark.src}
              width={dashboardDark.width}
              height={dashboardDark.height}
              alt={t('showcase.dashboardAlt')}
              loading="eager"
              decoding="async"
            />
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .herodemo { padding: 40px 0 60px; overflow: hidden; }

  .hd-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 44px;
    align-items: center;
    /* Deliberately off-center: nudge the whole row to the right so the
       composition feels dynamic rather than symmetric (reset on mobile). */
    margin-left: clamp(20px, 3.5vw, 52px);
  }

  /* Left column — chips aligned to the top-left */
  .hd-copy { align-self: center; }
  .demo-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    margin: 0 0 18px;
  }
  .demo-eyebrow :global(svg) { width: 15px; height: 15px; color: var(--primary); }

  .demo-chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .demo-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    box-shadow: var(--ring-card), var(--shadow-sm);
    padding: 12px 20px;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }
  .demo-chip:hover {
    border-color: color-mix(in oklch, var(--primary) 45%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--ring-card), var(--shadow-md);
  }
  .demo-chip-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--chip-accent, var(--primary));
    box-shadow: 0 0 8px var(--chip-accent, var(--primary));
    flex-shrink: 0;
  }

  /* Right column — the browser frame bleeds past the right edge and is masked to
     fade toward the bottom-right (the "external" side), sitting a touch lower. */
  .hd-shot { position: relative; }
  .frame {
    width: 128%;
    margin-top: 26px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--ring-card), var(--shadow-lg);
    -webkit-mask-image: linear-gradient(118deg, #000 46%, transparent 92%);
    mask-image: linear-gradient(118deg, #000 46%, transparent 92%);
  }
  /* Show only the top slice of the dashboard as a peek. */
  .frame-crop { max-height: 360px; overflow: hidden; }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
    background: color-mix(in oklch, var(--sidebar) 60%, var(--card));
    border-bottom: 1px solid var(--border);
  }
  .tdot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .tdot.r { background: #ff5f57; }
  .tdot.y { background: #febc2e; }
  .tdot.g { background: #28c840; }
  .frame-url {
    margin-left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted-foreground);
    background: var(--background);
    border: 1px solid var(--border);
    padding: 3px 12px;
    border-radius: var(--radius-pill);
  }
  .frame-url :global(svg) { width: 12px; height: 12px; }
  /* `display` is deliberately absent: global.css owns it for the shot-light /
     shot-dark pair, and an Astro-scoped rule here would outrank it. */
  .frame-img { width: 100%; height: auto; }

  /* Tablet — narrower screenshot bleed, tighter gap */
  @media (max-width: 1100px) {
    .hd-grid { grid-template-columns: 0.9fr 1.1fr; gap: 28px; }
    .frame { width: 124%; }
    .frame-crop { max-height: 300px; }
  }

  /* Mobile — hide the screenshot entirely; chips center under the hero */
  @media (max-width: 760px) {
    .herodemo { padding: 8px 0 28px; }
    .hd-grid { grid-template-columns: 1fr; gap: 0; margin-left: 0; }
    .hd-shot { display: none; }
    .demo-eyebrow { justify-content: center; }
    .demo-chips { justify-content: center; }
  }
</style>

<!-- Stronger, directional entrance, layered on top of the shared scroll-reveal in
     BaseLayout (which adds .reveal-init / .reveal-in to .hd-copy + .hd-shot): the
     demo chips cascade in from the left one-by-one, paired with the product peek
     floating in from the right. is:global so it can combine HeroShot's classes with
     the runtime reveal classes. Fully skipped under prefers-reduced-motion. -->
<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Chips cascade individually, so neutralise the container's own block reveal
       and let .hd-copy only act as the in-view trigger. */
    .hd-copy.reveal-init,
    .hd-copy.reveal-in { opacity: 1; transform: none; }
    .hd-copy.reveal-init .demo-eyebrow,
    .hd-copy.reveal-init .demo-chip { opacity: 0; }
    /* Explicit resting state once revealed — the chips never get stuck hidden if
       the entrance animation doesn't run; the animation's backwards fill keeps each
       chip hidden until its own delay elapses, which is what gives the cascade. */
    .hd-copy.reveal-in .demo-eyebrow,
    .hd-copy.reveal-in .demo-chip { opacity: 1; }
    .hd-copy.reveal-in .demo-eyebrow {
      animation: hd-float-left 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hd-copy.reveal-in .demo-chip {
      animation: hd-float-left 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hd-copy.reveal-in .demo-chip:nth-child(1) { animation-delay: 0.12s; }
    .hd-copy.reveal-in .demo-chip:nth-child(2) { animation-delay: 0.19s; }
    .hd-copy.reveal-in .demo-chip:nth-child(3) { animation-delay: 0.26s; }
    .hd-copy.reveal-in .demo-chip:nth-child(4) { animation-delay: 0.33s; }
    .hd-copy.reveal-in .demo-chip:nth-child(5) { animation-delay: 0.40s; }
    .hd-copy.reveal-in .demo-chip:nth-child(6) { animation-delay: 0.47s; }

    /* Product peek floats in from the right (starts further off-screen, lands flush). */
    .hd-shot.reveal-init { transform: translateX(64px); }
    .hd-shot.reveal-in { transform: none; }
  }

  @keyframes hd-float-left {
    from { opacity: 0; transform: translateX(-34px); }
    to { opacity: 1; transform: none; }
  }
</style>
