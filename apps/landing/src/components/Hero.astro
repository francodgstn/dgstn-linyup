---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Early-access capture — posts to Firestore early_access_requests (same as the
// pre-launch page). PUBLIC_* so they're available client-side.
// The live-demo chips now live in HeroShot.astro (paired with the product peek).
const FIREBASE_PROJECT_ID = import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? 'demo-linyup';
const FIREBASE_API_KEY = import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '';
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
  </div>
  <span class="coming-soon">{t('hero.limitedAccess')}</span>
  <div class="wrap">
    <span class="eyebrow"><i data-lucide="zap"></i> {t('hero.tagline')}</span>
    <h1 class="title">
      {
        t('hero.title')
          .split(/(?<=\.)\s+/)
          .filter((line) => line.trim().length > 0)
          .map((line) => <span class="title-line">{line}</span>)
      }
    </h1>
    <p class="sub">{t('hero.subtitle')}</p>

    <!-- Early-access capture -->
    <form class="cta-form" id="early-access-form" novalidate>
      <input
        class="email-input"
        type="email"
        id="email-input"
        name="email"
        placeholder={t('hero.emailPlaceholder')}
        autocomplete="email"
        required
      />
      <button class="btn btn-primary btn-lg" type="submit" id="submit-btn">
        {t('hero.emailCta')} <i data-lucide="arrow-right"></i>
      </button>
    </form>
    <p class="consent" set:html={t('hero.consent')}></p>
    <p class="form-status" id="form-status" aria-live="polite"></p>
  </div>
</section>

<script
  define:vars={{
    projectId: FIREBASE_PROJECT_ID,
    apiKey: FIREBASE_API_KEY,
    msgSending: t('hero.emailSending'),
    msgSuccess: t('hero.emailSuccess'),
    msgError: t('hero.emailError'),
    ctaLabel: t('hero.emailCta'),
  }}
>
  const form = document.getElementById('early-access-form');
  const input = document.getElementById('email-input');
  const btn = document.getElementById('submit-btn');
  const status = document.getElementById('form-status');

  if (form && input && btn && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      btn.disabled = true;
      btn.textContent = msgSending;
      status.textContent = '';
      status.className = 'form-status';

      try {
        const url =
          projectId === 'demo-linyup'
            ? `http://localhost:8080/v1/projects/${projectId}/databases/(default)/documents/early_access_requests`
            : `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/early_access_requests?key=${apiKey}`;

        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fields: {
              email: { stringValue: email },
              createdAt: { timestampValue: new Date().toISOString() },
              source: { stringValue: 'full-landing' },
            },
          }),
        });

        // 409 = already on the list; treat as success.
        if (!res.ok && res.status !== 409) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body?.error?.message ?? `HTTP ${res.status}`);
        }

        form.style.display = 'none';
        status.textContent = msgSuccess;
        status.className = 'form-status success';
      } catch (err) {
        console.error('Early access submit error:', err);
        status.textContent = msgError;
        status.className = 'form-status error';
        btn.disabled = false;
        btn.textContent = ctaLabel;
      }
    });
  }
</script>

<style>
  .hero { position: relative; padding: 104px 0 80px; text-align: center; overflow: hidden; }
  .hero .wrap { position: relative; z-index: 1; }

  /* Drifting radial-gradient field behind the hero */
  .hero-bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .hero-bg .orb { position: absolute; border-radius: 50%; filter: blur(48px); will-change: transform; }
  .orb-1 {
    width: 600px;
    height: 600px;
    top: -180px;
    left: -140px;
    background: radial-gradient(circle, color-mix(in oklch, var(--primary) 26%, transparent), transparent 68%);
    opacity: 0.55;
    animation: orb-drift-1 26s ease-in-out infinite alternate;
  }
  .orb-2 {
    width: 520px;
    height: 520px;
    top: -120px;
    right: -120px;
    background: radial-gradient(circle, color-mix(in oklch, var(--purple-400, var(--primary)) 30%, transparent), transparent 68%);
    opacity: 0.5;
    animation: orb-drift-2 32s ease-in-out infinite alternate;
  }
  /* Drift down and across so the orbs pass behind the hero text */
  @keyframes orb-drift-1 {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(200px, 260px) scale(1.15); }
  }
  @keyframes orb-drift-2 {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(-180px, 300px) scale(1.12); }
  }

  /* "Limited access" tag — deliberately a little off-axis, with a gentle bob */
  .coming-soon {
    position: absolute;
    top: 28px;
    right: max(24px, calc((100% - 1120px) / 2 + 24px));
    z-index: 2;
    transform: rotate(5deg);
    background: var(--primary);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-md);
    animation: coming-soon-bob 4.5s ease-in-out infinite;
  }
  @keyframes coming-soon-bob {
    0%, 100% { transform: rotate(4deg) translateY(0); }
    50% { transform: rotate(6deg) translateY(-3px); }
  }
  h1.title {
    font-family: "Anton", var(--font-sans);
    font-weight: 400;
    /* Fluid: scales smoothly from 66px (desktop) down to a 44px floor, so the
       triad doesn't drop abruptly or shrink too far on small screens. */
    font-size: clamp(44px, 9.5vw, 66px);
    line-height: 0.98;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    margin: 22px auto 0;
  }
  .title-line { display: block; }
  .sub { font-size: 19px; line-height: 1.55; color: var(--muted-foreground); max-width: 60ch; margin: 22px auto 0; text-wrap: pretty; }

  /* Early-access form */
  .cta-form { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; max-width: 460px; margin: 48px auto 0; }
  .email-input {
    flex: 1;
    height: 48px;
    padding: 0 16px;
    border-radius: var(--radius-lg);
    font-size: 15px;
    font-family: inherit;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--foreground);
    outline: none;
    transition: border-color 0.15s ease;
  }
  .email-input::placeholder { color: var(--muted-foreground); }
  .email-input:focus { border-color: var(--primary); }
  .cta-form .btn { flex-shrink: 0; }
  .form-status { margin: 14px auto 0; min-height: 20px; font-size: 14px; text-align: center; color: var(--muted-foreground); }
  .form-status.success { color: var(--success-fg); }
  .form-status.error { color: var(--warning-fg); }
  .consent { margin: 14px auto 0; max-width: 460px; font-size: 12.5px; line-height: 1.5; text-align: center; color: var(--muted-foreground); }
  .consent a { color: var(--primary); text-decoration: underline; }

  @media (max-width: 860px) {
    .hero { padding: 64px 0 48px; }
    .sub { font-size: 17px; }
    .coming-soon { top: 14px; right: 14px; font-size: 11px; padding: 5px 11px; }
  }

  @media (max-width: 540px) {
    .cta-form { flex-direction: column; align-items: stretch; }
    .email-input, .cta-form .btn { width: 100%; justify-content: center; }
    /* In a column flex, flex:1 (basis 0) collapses the input height — pin it back */
    .email-input { flex: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb-1, .orb-2, .coming-soon { animation: none; }
  }
</style>
