---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Language } from '~/i18n';
import { useTranslations, getLocalizedPath, stripLocale, languages, defaultLang } from '~/i18n';
import { HELP_URL } from '~/links';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.linyup.com';
const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL ?? 'https://demo.linyup.com';

// Locale options for the mobile menu — plain links (no JS), mirroring the
// desktop LanguageSwitcher's targets so switching works without a <select>.
const currentPath = stripLocale(Astro.url.pathname);
function hrefForLang(l: Language): string {
  if (l === defaultLang) return currentPath || '/';
  const clean = currentPath.replace(/^\//, '').replace(/\/$/, '');
  return clean ? `/${l}/${clean}` : `/${l}`;
}
const langOptions = (Object.keys(languages) as Language[]).map((l) => ({
  label: l.toUpperCase(),
  href: hrefForLang(l),
  selected: l === lang,
}));

// Demo studios for the "Live demo" dropdown — same targets/labels/order as the
// hero chips. Equal peers, martial arts not first.
const DEMO_STUDIOS = [
  { key: 'dance', accent: '#db2777' },
  { key: 'crossfit', accent: '#0f172a' },
  { key: 'yoga', accent: '#9333ea' },
  { key: 'tennis', accent: '#16a34a' },
  { key: 'pilates', accent: '#0d9488' },
  { key: 'grappling', accent: '#dc2626' },
] as const;
---

<header>
  <div class="wrap nav">
    <a href={getLocalizedPath('/', lang)} class="brand" aria-label={t('site.name')}>
      <Logo size={22} />
    </a>

    <nav class="nav-links">
      <a href={getLocalizedPath('/#features', lang)}>{t('nav.features')}</a>
      <a href={getLocalizedPath('/#pricing', lang)}>{t('nav.pricing')}</a>
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-trigger" aria-haspopup="true">
          {t('nav.demo')} <i data-lucide="chevron-down"></i>
        </button>
        <div class="nav-dropdown-menu">
          {
            DEMO_STUDIOS.map((studio) => (
              <a
                href={`${DEMO_URL}/preview?team=${studio.key}`}
                target="_blank"
                rel="noopener"
                style={`--chip-accent: ${studio.accent}`}
              >
                <span class="dot"></span>
                {t(`hero.demoStudios.${studio.key}`)}
              </a>
            ))
          }
        </div>
      </div>
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-trigger" aria-haspopup="true">
          {t('nav.resources')} <i data-lucide="chevron-down"></i>
        </button>
        <div class="nav-dropdown-menu">
          <a href={HELP_URL}><i data-lucide="life-buoy"></i>{t('footer.links.help')}</a>
          <a href={getLocalizedPath('/roadmap', lang)}><i data-lucide="map"></i>{t('footer.links.roadmap')}</a>
        </div>
      </div>
    </nav>

    <div class="nav-right">
      <div class="nav-lang">
        <LanguageSwitcher currentLang={lang} />
      </div>
      <button id="theme-toggle" class="theme-btn" aria-label="Switch theme (light, dark, system)" type="button">
        <!-- Each icon marks the CURRENT mode; click cycles light → dark → system -->
        <svg id="icon-sun" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg id="icon-moon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg id="icon-system" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      </button>
      <a class="btn btn-ghost login" href={`${APP_URL}/login`}>{t('nav.login')}</a>
      <a class="btn btn-ghost demo-cta" href={`${DEMO_URL}/try`} target="_blank" rel="noopener">
        <i data-lucide="play-circle"></i> <span class="demo-cta-label">{t('nav.liveDemo')}</span>
      </a>
      <button class="btn btn-primary nav-cta" type="button" data-early-access data-ea-source="nav">
        <span class="cta-full">{t('nav.cta')}</span><span class="cta-short">{t('nav.ctaShort')}</span>
      </button>
      <button id="nav-burger" class="nav-burger" type="button" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-menu">
        <i data-lucide="menu"></i>
      </button>
    </div>
  </div>

  <!-- Mobile drawer — links + language + theme moved off the top bar to free
       room for the CTA buttons. Shown only ≤860px, toggled by the hamburger. -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="mm-links">
      <a href={getLocalizedPath('/#features', lang)}>{t('nav.features')}</a>
      <a href={getLocalizedPath('/#pricing', lang)}>{t('nav.pricing')}</a>
      <a href={`${DEMO_URL}/try`} target="_blank" rel="noopener">{t('nav.liveDemo')}</a>
      <a href={HELP_URL}>{t('footer.links.help')}</a>
      <a href={getLocalizedPath('/roadmap', lang)}>{t('footer.links.roadmap')}</a>
      <a href={`${APP_URL}/login`}>{t('nav.login')}</a>
    </nav>
    <div class="mm-row">
      <span class="mm-label">{t('nav.language')}</span>
      <div class="mm-langs">
        {langOptions.map((o) => (
          <a href={o.href} class:list={['mm-opt', { active: o.selected }]}>{o.label}</a>
        ))}
      </div>
    </div>
    <div class="mm-row">
      <span class="mm-label">{t('nav.theme')}</span>
      <div class="mm-theme">
        <button type="button" class="mm-opt" data-theme-set="light">{t('nav.themeLight')}</button>
        <button type="button" class="mm-opt" data-theme-set="dark">{t('nav.themeDark')}</button>
        <button type="button" class="mm-opt" data-theme-set="system">{t('nav.themeSystem')}</button>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklch, var(--background) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav { display: flex; align-items: center; height: 64px; gap: 28px; }
  .brand { display: inline-flex; align-items: center; }
  .nav-links { display: flex; gap: 26px; margin-left: 8px; }
  .nav-links a { font-size: 14px; font-weight: 500; color: var(--muted-foreground); }
  .nav-links a:hover { color: var(--foreground); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }

  /* "Live demo" dropdown (hover/focus, desktop only) */
  .nav-dropdown { position: relative; display: inline-flex; align-items: center; }
  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    color: var(--muted-foreground);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .nav-dropdown-trigger:hover { color: var(--foreground); }
  .nav-dropdown-trigger :global(svg) { width: 14px; height: 14px; transition: transform 0.15s ease; }
  .nav-dropdown:hover .nav-dropdown-trigger :global(svg),
  .nav-dropdown:focus-within .nav-dropdown-trigger :global(svg) { transform: rotate(180deg); }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 200px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 30;
  }
  /* Invisible bridge so the menu stays open while the cursor crosses the gap */
  .nav-dropdown-menu::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--foreground);
    white-space: nowrap;
  }
  .nav-dropdown-menu a:hover { background: var(--purple-50); color: var(--primary); }
  .nav-dropdown-menu a :global(svg) { width: 16px; height: 16px; color: var(--muted-foreground); flex-shrink: 0; }
  .nav-dropdown-menu a:hover :global(svg) { color: var(--primary); }
  .nav-dropdown-menu .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--chip-accent, var(--primary));
    box-shadow: 0 0 6px var(--chip-accent, var(--primary));
    flex-shrink: 0;
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-lg);
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: color 0.15s;
    padding: 0;
  }
  .theme-btn:hover { color: var(--foreground); }
  .theme-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .theme-btn svg { display: block; }

  /* "Try it live" secondary button — the demo in one tap on phones and tablets,
     where the "Live demo" menu has moved into the drawer. On desktop that menu
     is in the bar and opens each demo studio directly, so the button would only
     repeat it (it leads to the same demo studios, via /try's picker): hidden
     there, see the min-width: 861px block. Outlined to read as secondary next
     to the primary CTA. */
  .demo-cta { gap: 6px; border: 1px solid var(--border); }
  .demo-cta:hover { border-color: var(--primary); color: var(--primary); }
  .demo-cta :global(svg) { width: 16px; height: 16px; display: inline-block; }

  /* ── Mobile drawer (hamburger) ───────────────────────────────────────── */
  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 34px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
    padding: 0;
  }
  .nav-burger:hover { border-color: var(--primary); color: var(--primary); }
  .nav-burger :global(svg) { width: 20px; height: 20px; }

  .mobile-menu {
    border-top: 1px solid var(--border);
    background: color-mix(in oklch, var(--background) 96%, transparent);
    backdrop-filter: blur(10px);
    padding: 8px 20px 18px;
  }
  .mobile-menu[hidden] { display: none; }

  .mm-links { display: flex; flex-direction: column; }
  .mm-links a {
    padding: 13px 2px;
    font-size: 16px;
    font-weight: 500;
    color: var(--foreground);
    border-bottom: 1px solid var(--border);
  }
  .mm-links a:hover { color: var(--primary); }

  .mm-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
  }
  .mm-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
  }
  .mm-langs, .mm-theme { display: inline-flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .mm-opt {
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 11px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .mm-opt:hover { color: var(--foreground); border-color: var(--primary); }
  .mm-opt.active { color: var(--primary); border-color: var(--primary); background: var(--purple-50); }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .login { display: none; }
    /* Language + theme move into the drawer, freeing the top bar for the CTAs. */
    .nav-lang, .theme-btn { display: none; }
    .nav-burger { display: inline-flex; }
  }
  /* Drawer only exists on mobile — never let it show on desktop (e.g. after a resize).
     The "Try it live" button goes too: the "Live demo" menu is in the bar here. */
  @media (min-width: 861px) {
    .mobile-menu { display: none !important; }
    .demo-cta { display: none; }
  }
  /* The primary CTA never wraps: a wrapped label overflowed the 40px button
     ("Frühen Zugang sichern" ran to three clipped lines on a phone). */
  .nav-cta { white-space: nowrap; }
  .cta-short { display: none; }

  /* On the tightest screens, collapse the demo button to its icon and give the
     CTA its short label to save room. */
  @media (max-width: 520px) {
    .nav { gap: 12px; }
    .nav-right { gap: 8px; }
    .demo-cta-label { display: none; }
    .demo-cta { padding: 0 11px; }
    .nav-cta { padding: 0 13px; font-size: 13px; }
    .cta-full { display: none; }
    .cta-short { display: inline; }
  }
  /* Narrowest phones: the demo button leaves the bar (the drawer still has
     "Try it live"), so the primary CTA + menu fit in every locale at 320px. */
  @media (max-width: 400px) {
    .demo-cta { display: none; }
  }
</style>

<script>
  (function () {
    const root = document.documentElement;
    const order = ['light', 'dark', 'system'] as const;
    type Mode = (typeof order)[number];
    const icons: Record<Mode, HTMLElement | null> = {
      light: document.getElementById('icon-sun'),
      dark: document.getElementById('icon-moon'),
      system: document.getElementById('icon-system'),
    };
    const mq = window.matchMedia('(prefers-color-scheme: dark)');

    function getMode(): Mode {
      const s = localStorage.getItem('theme');
      return s === 'light' || s === 'dark' ? s : 'system';
    }

    function apply(mode: Mode) {
      const resolved = mode === 'system' ? (mq.matches ? 'dark' : 'light') : mode;
      root.setAttribute('data-theme', resolved);
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    }

    function syncIcon(mode: Mode) {
      for (const k of order) {
        const el = icons[k];
        if (el) el.style.display = k === mode ? 'block' : 'none';
      }
    }

    // The mobile drawer offers the three modes as explicit buttons; keep their
    // active state in sync with the resolved mode.
    function syncThemeButtons(mode: Mode) {
      document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((el) => {
        el.classList.toggle('active', el.dataset.themeSet === mode);
      });
    }

    // BaseLayout's inline script already painted data-theme; just reflect the mode.
    syncIcon(getMode());
    syncThemeButtons(getMode());

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = order[(order.indexOf(getMode()) + 1) % order.length];
      apply(next);
      syncIcon(next);
      syncThemeButtons(next);
    });

    document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((el) => {
      el.addEventListener('click', () => {
        const mode = el.dataset.themeSet;
        if (mode === 'light' || mode === 'dark' || mode === 'system') {
          apply(mode);
          syncIcon(mode);
          syncThemeButtons(mode);
        }
      });
    });

    // Follow OS changes live while in system mode.
    mq.addEventListener('change', () => {
      if (getMode() === 'system') {
        apply('system');
        syncIcon('system');
        syncThemeButtons('system');
      }
    });

    // Hamburger drawer
    const burger = document.getElementById('nav-burger');
    const menu = document.getElementById('mobile-menu');
    burger?.addEventListener('click', () => {
      if (!menu) return;
      const willOpen = menu.hasAttribute('hidden');
      if (willOpen) menu.removeAttribute('hidden');
      else menu.setAttribute('hidden', '');
      burger.setAttribute('aria-expanded', String(willOpen));
    });
    // Close after tapping a link (same-page hash nav doesn't reload).
    menu?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.setAttribute('hidden', '');
        burger?.setAttribute('aria-expanded', 'false');
      }),
    );
  })();
</script>
