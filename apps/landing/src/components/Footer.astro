---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Language } from '~/i18n';
import { useTranslations, getLocalizedPath } from '~/i18n';
import { HELP_URL } from '~/links';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const copyright = t('footer.copyright').replace('{year}', String(year));
// Only show "Cookie settings" when analytics is actually wired (a key exists);
// it reopens the consent banner via window.linyupOpenConsent() (BaseLayout).
const analyticsEnabled = !!import.meta.env.PUBLIC_POSTHOG_KEY;
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div class="foot-brand">
        <a href={getLocalizedPath('/', lang)} class="brand" aria-label={t('site.name')}>
          <Logo size={18} />
        </a>
        <span class="tag">{t('footer.tagline')}</span>
      </div>

      <nav class="foot-col" aria-labelledby="foot-product">
        <h3 id="foot-product">{t('footer.cols.product')}</h3>
        <a href={getLocalizedPath('/#features', lang)}>{t('nav.features')}</a>
        <a href={getLocalizedPath('/#pricing', lang)}>{t('nav.pricing')}</a>
        <a href={getLocalizedPath('/roadmap', lang)}>{t('footer.links.roadmap')}</a>
        <a href={HELP_URL}>{t('footer.links.help')}</a>
      </nav>

      <nav class="foot-col" aria-labelledby="foot-legal">
        <h3 id="foot-legal">{t('footer.cols.legal')}</h3>
        {/* Legal pages are English-only at the site root for now; localized
            versions follow later. Terms + DPA landed with the signup acceptance
            step — the checkbox there links straight here, so these must not be
            removed without also removing that link. */}
        <a href="/privacy">{t('footer.links.privacy')}</a>
        <a href="/terms">{t('footer.links.terms')}</a>
        <a href="/dpa">{t('footer.links.dpa')}</a>
        <a href="/legal">{t('footer.links.legal')}</a>
        {analyticsEnabled && (
          <button type="button" class="link-btn" data-open-consent>
            {t('footer.links.cookies')}
          </button>
        )}
      </nav>

      <div class="foot-col">
        <h3>{t('footer.cols.contact')}</h3>
        <a href="mailto:hello@linyup.com">hello@linyup.com</a>
      </div>
    </div>

    <div class="foot-bottom">
      <div class="copy">{copyright}</div>
      <LanguageSwitcher currentLang={lang} />
    </div>
  </div>
</footer>

<script>
  // "Cookie settings" reopens the consent banner (defined in BaseLayout).
  document.querySelector('[data-open-consent]')?.addEventListener('click', () => {
    (window as Window & { linyupOpenConsent?: () => void }).linyupOpenConsent?.();
  });
</script>

<style>
  footer { padding: 56px 0 40px; border-top: 1px solid var(--border); }
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .foot-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .brand { display: inline-flex; align-items: center; }
  .foot-brand .tag { font-size: 13.5px; color: var(--muted-foreground); max-width: 32ch; }

  .foot-col { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .foot-col h3 {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--foreground);
    margin: 0 0 4px;
  }
  .foot-col a,
  .foot-col .link-btn { font-size: 13.5px; color: var(--muted-foreground); text-align: left; }
  .foot-col a:hover,
  .foot-col .link-btn:hover { color: var(--foreground); }
  .link-btn { padding: 0; border: 0; background: none; font-family: inherit; cursor: pointer; }

  .foot-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .copy { font-size: 12.5px; color: var(--muted-foreground); }

  @media (max-width: 860px) {
    .foot { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    .foot-brand { grid-column: 1 / -1; }
  }
</style>
