---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// ~24 features across 3 rows. Titles/descriptions come from
// features.cards.<key>.{title,description}; icons are Lucide names.
// `soon: true` marks features that aren't available yet (shown in the modal).
const featureRows: { key: string; icon: string; soon?: boolean }[][] = [
  // Row 0 — scrolls left
  [
    { key: 'sessions', icon: 'calendar-range' },
    { key: 'calendar', icon: 'calendar-days' },
    { key: 'contacts', icon: 'users' },
    { key: 'bookings', icon: 'clipboard-list' },
    { key: 'checkins', icon: 'qr-code' },
    { key: 'trials', icon: 'sparkles' },
    { key: 'memberships', icon: 'badge-check' },
    { key: 'payments', icon: 'credit-card' },
    { key: 'appointments', icon: 'calendar-clock' },
    { key: 'goals', icon: 'target' },
  ],
  // Row 1 — scrolls right
  [
    { key: 'biolink', icon: 'link' },
    { key: 'website', icon: 'globe' },
    { key: 'customDomain', icon: 'globe-lock' },
    { key: 'embeds', icon: 'puzzle' },
    { key: 'mobileApp', icon: 'smartphone' },
    { key: 'automations', icon: 'workflow' },
    { key: 'gamification', icon: 'trophy' },
    { key: 'rankings', icon: 'medal' },
    { key: 'referrals', icon: 'gift' },
    { key: 'courses', icon: 'graduation-cap' },
    { key: 'products', icon: 'package' },
    { key: 'giftCards', icon: 'gift' },
    { key: 'promoCodes', icon: 'ticket-percent' },
  ],
  // Row 2 — scrolls left
  [
    { key: 'events', icon: 'calendar-heart' },
    { key: 'eventForms', icon: 'file-text' },
    { key: 'groups', icon: 'users-round' },
    { key: 'customFields', icon: 'list-plus' },
    { key: 'analytics', icon: 'bar-chart-3' },
    { key: 'finance', icon: 'calculator' },
    { key: 'kiosk', icon: 'monitor' },
    { key: 'whatsapp', icon: 'message-circle', soon: true },
    { key: 'team', icon: 'user-plus' },
    { key: 'forms', icon: 'square-pen' },
    { key: 'places', icon: 'map-pin' },
    { key: 'documents', icon: 'file-check' },
    { key: 'api', icon: 'code' },
  ],
];

// Info-only modal sources — NOT shown in the marquee, but openable by key (e.g.
// the pricing comparison's "Linyup payment fee" row opens 'paymentFee'). They
// reuse the same modal + .ficon, so there's one source of truth for the copy.
const extraCards: { key: string; icon: string }[] = [
  { key: 'paymentFee', icon: 'percent' },
];
---

<section id="more-features">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow"><i data-lucide="layers"></i> {t('features.moreEyebrow')}</span>
      <h2>{t('features.moreTitle')}</h2>
      <p>{t('features.moreSubtitle')}</p>
    </div>
  </div>

  <div class="marquee">
    {
      featureRows.map((row, i) => (
        <div class="marquee-row">
          <div class:list={['marquee-track', i % 2 === 0 ? 'dir-left' : 'dir-right', `row-${i}`]}>
            {/* Render the card set twice for a seamless -50% loop */}
            {[...row, ...row].map(({ key, icon, soon }, j) => (
              <button
                type="button"
                class="fcard"
                data-key={key}
                data-title={t(`features.cards.${key}.title`)}
                data-detail={t(`features.cards.${key}.detail`)}
                data-soon={soon ? 'true' : undefined}
                aria-hidden={j >= row.length ? 'true' : undefined}
                tabindex={j >= row.length ? -1 : undefined}
              >
                <div class="ficon"><i data-lucide={icon} /></div>
                <div class="fcard-text">
                  <h3>{t(`features.cards.${key}.title`)}</h3>
                  <p>{t(`features.cards.${key}.description`)}</p>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Hidden info-only cards (not in the marquee) — source for modals opened by
       key from elsewhere on the page, e.g. the pricing comparison fee row. -->
  <div class="fcard-extras" hidden aria-hidden="true">
    {
      extraCards.map(({ key, icon }) => (
        <button
          type="button"
          class="fcard"
          data-key={key}
          data-title={t(`features.cards.${key}.title`)}
          data-detail={t(`features.cards.${key}.detail`)}
        >
          <div class="ficon"><i data-lucide={icon} /></div>
          <div class="fcard-text"><h3>{t(`features.cards.${key}.title`)}</h3></div>
        </button>
      ))
    }
  </div>

  <!-- Feature detail modal (populated on card click) -->
  <div class="fmodal-overlay" id="feature-modal" hidden>
    <div class="fmodal" role="dialog" aria-modal="true" aria-labelledby="fmodal-title">
      <button class="fmodal-close" type="button" aria-label="Close"><i data-lucide="x"></i></button>
      <div class="ficon fmodal-icon" id="fmodal-icon"></div>
      {/* Screenshot slot for later: add an <img>/<div class="fmodal-shot"> here. */}
      <h3 id="fmodal-title"></h3>
      <span class="fmodal-soon" id="fmodal-soon" hidden>{t('features.comingSoon')}</span>
      <p id="fmodal-detail"></p>
      <button class="btn btn-primary btn-block" type="button" data-early-access>{t('plans.earlyAccessCta')}</button>
    </div>
  </div>
</section>

<script>
  const modal = document.getElementById('feature-modal');
  if (modal) {
    const titleEl = modal.querySelector('#fmodal-title');
    const detailEl = modal.querySelector('#fmodal-detail');
    const iconEl = modal.querySelector('#fmodal-icon');
    const soonEl = modal.querySelector<HTMLElement>('#fmodal-soon');
    const closeBtn = modal.querySelector('.fmodal-close');

    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = '';
    };
    const open = (card: HTMLElement) => {
      if (titleEl) titleEl.textContent = card.dataset.title ?? '';
      if (detailEl) detailEl.textContent = card.dataset.detail ?? '';
      if (soonEl) soonEl.hidden = card.dataset.soon !== 'true';
      // Reuse the card's already-rendered Lucide SVG so we don't re-run createIcons.
      const srcIcon = card.querySelector('.ficon');
      if (iconEl) iconEl.innerHTML = srcIcon ? srcIcon.innerHTML : '';
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    document.querySelectorAll<HTMLElement>('.marquee .fcard').forEach((card) => {
      card.addEventListener('click', () => open(card));
    });

    // Expose an opener so other sections (e.g. the pricing comparison table) can
    // open the same feature-detail modal by feature key. Reuses the marquee
    // card's data + rendered icon, so there is a single source of truth.
    (window as unknown as { openFeatureModal?: (key: string) => void }).openFeatureModal = (
      key: string
    ) => {
      // Look in the marquee first, then the hidden info-only cards.
      const card = document.querySelector<HTMLElement>(`.fcard[data-key="${key}"]`);
      if (card) open(card);
    };

    closeBtn?.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  }
</script>

<style>
  section { padding: 96px 0 104px; overflow: hidden; }

  /* Eyebrow above the shared section heading */
  .sec-head .eyebrow { margin-bottom: 16px; }

  /* ── Marquee ─────────────────────────────────────────────────────────── */
  .marquee {
    display: flex;
    flex-direction: column;
    gap: 18px;
    /* Fade cards in/out at the section edges */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
  }

  /* Clip the wide track horizontally, but let each card's hover-raise (and its
     shadow) paint a few px beyond the row box — plain `overflow:hidden` cut the
     lifted top edge. The horizontal bleed is hidden by the section's overflow
     and the marquee edge mask. */
  .marquee-row { overflow: clip; overflow-clip-margin: 14px; width: 100%; }

  .marquee-track {
    display: flex;
    gap: 18px;
    width: max-content;
    will-change: transform;
  }
  .marquee-track:hover { animation-play-state: paused; }

  .dir-left { animation: marquee-left 60s linear infinite; }
  .dir-right { animation: marquee-right 70s linear infinite; }

  /* Per-row duration + phase offset so rows don't line up into a rigid grid */
  .row-0 { animation-duration: 60s; animation-delay: -4s; }
  .row-1 { animation-duration: 70s; animation-delay: -22s; }
  .row-2 { animation-duration: 65s; animation-delay: -11s; }

  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  /* Hidden info-only card source (modal content for non-marquee rows) */
  .fcard-extras { display: none; }

  /* ── Card ────────────────────────────────────────────────────────────── */
  .fcard {
    flex: 0 0 auto;
    width: 280px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--card);
    border: 0;
    border-radius: var(--radius-xl);
    box-shadow: var(--ring-card), var(--shadow-sm);
    padding: 16px 18px;
    text-align: left;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .fcard:hover { transform: translateY(-3px); box-shadow: var(--ring-card), var(--shadow-md); }
  .fcard:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .ficon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--purple-50);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--purple-100);
  }
  .ficon :global(svg) { width: 24px; height: 24px; }
  .fcard-text { min-width: 0; }
  .fcard h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    margin: 0 0 3px;
    line-height: 1.2;
  }
  .fcard p {
    font-size: 13px;
    line-height: 1.35;
    color: var(--muted-foreground);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Reduced motion: stop animating, allow manual horizontal scroll ───── */
  @media (prefers-reduced-motion: reduce) {
    .marquee-row { overflow-x: auto; }
    .marquee-track { animation: none; transform: none; }
  }

  /* ── Detail modal ────────────────────────────────────────────────────── */
  .fmodal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: oklch(0 0 0 / 0.5);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: fmodal-fade 0.15s ease;
  }
  .fmodal-overlay[hidden] { display: none; }
  .fmodal {
    position: relative;
    width: 100%;
    max-width: 420px;
    background: var(--card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: 32px;
    text-align: center;
    animation: fmodal-pop 0.18s ease;
  }
  .fmodal-icon { width: 56px; height: 56px; margin: 0 auto 18px; }
  .fmodal-icon :global(svg) { width: 28px; height: 28px; }
  .fmodal h3 { font-family: var(--font-display); font-weight: 600; font-size: 24px; margin: 0 0 10px; }
  .fmodal-soon {
    display: inline-block;
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
    background: var(--purple-50);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }
  .fmodal-soon[hidden] { display: none; }
  .fmodal p { font-size: 15px; line-height: 1.6; color: var(--muted-foreground); margin: 0 0 22px; }
  .fmodal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .fmodal-close:hover { background: var(--purple-50); }
  .fmodal-close :global(svg) { width: 18px; height: 18px; }
  @keyframes fmodal-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fmodal-pop { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }

  /* ── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    section { padding: 64px 0 68px; }
    .marquee { gap: 14px; }
    .marquee-track { gap: 14px; }
    .fcard { width: 240px; padding: 14px 16px; }
    .fcard h3 { font-size: 15px; }
  }
</style>
