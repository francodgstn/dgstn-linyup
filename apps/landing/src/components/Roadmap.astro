---
// The public roadmap: the board's "In progress" and "Next" columns and the
// newest few "Done" cards ("Landed recently"), exported
// into src/data/roadmap.json by scripts/roadmap-export.mjs and published only
// through a reviewed PR. Never read the board from here — the board is private
// and the JSON is the only thing that leaves it.
import roadmap from '~/data/roadmap.json';
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';

interface Props {
  lang: Language;
}

type Text = { title: string; body: string };
type Card = { id: string; area: { key: string; label: string } | null; en: Text } & Partial<Record<Language, Text>>;

const { lang } = Astro.props;
const t = useTranslations(lang);

// A card without a translation for this locale shows in English rather than not
// at all — the export's --check keeps that from happening in a published file.
const text = (c: Card): Text => c[lang] ?? c.en;
// t() returns the key itself when it is missing: a board area added since the
// strings were written then shows its English name instead of a key path.
const areaLabel = (a: NonNullable<Card['area']>) => {
  const key = `roadmap.areas.${a.key}`;
  const v = t(key);
  return v === key ? a.label : v;
};

const sections = [
  // What shipped lately, FIRST: a visitor's first question is what they can
  // use today (Franco, 2026-09-25). Capped by the export, newest first in board order.
  { key: 'landed', icon: 'check-circle', cards: (roadmap.sections.landed ?? []) as Card[] },
  { key: 'inProgress', icon: 'hammer', cards: roadmap.sections.inProgress as Card[] },
  { key: 'next', icon: 'compass', cards: roadmap.sections.next as Card[] },
].filter((s) => s.cards.length > 0);

// Everything that landed before the newest few. These cards have usually been
// archived off the board, which is why the export accumulates them rather than
// reading them back — see scripts/roadmap-export.mjs. Folded away because the
// page answers "what can I use today" first, but never dropped: a studio
// looking for a feature it was told about should find it here.
const archived = (roadmap.landedArchive ?? []) as Card[];
const moreLabel = t('roadmap.landedAll').replace('{count}', String(archived.length));
---

<section class="roadmap">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow"><i data-lucide="map"></i> {t('roadmap.eyebrow')}</span>
      <h1>{t('roadmap.title')}</h1>
      <p>{t('roadmap.subtitle')}</p>
    </div>

    {
      sections.map((s) => (
        <div class="rm-section">
          <h2>
            <i data-lucide={s.icon} />
            {t(`roadmap.${s.key}`)}
          </h2>
          <ul class="rm-grid">
            {s.cards.map((c) => (
              <li class="rm-card">
                {c.area && <span class="rm-area">{areaLabel(c.area)}</span>}
                <h3>{text(c).title}</h3>
                <p>{text(c).body}</p>
              </li>
            ))}
          </ul>
          {s.key === 'landed' && archived.length > 0 && (
            <details class="rm-more">
              <summary>
                <i data-lucide="chevron-down" />
                {moreLabel}
              </summary>
              <ul class="rm-grid">
                {archived.map((c) => (
                  <li class="rm-card">
                    {c.area && <span class="rm-area">{areaLabel(c.area)}</span>}
                    <h3>{text(c).title}</h3>
                    <p>{text(c).body}</p>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      ))
    }

    <p class="rm-note">{t('roadmap.disclaimer')}</p>

    <div class="rm-ask">
      <h2>{t('roadmap.askTitle')}</h2>
      <p>{t('roadmap.askBody')}</p>
      <a class="btn btn-primary" href="mailto:hello@linyup.com">{t('roadmap.askCta')}</a>
    </div>
  </div>
</section>

<style>
  .roadmap { padding: 128px 0 96px; }
  .sec-head .eyebrow { margin-bottom: 16px; }
  .sec-head h1 {
    font-family: "Sora", var(--font-sans);
    font-weight: 700;
    font-size: 44px;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .rm-section { margin-top: 56px; }
  .rm-section h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    margin: 0 0 20px;
  }
  .rm-section h2 :global(svg) { width: 20px; height: 20px; color: var(--primary); }

  .rm-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .rm-card {
    background: var(--card);
    border-radius: var(--radius-xl);
    box-shadow: var(--ring-card), var(--shadow-sm);
    padding: 20px 22px;
  }
  .rm-area {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--purple-700);
    background: var(--purple-50);
    border: 1px solid var(--purple-200);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 12px;
  }
  .rm-card h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    margin: 0 0 6px;
  }
  .rm-card p { font-size: 14.5px; line-height: 1.55; color: var(--muted-foreground); margin: 0; }

  /* Native <details>: keyboard and screen-reader correct with no JavaScript,
     which matters on a static page. The marker is replaced by a chevron that
     turns when it opens. */
  .rm-more { margin-top: 18px; }
  .rm-more > summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--muted-foreground);
    list-style: none;
    padding: 6px 2px;
    border-radius: var(--radius-md);
  }
  .rm-more > summary::-webkit-details-marker { display: none; }
  .rm-more > summary::marker { content: ''; }
  .rm-more > summary:hover { color: var(--foreground); }
  .rm-more > summary:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  .rm-more > summary :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.15s ease;
  }
  .rm-more[open] > summary :global(svg) { transform: rotate(180deg); }
  .rm-more[open] > summary { margin-bottom: 18px; }

  .rm-note {
    max-width: 62ch;
    margin: 48px auto 0;
    text-align: center;
    font-size: 14px;
    color: var(--muted-foreground);
  }

  .rm-ask {
    max-width: 560px;
    margin: 56px auto 0;
    text-align: center;
    background: var(--purple-50);
    border: 1px solid var(--purple-100);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
  }
  .rm-ask h2 { font-family: var(--font-display); font-weight: 600; font-size: 22px; margin: 0 0 8px; }
  .rm-ask p { font-size: 15px; color: var(--muted-foreground); margin: 0 0 20px; }

  @media (max-width: 860px) {
    .roadmap { padding: 104px 0 64px; }
    .sec-head h1 { font-size: 32px; }
    .rm-section { margin-top: 40px; }
    .rm-grid { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
