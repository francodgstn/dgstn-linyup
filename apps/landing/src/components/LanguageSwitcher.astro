---
import { languages, defaultLang, stripLocale } from '~/i18n';
import type { Language } from '~/i18n';

interface Props {
  currentLang: Language;
}

const { currentLang } = Astro.props;
const currentPath = stripLocale(Astro.url.pathname);

function hrefForLang(lang: Language): string {
  if (lang === defaultLang) return currentPath || '/';
  const clean = currentPath.replace(/^\//, '').replace(/\/$/, '');
  return clean ? `/${lang}/${clean}` : `/${lang}`;
}

const options = (Object.keys(languages) as Language[]).map((lang) => ({
  lang,
  label: lang.toUpperCase(),
  href: hrefForLang(lang),
  selected: lang === currentLang,
}));
---

<div class="ls-wrap">
  <select aria-label="Language" class="ls-select" data-lang-select>
    {options.map(({ label, href, selected }) => (
      <option value={href} selected={selected}>{label}</option>
    ))}
  </select>
  <span class="ls-chevron" aria-hidden="true">
    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </span>
</div>

<style>
  .ls-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  /* Unboxed, like the nav links: the chevron alone says it opens. The nav and
     the footer both render this, so the handler below binds by attribute. */
  .ls-select {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    height: 34px;
    padding: 0 20px 0 4px;
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: color 0.15s;
    line-height: 1;
  }
  .ls-select:hover { color: var(--foreground); }
  .ls-select:focus { outline: none; }
  .ls-select:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .ls-select option {
    background: var(--card);
    color: var(--foreground);
  }
  .ls-chevron {
    position: absolute;
    right: 2px;
    pointer-events: none;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
  }
</style>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-lang-select]').forEach((el) => el.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    if (!target.value) return;
    // Persist the explicit choice so the root-locale nudge respects it next time
    // (the option label is the uppercase lang code: EN / DE / FR / IT).
    const code = target.selectedOptions[0]?.textContent?.trim().toLowerCase();
    if (code) {
      try {
        localStorage.setItem('linyup:lang', code);
      } catch {
        /* private mode — fall through to navigation */
      }
    }
    window.location.href = target.value;
  }));
</script>
