---
import type { Language } from '~/i18n';
import { useTranslations } from '~/i18n';
import shop from '../assets/product/shop.webp';
import shopDark from '../assets/product/shop-dark.webp';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The headline upgrade for this release — "Accept Payments + Shop" gets its own
// full-width section: two cards (what you can sell + how you get paid) next to the
// /shop screenshot. Copy is pulled from the `payments` namespace.
---

<section id="payments" class="pay-sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow"><i data-lucide="banknote"></i> {t('payments.eyebrow')}</span>
      <h2>{t('payments.title')}</h2>
      <p>{t('payments.subtitle')}</p>
    </div>

    <div class="pay-row">
      <div class="pay-cards">
        <div class="pay-card">
          <span class="pay-ico"><i data-lucide="store"></i></span>
          <h3>{t('payments.cards.sell.title')}</h3>
          <p class="pay-intro" set:html={t('payments.cards.sell.body')} />
        </div>
        <div class="pay-card pay-card-lead">
          <span class="pay-ico"><i data-lucide="credit-card"></i></span>
          <h3>{t('payments.cards.pay.title')}</h3>
          <ul class="pay-models">
            <li>
              <strong>{t('payments.cards.pay.linyupName')}</strong> — {t('payments.cards.pay.linyupBody')}
              <button class="pay-rates" type="button" data-rates-open>
                {t('payments.cards.pay.ratesLink')} <i data-lucide="arrow-right"></i>
              </button>
            </li>
            <li>
              <strong>{t('payments.cards.pay.byoName')}</strong> — {t('payments.cards.pay.byoBody')}
            </li>
          </ul>
        </div>
      </div>

      <figure class="pay-shot">
        {/* Both themes ship; global.css shows one (img.shot-light / img.shot-dark). */}
        <img
          class="shot-light"
          src={shop.src}
          width={shop.width}
          height={shop.height}
          alt={t('payments.title')}
          loading="lazy"
          decoding="async"
        />
        <img
          class="shot-dark"
          src={shopDark.src}
          width={shopDark.width}
          height={shopDark.height}
          alt={t('payments.title')}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="pay-cta">
      <button class="btn btn-primary" type="button" data-early-access>
        {t('payments.cta')} <i data-lucide="arrow-right"></i>
      </button>
    </div>
  </div>

  <dialog class="rates-modal" id="rates-modal">
    <div class="rates-head">
      <h3>{t('payments.feesTitle')}</h3>
      <button class="rates-close" type="button" data-rates-close aria-label="Close">
        <i data-lucide="x"></i>
      </button>
    </div>
    <p class="rates-intro">{t('payments.feesIntro')}</p>
    <table class="rates-table">
      <thead>
        <tr><th>{t('payments.feesPlanHead')}</th><th>{t('payments.feesFeeHead')}</th></tr>
      </thead>
      <tbody>
        <tr><td>Free</td><td>{t('payments.feeFree')}</td></tr>
        <tr><td>Coach</td><td>{t('payments.feeCoach')}</td></tr>
        <tr><td>Studio</td><td>{t('payments.feeStudio')}</td></tr>
        <tr><td>Organization</td><td>{t('payments.feeOrg')}</td></tr>
      </tbody>
    </table>
    <p class="rates-micro">{t('payments.feesMicrocopy')}</p>
  </dialog>
</section>

<script>
  const modal = document.getElementById('rates-modal') as HTMLDialogElement | null;
  document
    .querySelectorAll('[data-rates-open]')
    .forEach((b) => b.addEventListener('click', () => modal?.showModal()));
  document
    .querySelectorAll('[data-rates-close]')
    .forEach((b) => b.addEventListener('click', () => modal?.close()));
  // Close when clicking the backdrop (outside the dialog box).
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>

<style>
  .pay-sec { padding: 104px 0; }
  .sec-head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .sec-head .eyebrow { margin-bottom: 14px; }
  .sec-head h2 { font-family: var(--font-display); font-weight: 600; font-size: 34px; line-height: 1.15; }
  .sec-head p { margin-top: 12px; font-size: 17px; color: var(--muted-foreground); }

  /* Two columns: the single payment card on the left, the /shop screenshot
     framed on the right. */
  .pay-row {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 28px;
    align-items: center;
  }
  .pay-cards { display: flex; flex-direction: column; gap: 16px; }
  /* The shop screenshot shows in full (a clean top-of-shop view) — never cropped —
     framed with a little breathing room and centered against the cards column. */
  .pay-shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    /* Token, not #fff: the frame sits directly around the screenshot, and a
       white mat around the dark shot was the one place the section still read
       as light mode. */
    background: var(--card);
    box-shadow: var(--ring-card), var(--shadow-lg);
    padding: 12px;
  }
  .pay-shot img {
    /* `display` is deliberately absent: global.css owns it for the shot-light /
       shot-dark pair, and an Astro-scoped rule here would outrank it. */
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
  .pay-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--ring-card), var(--shadow-sm);
    padding: 24px;
  }
  .pay-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-lg);
    background: var(--purple-50);
    color: var(--primary);
    margin-bottom: 14px;
  }
  .pay-ico :global(svg) { width: 21px; height: 21px; }
  .pay-card h3 { font-family: var(--font-display); font-weight: 600; font-size: 19px; }
  .pay-card p { margin-top: 7px; font-size: 14.5px; line-height: 1.55; color: var(--muted-foreground); }

  /* Lead card — subtle accent border to mark it as the "how you get paid" anchor */
  .pay-card-lead { border-color: color-mix(in oklch, var(--primary) 35%, var(--border)); }
  .pay-lead { margin-top: 18px; font-size: 14.5px; font-weight: 600; color: var(--foreground); }
  .pay-models { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 14px; }
  .pay-models li { font-size: 14px; line-height: 1.55; color: var(--muted-foreground); }
  .pay-models strong { color: var(--foreground); font-weight: 600; }
  /* Intro line — what you can sell + where. */
  .pay-intro :global(strong) { color: var(--foreground); font-weight: 600; }
  /* Inline "see the rates" — flows on as a continuation of the Pay-via-Linyup line */
  .pay-rates {
    display: inline;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    color: var(--primary);
    white-space: nowrap;
  }
  .pay-rates:hover { text-decoration: underline; text-underline-offset: 2px; }
  .pay-rates :global(svg) { display: inline-block; width: 14px; height: 14px; vertical-align: -2px; transition: transform 0.15s ease; }
  .pay-rates:hover :global(svg) { transform: translateX(2px); }

  .pay-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }
  .pay-cta .btn { min-width: 180px; }

  /* Rates modal */
  .rates-modal {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: 28px;
    max-width: 440px;
    width: calc(100% - 32px);
    color: var(--foreground);
    background: var(--card);
  }
  .rates-modal::backdrop { background: color-mix(in oklch, black 45%, transparent); }
  .rates-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .rates-head h3 { font-family: var(--font-display); font-weight: 600; font-size: 20px; }
  .rates-close {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; flex-shrink: 0;
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: none; cursor: pointer; color: var(--muted-foreground);
  }
  .rates-close:hover { background: var(--purple-50); color: var(--primary); }
  .rates-close :global(svg) { width: 16px; height: 16px; }
  .rates-intro { margin-top: 10px; font-size: 14px; line-height: 1.55; color: var(--muted-foreground); }
  .rates-table { width: 100%; border-collapse: collapse; margin-top: 18px; }
  .rates-table th, .rates-table td { text-align: left; padding: 10px 4px; border-bottom: 1px solid var(--border); font-size: 14.5px; }
  .rates-table th { font-weight: 600; color: var(--muted-foreground); font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em; }
  .rates-table td:last-child { text-align: right; font-weight: 600; }
  .rates-micro { margin-top: 16px; font-size: 12.5px; line-height: 1.55; color: var(--muted-foreground); }

  @media (max-width: 980px) {
    .pay-row { grid-template-columns: 1fr; }
    /* On mobile the cards carry the message; the screenshot is hidden. */
    .pay-shot { display: none; }
  }
  @media (max-width: 860px) {
    .pay-sec { padding: 68px 0; }
    .sec-head h2 { font-size: 28px; }
  }
</style>
