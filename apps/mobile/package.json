{
  "name": "@linyup/mobile",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "shared:build": "pnpm --filter @linyup/shared build",
    "eas-build-post-install": "pnpm --filter @linyup/shared build",
    "start": "pnpm run shared:build && dotenv -e .env.staging -- expo start",
    "start:clear": "pnpm run shared:build && dotenv -e .env.staging -- expo start --clear",
    "start:prod": "pnpm run shared:build && dotenv -e .env.production -- expo start --clear",
    "start:emulators": "pnpm run shared:build && dotenv -v FIREBASE_PROJECT_ID=demo-linyup -v EXPO_PUBLIC_USE_EMULATORS=true -- expo start --clear",
    "start:emulators:web": "pnpm run shared:build && dotenv -v FIREBASE_PROJECT_ID=demo-linyup -v EXPO_PUBLIC_USE_EMULATORS=true -- expo start --web --clear",
    "android": "pnpm run shared:build && expo run:android",
    "ios": "pnpm run shared:build && expo run:ios",
    "web": "pnpm run shared:build && expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@linyup/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "deepmerge": "^4.3.1",
    "expo": "~54.0.35",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.2",
    "expo-dev-client": "~6.0.0",
    "expo-device": "~8.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "firebase": "^12.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gifted-charts": "^1.4.72",
    "react-native-paper": "5.14.5",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
