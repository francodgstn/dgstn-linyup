---
// Home page: the whole site on one screen. Without it `/` is a 404 — every
// document lives at its own slug and nothing claimed the root.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Card, CardGrid, LinkCard, Badge } from '@astrojs/starlight/components'
import { getCollection } from 'astro:content'
import { AREAS, AREA_TITLE, byOrder } from '../../../../scripts/lib/docsMeta.mjs'
import Landscape from '../components/Landscape.astro'
import C4 from '../components/C4.astro'

const docs = await getCollection('docs')
const current = docs.filter((d) => d.data.status === 'living' || d.data.status === 'plan')
const records = docs.length - current.length
const inArea = (area: string) =>
  current
    .filter((d) => d.data.area === area)
    .map((d) => ({ id: d.id, title: d.data.title, order: d.data.order, plan: d.data.status === 'plan' }))
    .sort(byOrder)

const start = inArea('start')
const FIRST = ['overview', 'landscape', 'glossary', 'rules/local-development', 'test-accounts']
type Group = { area: string; title: string; items: ReturnType<typeof inArea> }
const areas: Group[] = AREAS.filter((a) => a !== 'start')
  .map((a) => ({ area: a, title: AREA_TITLE[a] ?? a, items: inArea(a) }))
  .filter((g) => g.items.length > 0)
---

<StarlightPage
  frontmatter={{
    title: 'Linyup engineering',
    description: 'Internal documentation. Local only, never published.',
    status: 'living',
    area: 'start',
  }}
>
  <p>
    How Linyup is built and why. If you are new here, start with the pages below.
    Pages marked <Badge text="plan" variant="caution" /> describe work still to do.
  </p>

  <CardGrid>
    {start.filter((d) => FIRST.includes(d.id)).map((d) => <LinkCard title={d.title} href={`/${d.id}/`} />)}
  </CardGrid>

  <h2 id="landscape">Landscape</h2>
  <p>
    Everything around Linyup on one screen. Select a box to see what it connects to.
    The <a href="/landscape/">Landscape</a> page walks through how a request travels across it.
  </p>
  <Landscape compact />
  <C4 launcher />

  <h2 id="map">Map</h2>
  <CardGrid>
    {
      areas.map((g) => (
        <Card title={g.title}>
          <ul class="map-list">
            {g.items.map((d) => (
              <li>
                <a href={`/${d.id}/`}>{d.title}</a>
                {d.plan && <Badge text="plan" variant="caution" size="small" />}
              </li>
            ))}
          </ul>
        </Card>
      ))
    }
  </CardGrid>

  <p>
    There are {records} audits, reviews and closed plans under <strong>Records</strong> in the
    sidebar. Each was true on its date. Check one against the code before you act on it.
  </p>
</StarlightPage>

<style>
  .map-list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2 11rem;
    column-gap: 1rem;
  }
  .map-list li {
    margin: 0 0 0.25rem;
    break-inside: avoid;
    font-size: var(--sl-text-sm);
  }
  .map-list a {
    text-decoration: none;
  }
  .map-list a:hover {
    text-decoration: underline;
  }
</style>
